---
interface Props { title: string; description?: string; }
const { title, description = '日本各地のライブカメラから、日本の「今」を見る。' } = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="color-scheme" content="light dark" />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="IMARIUM" />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <title>{title}</title>
</head>
<body id="main-content" tabindex="-1"><a class="skip-link" href="#main-content">本文へスキップ</a><slot /></body>
</html>
<style is:global>
  :root { font-family: Inter, "Noto Sans JP", system-ui, sans-serif; color: #171717; background: #f7f7f5; }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; }
  button, a { -webkit-tap-highlight-color: transparent; }
  button { font: inherit; }
  :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  body:focus { outline: none; }
  .skip-link { position: fixed; z-index: 9999; top: .5rem; left: .5rem; transform: translateY(-160%); background: #fff; color: #111; border: 2px solid #111; padding: .7rem 1rem; text-decoration: none; }
  .skip-link:focus { transform: translateY(0); }
  @media (max-width: 700px), (pointer: coarse) {
    header nav a,
    header > a:not(.brand),
    .actions a,
    .actions button,
    .controls button,
    .overlay a,
    .overlay button,
    .dock a,
    .setRow button,
    .dialogHead button,
    .bar button {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    header nav a,
    header > a:not(.brand) { padding-block: 10px; }
    .dialogHead button { min-width: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto !important; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }
</style>
