---
import Layout from '../../layouts/Layout.astro';
import cameras from '../../data/cameras.json';
---
<Layout title="MULTI VIEW | IMARIUM"><main class="shell"><header><a class="brand" href="/">IMARIUM // LIVE GRID</a><nav><a href="/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a class="active" href="/multiview/">MULTI VIEW</a></nav></header>
<section class="toolbar"><div><p>03 // MULTI VIEW</p><h1>LIVE MATRIX</h1><small>MULTIPLE WINDOWS // SYNCHRONIZED VIEW</small></div><div class="right"><div class="matrixStat"><b id="windowCount">0</b> / 9 LIVE WINDOWS</div><div class="controls"><span>LAYOUT</span><button data-layout="1">1</button><button data-layout="2">2</button><button data-layout="4">4</button><button data-layout="6">6</button><button data-layout="9">9</button><button data-layout="auto" class="on">AUTO</button><button id="save">＋ SAVE SET</button><button id="sets">MY SETS</button><button id="full">⛶ FULL</button></div></div></section>
<section id="wall" class="wall auto"></section><section id="empty" class="empty" hidden><span>MULTI VIEW // EMPTY</span><h2>NO LIVE WINDOWS</h2><p>MY WINDOWSから最大9つのライブ映像を選択して、同時表示できます。</p><a href="/favorites/">SELECT FROM MY WINDOWS →</a></section>
<dialog id="setsDialog"><div class="dialogHead"><div><small>MY SETS</small><h2>SAVED MATRIX</h2></div><button id="closeSets" aria-label="閉じる">×</button></div><div id="setsList"></div></dialog><dialog id="saveDialog"><form method="dialog"><div class="dialogHead"><div><small>SAVE CURRENT MATRIX</small><h2>NEW SET</h2></div><button value="cancel" aria-label="閉じる">×</button></div><label for="setName">SET NAME</label><input id="setName" maxlength="40" autocomplete="off" placeholder="例：北海道ライブ"/><div class="dialogActions"><button value="cancel">CANCEL</button><button id="confirmSave" value="default">SAVE SET →</button></div></form></dialog><div id="toast" class="toast" role="status" aria-live="polite"></div>
</main><script define:vars={{ cameras }}>
import { readMultiview, writeWindowIds, MULTIVIEW_KEY, MULTIVIEW_LIMIT } from '../../scripts/window-storage';
const safeArray=(key)=>{try{const v=JSON.parse(localStorage.getItem(key)||'[]');return Array.isArray(v)?v:[]}catch{return[]}};const setsKey='imarium:sets',layoutKey='imarium:multiview-layout';const wall=document.querySelector('#wall'),empty=document.querySelector('#empty'),setsDialog=document.querySelector('#setsDialog'),saveDialog=document.querySelector('#saveDialog'),setsList=document.querySelector('#setsList'),setName=document.querySelector('#setName'),windowCount=document.querySelector('#windowCount'),toast=document.querySelector('#toast');const byId=Object.fromEntries(cameras.map(c=>[c.cameraId,c]));const isLive=c=>c&&c.status==='live'&&c.embedEnabled!==false;let timer;const say=text=>{toast.textContent=text;toast.classList.add('show');clearTimeout(timer);timer=setTimeout(()=>toast.classList.remove('show'),1600)};
function getIds(){return readMultiview().filter(id=>isLive(byId[id])).slice(0,MULTIVIEW_LIMIT)}function render(){wall.innerHTML='';const ids=getIds();writeWindowIds(MULTIVIEW_KEY,ids);windowCount.textContent=ids.length;empty.hidden=!!ids.length;wall.hidden=!ids.length;for(const id of ids){const c=byId[id],w=document.createElement('article');w.className='window';w.dataset.id=id;w.innerHTML=`<iframe src="https://www.youtube-nocookie.com/embed/${c.videoId}?autoplay=1&mute=1&playsinline=1&rel=0" title="${c.name}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe><div class="overlay"><span>● LIVE // ${c.name}</span><div><a href="/live/${id}/">OPEN</a><button class="remove" aria-label="MULTI VIEWから削除">×</button></div></div>`;w.querySelector('.remove').onclick=()=>{writeWindowIds(MULTIVIEW_KEY,getIds().filter(x=>x!==id));render();say('MULTI VIEWから削除しました')};wall.append(w)}}
function applyLayout(value){document.querySelectorAll('[data-layout]').forEach(x=>x.classList.toggle('on',x.dataset.layout===value));wall.className='wall '+(value==='auto'?'auto':'l'+value);localStorage.setItem(layoutKey,value)}document.querySelectorAll('[data-layout]').forEach(b=>b.onclick=()=>applyLayout(b.dataset.layout));applyLayout(localStorage.getItem(layoutKey)||'auto');render();
document.querySelector('#full').onclick=async()=>{try{if(document.fullscreenElement)await document.exitFullscreen();else await document.querySelector('.shell').requestFullscreen?.()}catch{say('FULL SCREENを開始できませんでした')}};
document.querySelector('#save').onclick=()=>{if(!getIds().length)return say('保存するLIVE WINDOWがありません');setName.value='';saveDialog.showModal();setTimeout(()=>setName.focus(),50)};document.querySelector('#confirmSave').onclick=e=>{e.preventDefault();const name=setName.value.trim();if(!name)return setName.focus();const sets=safeArray(setsKey).filter(s=>s&&typeof s==='object'&&Array.isArray(s.cameras));sets.push({id:crypto.randomUUID?.()||String(Date.now()),name,cameras:getIds(),updatedAt:new Date().toISOString()});localStorage.setItem(setsKey,JSON.stringify(sets));saveDialog.close();say(`「${name}」を保存しました`)};
function renderSets(){const sets=safeArray(setsKey).filter(s=>s&&typeof s==='object'&&Array.isArray(s.cameras));setsList.innerHTML='';if(!sets.length){setsList.innerHTML='<div class="noSets"><b>NO SAVED SETS</b><span>現在のLIVE MATRIXを保存するとここに表示されます。</span></div>';return}sets.slice().reverse().forEach(s=>{const validIds=s.cameras.filter(id=>isLive(byId[id])).slice(0,MULTIVIEW_LIMIT),row=document.createElement('div');row.className='setRow';const names=validIds.map(id=>byId[id]?.name).filter(Boolean).join(' / ');row.innerHTML=`<div><strong>${s.name||'UNTITLED'}</strong><small>${validIds.length} LIVE WINDOWS</small><em>${names||'NO ACTIVE WINDOWS'}</em></div><div><button class="openSet" ${validIds.length?'':'disabled'}>OPEN</button><button class="deleteSet">DELETE</button></div>`;row.querySelector('.openSet').onclick=()=>{if(!validIds.length)return;writeWindowIds(MULTIVIEW_KEY,validIds);setsDialog.close();render();say(`「${s.name||'SET'}」を開きました`)};row.querySelector('.deleteSet').onclick=()=>{localStorage.setItem(setsKey,JSON.stringify(sets.filter(x=>x.id!==s.id)));renderSets();say('保存セットを削除しました')};setsList.append(row)})}document.querySelector('#sets').onclick=()=>{renderSets();setsDialog.showModal()};document.querySelector('#closeSets').onclick=()=>setsDialog.close();
</script></Layout>
<style>
.shell{min-height:100vh;padding:0 2vw 2vw}header{height:70px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font-weight:700;letter-spacing:.2em;color:var(--cyan);text-decoration:none;text-shadow:0 0 12px #4ee3ff88}nav{display:flex;gap:1.2rem}nav a{font-size:.62rem;letter-spacing:.12em;color:var(--sub);text-decoration:none}.active{color:var(--cyan)!important}.toolbar{display:flex;justify-content:space-between;align-items:end;gap:2rem;padding:2.2rem 0 1.2rem}.toolbar p,.controls span,.toolbar small{font-size:.56rem;letter-spacing:.18em;color:var(--sub)}.toolbar h1{font-size:clamp(1.8rem,4vw,3.8rem);letter-spacing:.08em;font-weight:500;margin:.25rem 0;text-shadow:0 0 20px #4ee3ff22}.right{text-align:right}.matrixStat{margin-bottom:.65rem;color:var(--sub);font-size:.52rem;letter-spacing:.12em}.matrixStat b{color:var(--cyan);font-size:.9rem}.controls{display:flex;align-items:center;gap:.35rem;flex-wrap:wrap;justify-content:flex-end}.controls button{min-height:36px;padding:.5rem .65rem;font-size:.55rem}.controls .on{background:var(--cyan);color:#05070d;box-shadow:0 0 16px #4ee3ff66}.wall{display:grid;gap:5px;height:calc(100vh - 190px);min-height:420px}.wall[hidden]{display:none}.wall.auto{grid-template-columns:repeat(auto-fit,minmax(30%,1fr));grid-auto-rows:minmax(0,1fr)}.wall.l1{grid-template-columns:1fr}.wall.l2,.wall.l4{grid-template-columns:repeat(2,1fr)}.wall.l6,.wall.l9{grid-template-columns:repeat(3,1fr)}.window{position:relative;background:#020409;overflow:hidden;min-height:0;border:1px solid #4ee3ff25;box-shadow:inset 0 0 18px #4ee3ff08}.window::before{content:"";position:absolute;z-index:2;left:0;top:0;width:30px;height:1px;background:var(--cyan);box-shadow:0 0 8px var(--cyan)}.window iframe{width:100%;height:100%;border:0}.overlay{position:absolute;inset:auto 0 0;display:flex;justify-content:space-between;align-items:center;padding:.6rem;background:linear-gradient(transparent,#020409ee);opacity:0;transition:.2s}.window:hover .overlay{opacity:1}.overlay span{font-size:.58rem;letter-spacing:.08em;color:var(--cyan)}.overlay a,.overlay button{min-height:34px;font-size:.52rem;color:var(--cyan);background:#05070dcc;border:1px solid var(--line);text-decoration:none;padding:.4rem .55rem}.empty{padding:5rem 1rem;border:1px solid var(--line);background-image:linear-gradient(#4ee3ff08 1px,transparent 1px),linear-gradient(90deg,#4ee3ff08 1px,transparent 1px);background-size:28px 28px;text-align:center}.empty span{color:var(--cyan);font-size:.52rem;letter-spacing:.18em}.empty h2{font-size:clamp(2rem,5vw,4rem);font-weight:500;margin:.5rem 0}.empty p{color:var(--sub);font-size:.7rem}.empty a{display:inline-block;margin-top:1rem;border:1px solid var(--cyan);padding:.8rem 1rem;color:var(--cyan);text-decoration:none;font-size:.58rem}dialog{width:min(720px,92vw);max-height:80vh;overflow:auto;border:1px solid var(--cyan);background:#050912;color:var(--text);padding:1.2rem;box-shadow:0 0 40px #4ee3ff33}dialog::backdrop{background:#000c}.dialogHead{display:flex;justify-content:space-between;align-items:start;border-bottom:1px solid var(--line);padding-bottom:1rem}.dialogHead small{letter-spacing:.18em;color:var(--sub)}.dialogHead h2{margin:.25rem 0 0;font-weight:500;letter-spacing:.08em}.dialogHead button{width:40px;height:40px}.setRow{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}.setRow strong,.setRow small,.setRow em{display:block}.setRow small{margin-top:.35rem;color:var(--cyan);font-size:.55rem}.setRow em{margin-top:.25rem;color:var(--sub);font-size:.52rem;font-style:normal}.setRow button{min-height:40px;padding:.5rem;margin-left:.3rem;font-size:.55rem}.setRow button:disabled{opacity:.35}.noSets{padding:2.5rem 0;text-align:center}.noSets b,.noSets span{display:block}.noSets b{color:var(--cyan);letter-spacing:.12em}.noSets span{margin-top:.5rem;color:var(--sub);font-size:.62rem}#saveDialog label{display:block;margin:1.2rem 0 .4rem;color:var(--sub);font-size:.52rem;letter-spacing:.14em}#saveDialog input{width:100%;box-sizing:border-box;border:1px solid var(--line);background:#020409;color:var(--text);padding:.9rem;font:inherit;outline:none}#saveDialog input:focus{border-color:var(--cyan);box-shadow:0 0 12px #4ee3ff22}.dialogActions{display:flex;justify-content:flex-end;gap:.5rem;margin-top:1rem}.dialogActions button{min-height:42px;padding:.6rem 1rem}.toast{position:fixed;z-index:50;left:50%;bottom:24px;transform:translate(-50%,12px);padding:.7rem 1rem;border:1px solid var(--cyan);background:#050912f2;color:var(--cyan);font-size:.58rem;box-shadow:0 0 22px #4ee3ff33;opacity:0;pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}@media(max-width:700px){.shell{padding:0 1rem 1rem}header{height:64px}.brand{font-size:.65rem}nav{gap:.5rem}nav a{font-size:.44rem}nav a:nth-child(3){display:none}.toolbar{display:block;padding-top:1.8rem}.right{text-align:left}.matrixStat{margin-top:1rem}.controls{justify-content:flex-start;margin-top:.6rem}.controls span{width:100%}.controls button{min-height:42px}.wall,.wall.auto,.wall.l1,.wall.l2,.wall.l4,.wall.l6,.wall.l9{height:auto;min-height:0;grid-template-columns:1fr;grid-auto-rows:auto}.window{aspect-ratio:16/9}.overlay{opacity:1}.overlay a,.overlay button{min-height:40px}.empty{padding:4rem .8rem}.setRow{display:block}.setRow>div:last-child{margin-top:.8rem}.setRow button{min-height:44px}dialog{width:calc(100vw - 2rem);box-sizing:border-box;padding:1rem}.dialogActions{display:grid;grid-template-columns:1fr 1fr}.toast{bottom:16px;max-width:90vw;text-align:center}}</style>