---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="MULTI VIEW | IMARIUM"><main class="shell"><header><a class="brand" href="/">IMARIUM // LIVE GRID</a><nav aria-label="メインナビゲーション"><a href="/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a class="active" href="/multiview/">MULTI VIEW</a></nav><details class="mobile-menu"><summary aria-label="メニューを開く"><span></span><span></span><span></span></summary><div><a href="/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a class="active" href="/multiview/">MULTI VIEW</a></div></details></header>
<section class="toolbar"><div><p>03 // MULTI VIEW</p><h1>LIVE MATRIX</h1><small>MULTIPLE WINDOWS // SYNCHRONIZED VIEW</small></div><div class="right"><div class="matrixStat"><b id="windowCount">0</b> / 9 LIVE WINDOWS</div><div class="controls"><span>LAYOUT</span><div class="layoutControls"><button data-layout="1">1</button><button data-layout="2">2</button><button data-layout="4">4</button><button data-layout="6">6</button><button data-layout="9">9</button><button data-layout="auto" class="on">AUTO</button></div><div class="matrixActions"><button id="save">＋ SAVE SET</button><button id="sets">MY SETS</button><button id="full">⛶ FULL</button></div></div></div></section>
<section id="wall" class="wall auto"></section><section id="empty" class="empty" hidden><span>MULTI VIEW // EMPTY</span><h2>NO LIVE WINDOWS</h2><p>MY WINDOWSから最大9つのライブ映像を選択して、同時表示できます。</p><a href="/favorites/">SELECT FROM MY WINDOWS →</a></section>
<dialog id="setsDialog"><div class="dialogHead"><div><small>MY SETS</small><h2>SAVED MATRIX</h2></div><button id="closeSets" aria-label="閉じる">×</button></div><div id="setsList"></div></dialog><dialog id="saveDialog"><form method="dialog"><div class="dialogHead"><div><small>SAVE CURRENT MATRIX</small><h2>NEW SET</h2></div><button value="cancel" aria-label="閉じる">×</button></div><label for="setName">SET NAME</label><input id="setName" maxlength="40" autocomplete="off" placeholder="例：北海道ライブ"/><div class="dialogActions"><button value="cancel">CANCEL</button><button id="confirmSave" value="default">SAVE SET →</button></div></form></dialog><div id="toast" class="toast" role="status" aria-live="polite"></div>
</main><script>
import cameras from '../../data/cameras.json';
import { readMultiview, writeWindowIds, MULTIVIEW_KEY, MULTIVIEW_LIMIT, pruneMultiview, subscribeMultiview } from '../../scripts/window-storage';
type Camera=(typeof cameras)[number];type SavedSet={id:string;name:string;cameras:string[];updatedAt?:string};
const setsKey='imarium:sets',layoutKey='imarium:multiview-layout';const wall=document.querySelector<HTMLElement>('#wall'),empty=document.querySelector<HTMLElement>('#empty'),setsDialog=document.querySelector<HTMLDialogElement>('#setsDialog'),saveDialog=document.querySelector<HTMLDialogElement>('#saveDialog'),setsList=document.querySelector<HTMLElement>('#setsList'),setName=document.querySelector<HTMLInputElement>('#setName'),windowCount=document.querySelector<HTMLElement>('#windowCount'),toast=document.querySelector<HTMLElement>('#toast');const byId:Record<string,Camera>=Object.fromEntries(cameras.map((c):[string,Camera]=>[c.cameraId,c]));const isLive=(c:Camera|undefined):c is Camera=>Boolean(c&&c.status==='live'&&c.embedEnabled===true);const isPublishedId=(id:string)=>isLive(byId[id]);let timer:number|undefined;const say=(text:string)=>{if(!toast)return;toast.textContent=text;toast.classList.add('show');if(timer!==undefined)window.clearTimeout(timer);timer=window.setTimeout(()=>toast.classList.remove('show'),1600)};
const normalizeSet=(s:SavedSet):SavedSet=>({...s,cameras:[...new Set(s.cameras.filter((id):id is string=>typeof id==='string'&&isPublishedId(id)))].slice(0,MULTIVIEW_LIMIT)});const safeSets=():SavedSet[]=>{try{const v=JSON.parse(localStorage.getItem(setsKey)||'[]');if(!Array.isArray(v))return[];const raw=v.filter((s):s is SavedSet=>Boolean(s&&typeof s==='object'&&typeof s.id==='string'&&Array.isArray(s.cameras)));const clean=raw.map(normalizeSet);if(JSON.stringify(raw)!==JSON.stringify(clean))localStorage.setItem(setsKey,JSON.stringify(clean));return clean}catch{return[]}};
function getIds(ids:string[]=readMultiview()){return ids.filter(isPublishedId).slice(0,MULTIVIEW_LIMIT)}function render(sourceIds:string[]=readMultiview()){if(!wall||!empty||!windowCount)return;wall.innerHTML='';const ids=getIds(sourceIds);windowCount.textContent=String(ids.length);empty.hidden=ids.length>0;wall.hidden=ids.length===0;for(const id of ids){const c=byId[id];if(!isLive(c))continue;const w=document.createElement('article');w.className='window';w.dataset.id=id;w.innerHTML=`<div class="videoFrame"><iframe src="https://www.youtube-nocookie.com/embed/${c.videoId}?autoplay=1&mute=1&playsinline=1&rel=0" title="${c.name}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe></div><div class="overlay"><div class="windowIdentity"><span>● LIVE</span><strong>${c.name}</strong><small>${c.cameraId} // ${c.city}</small></div><div class="windowActions"><a href="/live/${id}/">OPEN →</a><button class="remove" aria-label="${c.name}をMULTI VIEWから削除">×</button></div></div>`;const remove=w.querySelector<HTMLButtonElement>('.remove');if(remove)remove.onclick=()=>{writeWindowIds(MULTIVIEW_KEY,getIds().filter(x=>x!==id),MULTIVIEW_LIMIT);say('MULTI VIEWから削除しました')};wall.append(w)}}
function normalize(){const valid=pruneMultiview(isPublishedId);render(valid)}function applyLayout(value:string){document.querySelectorAll<HTMLButtonElement>('[data-layout]').forEach(x=>x.classList.toggle('on',x.dataset.layout===value));if(wall)wall.className='wall '+(value==='auto'?'auto':'l'+value);localStorage.setItem(layoutKey,value)}document.querySelectorAll<HTMLButtonElement>('[data-layout]').forEach(b=>b.onclick=()=>applyLayout(b.dataset.layout||'auto'));applyLayout(localStorage.getItem(layoutKey)||'auto');normalize();subscribeMultiview((ids)=>{const valid=ids.filter(isPublishedId).slice(0,MULTIVIEW_LIMIT);if(valid.length!==ids.length)pruneMultiview(isPublishedId);else render(valid)});
const full=document.querySelector<HTMLButtonElement>('#full');if(full)full.onclick=async()=>{try{if(document.fullscreenElement)await document.exitFullscreen();else await document.querySelector<HTMLElement>('.shell')?.requestFullscreen?.()}catch{say('FULL SCREENを開始できませんでした')}};const save=document.querySelector<HTMLButtonElement>('#save');if(save)save.onclick=()=>{if(!getIds().length)return say('保存するLIVE WINDOWがありません');if(setName)setName.value='';saveDialog?.showModal();window.setTimeout(()=>setName?.focus(),50)};const confirmSave=document.querySelector<HTMLButtonElement>('#confirmSave');if(confirmSave)confirmSave.onclick=e=>{e.preventDefault();const name=setName?.value.trim()||'';if(!name){setName?.focus();return}const sets=safeSets();sets.push({id:crypto.randomUUID?.()||String(Date.now()),name,cameras:getIds(),updatedAt:new Date().toISOString()});localStorage.setItem(setsKey,JSON.stringify(sets));saveDialog?.close();say(`「${name}」を保存しました`)};
function renderSets(){if(!setsList)return;const sets=safeSets();setsList.innerHTML='';if(!sets.length){setsList.innerHTML='<div class="noSets"><b>NO SAVED SETS</b><span>現在のLIVE MATRIXを保存するとここに表示されます。</span></div>';return}sets.slice().reverse().forEach(s=>{const validIds=s.cameras,row=document.createElement('div');row.className='setRow';row.dataset.setId=s.id;const names=validIds.map(id=>byId[id]?.name).filter(Boolean).join(' / ');row.innerHTML=`<div><strong>${s.name||'UNTITLED'}</strong><small>${validIds.length} LIVE WINDOWS</small><em>${names||'NO ACTIVE WINDOWS'}</em></div><div><button class="openSet" ${validIds.length?'':'disabled'}>OPEN</button><button class="deleteSet">DELETE</button></div>`;const open=row.querySelector<HTMLButtonElement>('.openSet');if(open)open.onclick=()=>{if(!validIds.length)return;writeWindowIds(MULTIVIEW_KEY,validIds,MULTIVIEW_LIMIT);setsDialog?.close();say(`「${s.name||'SET'}」を開きました`)};const del=row.querySelector<HTMLButtonElement>('.deleteSet');if(del)del.onclick=()=>{localStorage.setItem(setsKey,JSON.stringify(sets.filter(x=>x.id!==s.id)));renderSets();say('保存セットを削除しました')};setsList.append(row)})}safeSets();const setsButton=document.querySelector<HTMLButtonElement>('#sets');if(setsButton)setsButton.onclick=()=>{renderSets();setsDialog?.showModal()};const closeSets=document.querySelector<HTMLButtonElement>('#closeSets');if(closeSets)closeSets.onclick=()=>setsDialog?.close();
</script></Layout>
<style>
.shell{min-height:100vh;padding:0 2vw 2vw}header{height:70px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);position:relative}.brand{font-weight:700;letter-spacing:.2em;color:var(--cyan);text-decoration:none;text-shadow:0 0 12px #4ee3ff88}nav{display:flex;gap:1.2rem}nav a{font-size:.62rem;letter-spacing:.12em;color:var(--sub);text-decoration:none}.active{color:var(--cyan)!important}.mobile-menu{display:none}.toolbar{display:flex;justify-content:space-between;align-items:end;gap:2rem;padding:2.2rem 0 1.2rem}.toolbar p,.controls>span,.toolbar small{font-size:.56rem;letter-spacing:.18em;color:var(--sub)}.toolbar h1{font-size:clamp(1.8rem,4vw,3.8rem);letter-spacing:.08em;font-weight:500;margin:.25rem 0;text-shadow:0 0 20px #4ee3ff22}.right{text-align:right}.matrixStat{margin-bottom:.65rem;color:var(--sub);font-size:.52rem;letter-spacing:.12em}.matrixStat b{color:var(--cyan);font-size:.9rem}.controls{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;justify-content:flex-end}.layoutControls,.matrixActions{display:flex;gap:.35rem}.controls button{min-height:36px;padding:.5rem .65rem;font-size:.55rem}.controls .on{background:var(--cyan);color:#05070d;box-shadow:0 0 16px #4ee3ff66}.wall{display:grid;gap:5px;height:calc(100vh - 190px);min-height:420px}.wall[hidden]{display:none}.wall.auto{grid-template-columns:repeat(auto-fit,minmax(30%,1fr));grid-auto-rows:minmax(0,1fr)}.wall.l1{grid-template-columns:1fr}.wall.l2,.wall.l4{grid-template-columns:repeat(2,1fr)}.wall.l6,.wall.l9{grid-template-columns:repeat(3,1fr)}.window{position:relative;background:#020409;overflow:hidden;min-height:0;border:1px solid #4ee3ff25;box-shadow:inset 0 0 18px #4ee3ff08}.window::before{content:"";position:absolute;z-index:3;left:0;top:0;width:30px;height:1px;background:var(--cyan);box-shadow:0 0 8px var(--cyan)}.videoFrame{position:absolute;inset:0}.videoFrame iframe{width:100%;height:100%;border:0}.overlay{position:absolute;z-index:2;inset:auto 0 0;display:flex;justify-content:space-between;align-items:end;gap:1rem;padding:.75rem;background:linear-gradient(transparent,#020409f2);opacity:0;transition:.2s;pointer-events:none}.window:hover .overlay,.window:focus-within .overlay{opacity:1}.windowIdentity{min-width:0}.windowIdentity span,.windowIdentity strong,.windowIdentity small{display:block}.windowIdentity span{font-size:.5rem;letter-spacing:.12em;color:var(--cyan)}.windowIdentity strong{margin-top:.18rem;font-size:.7rem;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.windowIdentity small{margin-top:.12rem;color:var(--sub);font-size:.45rem;letter-spacing:.08em}.windowActions{display:flex;gap:4px;pointer-events:auto}.windowActions a,.windowActions button{min-height:34px;font-size:.52rem;color:var(--cyan);background:#05070de8;border:1px solid var(--line);text-decoration:none;padding:.4rem .55rem}.empty{padding:5rem 1rem;border:1px solid var(--line);background-image:linear-gradient(#4ee3ff08 1px,transparent 1px),linear-gradient(90deg,#4ee3ff08 1px,transparent 1px);background-size:28px 28px;text-align:center}.empty span{color:var(--cyan);font-size:.52rem;letter-spacing:.18em}.empty h2{font-size:clamp(2rem,5vw,4rem);font-weight:500;margin:.5rem 0}.empty p{color:var(--sub);font-size:.7rem}.empty a{display:inline-block;margin-top:1rem;border:1px solid var(--cyan);padding:.8rem 1rem;color:var(--cyan);text-decoration:none;font-size:.58rem}dialog{width:min(720px,92vw);max-height:80vh;overflow:auto;border:1px solid var(--cyan);background:#050912;color:var(--text);padding:1.2rem;box-shadow:0 0 40px #4ee3ff33}dialog::backdrop{background:#000c}.dialogHead{display:flex;justify-content:space-between;align-items:start;border-bottom:1px solid var(--line);padding-bottom:1rem}.dialogHead small{letter-spacing:.18em;color:var(--sub)}.dialogHead h2{margin:.25rem 0 0;font-weight:500;letter-spacing:.08em}.dialogHead button{width:40px;height:40px}.setRow{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}.setRow strong,.setRow small,.setRow em{display:block}.setRow small{margin-top:.35rem;color:var(--cyan);font-size:.55rem}.setRow em{margin-top:.25rem;color:var(--sub);font-size:.52rem;font-style:normal}.setRow button{min-height:40px;padding:.5rem;margin-left:.3rem;font-size:.55rem}.setRow button:disabled{opacity:.35}.noSets{padding:2.5rem 0;text-align:center}.noSets b,.noSets span{display:block}.noSets b{color:var(--cyan);letter-spacing:.12em}.noSets span{margin-top:.5rem;color:var(--sub);font-size:.62rem}#saveDialog label{display:block;margin:1.2rem 0 .4rem;color:var(--sub);font-size:.52rem;letter-spacing:.14em}#saveDialog input{width:100%;box-sizing:border-box;border:1px solid var(--line);background:#020409;color:var(--text);padding:.9rem;font:inherit;outline:none}#saveDialog input:focus{border-color:var(--cyan);box-shadow:0 0 12px #4ee3ff22}.dialogActions{display:flex;justify-content:flex-end;gap:.5rem;margin-top:1rem}.dialogActions button{min-height:42px;padding:.6rem 1rem}.toast{position:fixed;z-index:50;left:50%;bottom:24px;transform:translate(-50%,12px);padding:.7rem 1rem;border:1px solid var(--cyan);background:#050912f2;color:var(--cyan);font-size:.58rem;box-shadow:0 0 22px #4ee3ff33;opacity:0;pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}@media(max-width:700px){.shell{padding:0 1rem calc(1rem + env(safe-area-inset-bottom))}header{height:64px}.brand{font-size:.62rem;letter-spacing:.12em;white-space:nowrap}header nav{display:none}.mobile-menu{display:block;position:relative}.mobile-menu summary{list-style:none;width:44px;height:44px;border:1px solid var(--line);display:grid;place-content:center;gap:4px;cursor:pointer;background:#050912cc}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu summary span{display:block;width:16px;height:1px;background:var(--cyan);box-shadow:0 0 5px #4ee3ff55}.mobile-menu[open] summary{border-color:var(--cyan);box-shadow:0 0 12px #4ee3ff22}.mobile-menu div{position:absolute;z-index:40;right:0;top:50px;width:190px;border:1px solid var(--cyan);background:#050912f7;box-shadow:0 0 25px #4ee3ff22;padding:.35rem}.mobile-menu div a{display:block;padding:.85rem .75rem;color:var(--sub);text-decoration:none;font-size:.55rem;letter-spacing:.1em;border-bottom:1px solid var(--line)}.mobile-menu div a:last-child{border-bottom:0}.mobile-menu div .active{color:var(--cyan);background:#4ee3ff0d}.toolbar{padding:1.4rem 0 .8rem;display:block}.toolbar h1{font-size:2rem}.right{text-align:left;margin-top:.8rem}.matrixStat{margin-bottom:.5rem}.controls{justify-content:flex-start;display:block}.controls>span{display:block;margin-bottom:.35rem}.layoutControls{display:grid;grid-template-columns:repeat(6,1fr);gap:3px}.layoutControls button{min-width:0;padding:.45rem .2rem}.matrixActions{display:grid;grid-template-columns:1fr 1fr 1fr;margin-top:.45rem;gap:3px}.matrixActions button{min-height:44px;padding:.45rem .2rem}.wall{height:auto;min-height:0;display:grid!important;grid-template-columns:1fr!important;grid-auto-rows:auto!important;gap:8px}.wall[hidden]{display:none!important}.window{aspect-ratio:16/9;min-height:0}.overlay{opacity:1;padding:.6rem;background:linear-gradient(transparent 10%,#020409e8);align-items:end}.windowIdentity strong{font-size:.62rem;max-width:58vw}.windowIdentity small{display:none}.windowActions a,.windowActions button{min-height:44px;display:grid;place-items:center;padding:.45rem .65rem}.empty{padding:3rem .7rem}.empty h2{font-size:2rem}dialog{padding:1rem;width:calc(100% - 1rem);max-height:85vh}.setRow{display:block}.setRow>div:last-child{display:grid;grid-template-columns:1fr 1fr;margin-top:.8rem;gap:.4rem}.setRow button{margin:0;min-height:46px}.toast{bottom:calc(16px + env(safe-area-inset-bottom));max-width:90vw;text-align:center}}</style>