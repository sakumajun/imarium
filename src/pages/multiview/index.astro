---
import Layout from '../../layouts/Layout.astro';
import cameras from '../../data/cameras.json';
---
<Layout title="MULTI VIEW | IMARIUM"><main class="shell"><header><a class="brand" href="/">IMARIUM</a><nav><a href="/explore/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a class="active" href="/multiview/">MULTI VIEW</a></nav></header>
<section class="toolbar"><div><p>MULTI VIEW</p><h1>いくつもの「今」を、ひとつの画面に。</h1></div><div class="controls"><span>LAYOUT</span><button data-layout="1">1</button><button data-layout="2">2</button><button data-layout="4">4</button><button data-layout="6">6</button><button data-layout="9">9</button><button data-layout="auto" class="on">AUTO</button><button id="save">＋ SAVE SET</button><button id="sets">MY SETS</button><button id="full">⛶ FULL SCREEN</button></div></section>
<section id="wall" class="wall auto"></section><section id="empty" class="empty" hidden><p>MULTI VIEWに表示できるLIVE WINDOWがありません。</p><a href="/favorites/">MY WINDOWSから選択 →</a></section>
<dialog id="setsDialog"><div class="dialogHead"><div><small>MY SETS</small><h2>保存した窓</h2></div><button id="closeSets">×</button></div><div id="setsList"></div></dialog>
</main><script define:vars={{ cameras }}>
const safeArray=(key)=>{try{const v=JSON.parse(localStorage.getItem(key)||'[]');return Array.isArray(v)?v:[]}catch{return[]}};const wall=document.querySelector('#wall'),empty=document.querySelector('#empty'),setsDialog=document.querySelector('#setsDialog'),setsList=document.querySelector('#setsList');const byId=Object.fromEntries(cameras.map(c=>[c.cameraId,c]));const isLive=c=>c&&c.status==='live'&&c.embedEnabled!==false;
function getIds(){return safeArray('imarium:multiview').filter(id=>isLive(byId[id])).slice(0,9)}
function render(){wall.innerHTML='';const ids=getIds();localStorage.setItem('imarium:multiview',JSON.stringify(ids));const list=ids.map(id=>byId[id]);empty.hidden=!!list.length;for(const c of list){const w=document.createElement('article');w.className='window';w.dataset.id=c.cameraId;w.innerHTML=`<iframe src="https://www.youtube.com/embed/${c.videoId}?autoplay=1&mute=1&playsinline=1" title="${c.name}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe><div class="overlay"><span>${c.name}</span><div><a href="/live/${c.cameraId}/">OPEN</a><button class="remove">×</button></div></div>`;w.querySelector('.remove').onclick=()=>{localStorage.setItem('imarium:multiview',JSON.stringify(getIds().filter(id=>id!==c.cameraId)));render()};wall.append(w)}}render();
document.querySelectorAll('[data-layout]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-layout]').forEach(x=>x.classList.remove('on'));b.classList.add('on');wall.className='wall '+(b.dataset.layout==='auto'?'auto':'l'+b.dataset.layout)});document.querySelector('#full').onclick=()=>document.querySelector('.shell').requestFullscreen?.();
document.querySelector('#save').onclick=()=>{const ids=getIds();if(!ids.length)return alert('保存するLIVE WINDOWがありません。');const name=prompt('セット名を入力してください','いつもの日本');if(!name?.trim())return;const sets=safeArray('imarium:sets').filter(s=>s&&typeof s==='object'&&Array.isArray(s.cameras));sets.push({id:crypto.randomUUID?.()||String(Date.now()),name:name.trim(),cameras:ids,updatedAt:new Date().toISOString()});localStorage.setItem('imarium:sets',JSON.stringify(sets));alert(`「${name.trim()}」を保存しました。`)};
function renderSets(){const sets=safeArray('imarium:sets').filter(s=>s&&typeof s==='object'&&Array.isArray(s.cameras));setsList.innerHTML='';if(!sets.length){setsList.innerHTML='<p class="noSets">まだ保存したセットがありません。</p>';return}sets.forEach(s=>{const validIds=s.cameras.filter(id=>isLive(byId[id])).slice(0,9);const row=document.createElement('div');row.className='setRow';const names=validIds.map(id=>byId[id]?.name).filter(Boolean).join(' / ');row.innerHTML=`<div><strong>${s.name||'UNTITLED'}</strong><small>${validIds.length} LIVE WINDOWS${names?' · '+names:''}</small></div><div><button class="openSet" ${validIds.length?'':'disabled'}>OPEN</button><button class="deleteSet">DELETE</button></div>`;row.querySelector('.openSet').onclick=()=>{if(!validIds.length)return;localStorage.setItem('imarium:multiview',JSON.stringify(validIds));setsDialog.close();render()};row.querySelector('.deleteSet').onclick=()=>{const next=sets.filter(x=>x.id!==s.id);localStorage.setItem('imarium:sets',JSON.stringify(next));renderSets()};setsList.append(row)})}
document.querySelector('#sets').onclick=()=>{renderSets();setsDialog.showModal()};document.querySelector('#closeSets').onclick=()=>setsDialog.close();
</script></Layout>
<style>.shell{min-height:100vh;background:#090909;color:#eee;padding:0 2vw 2vw}header{height:70px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #242424}.brand{font-weight:700;letter-spacing:.18em;color:#fff;text-decoration:none}nav{display:flex;gap:1.2rem}nav a{font-size:.62rem;letter-spacing:.08em;color:#777;text-decoration:none}.active{color:#fff!important}.toolbar{display:flex;justify-content:space-between;align-items:end;gap:2rem;padding:2.5rem 0 1.4rem}.toolbar p,.controls span{font-size:.58rem;letter-spacing:.18em;color:#666}.toolbar h1{font-size:clamp(1.4rem,3vw,2.8rem);font-weight:400;margin:.3rem 0}.controls{display:flex;align-items:center;gap:.35rem;flex-wrap:wrap;justify-content:flex-end}.controls button{border:1px solid #333;background:#111;color:#888;padding:.55rem .7rem;font-size:.6rem}.controls .on{background:#eee;color:#111}.wall{display:grid;gap:3px;height:calc(100vh - 210px);min-height:420px}.wall.auto{grid-template-columns:repeat(auto-fit,minmax(30%,1fr));grid-auto-rows:minmax(0,1fr)}.wall.l1{grid-template-columns:1fr}.wall.l2,.wall.l4{grid-template-columns:repeat(2,1fr)}.wall.l6,.wall.l9{grid-template-columns:repeat(3,1fr)}.window{position:relative;background:#151515;overflow:hidden;min-height:0}.window iframe{width:100%;height:100%;border:0}.overlay{position:absolute;inset:auto 0 0;display:flex;justify-content:space-between;align-items:center;padding:.6rem;background:linear-gradient(transparent,#000c);opacity:0;transition:.2s}.window:hover .overlay{opacity:1}.overlay span{font-size:.7rem}.overlay a,.overlay button{font-size:.55rem;color:#fff;background:#111b;border:1px solid #555;text-decoration:none;padding:.4rem .55rem}.empty{padding:4rem 0;color:#777}.empty a{color:#eee}dialog{width:min(720px,92vw);border:1px solid #444;background:#111;color:#eee;padding:1.2rem}dialog::backdrop{background:#000b}.dialogHead{display:flex;justify-content:space-between;align-items:start;border-bottom:1px solid #333;padding-bottom:1rem}.dialogHead small{letter-spacing:.18em;color:#777}.dialogHead h2{margin:.25rem 0 0;font-weight:400}.dialogHead button{border:1px solid #444;background:#111;color:#fff;width:32px;height:32px}.setRow{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid #292929}.setRow strong,.setRow small{display:block}.setRow small{margin-top:.35rem;color:#777;font-size:.65rem}.setRow button{border:1px solid #444;background:#151515;color:#ddd;padding:.55rem;margin-left:.3rem;font-size:.58rem}.setRow button:disabled{opacity:.4}.noSets{color:#777;padding:2rem 0}@media(max-width:700px){.shell{padding:0 1rem 1rem}header{height:64px}nav{gap:.6rem}nav a{font-size:.5rem}.toolbar{display:block;padding-top:2rem}.controls{justify-content:flex-start;margin-top:1rem}.wall,.wall.auto,.wall.l6,.wall.l9{height:auto;grid-template-columns:repeat(2,1fr);grid-auto-rows:auto}.window{aspect-ratio:16/9}.overlay{opacity:1}.controls button[data-layout="6"],.controls button[data-layout="9"]{opacity:.45}.setRow{display:block}.setRow>div:last-child{margin-top:.8rem}}</style>