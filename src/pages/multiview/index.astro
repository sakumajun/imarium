---
import Layout from '../../layouts/Layout.astro';
import cameras from '../../data/cameras.json';
---
<Layout title="MULTI VIEW | IMARIUM"><main class="shell"><header><a class="brand" href="/">IMARIUM // LIVE GRID</a><nav><a href="/explore/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a class="active" href="/multiview/">MULTI VIEW</a></nav></header>
<section class="toolbar"><div><p>03 // MULTI VIEW</p><h1>LIVE MATRIX</h1><small>MULTIPLE WINDOWS // SYNCHRONIZED VIEW</small></div><div class="controls"><span>LAYOUT</span><button data-layout="1">1</button><button data-layout="2">2</button><button data-layout="4">4</button><button data-layout="6">6</button><button data-layout="9">9</button><button data-layout="auto" class="on">AUTO</button><button id="save">＋ SAVE SET</button><button id="sets">MY SETS</button><button id="full">⛶ FULL</button></div></section>
<section id="wall" class="wall auto"></section><section id="empty" class="empty" hidden><p>NO LIVE WINDOWS IN MATRIX</p><a href="/favorites/">SELECT FROM MY WINDOWS →</a></section>
<dialog id="setsDialog"><div class="dialogHead"><div><small>MY SETS</small><h2>SAVED MATRIX</h2></div><button id="closeSets">×</button></div><div id="setsList"></div></dialog>
</main><script define:vars={{ cameras }}>
const safeArray=(key)=>{try{const v=JSON.parse(localStorage.getItem(key)||'[]');return Array.isArray(v)?v:[]}catch{return[]}};const wall=document.querySelector('#wall'),empty=document.querySelector('#empty'),setsDialog=document.querySelector('#setsDialog'),setsList=document.querySelector('#setsList');const byId=Object.fromEntries(cameras.map(c=>[c.cameraId,c]));const isLive=c=>c&&c.status==='live'&&c.embedEnabled!==false;
function getIds(){return safeArray('imarium:multiview').filter(id=>isLive(byId[id])).slice(0,9)}
function render(){wall.innerHTML='';const ids=getIds();localStorage.setItem('imarium:multiview',JSON.stringify(ids));const list=ids.map(id=>byId[id]);empty.hidden=!!list.length;for(const c of list){const w=document.createElement('article');w.className='window';w.dataset.id=c.cameraId;w.innerHTML=`<iframe src="https://www.youtube-nocookie.com/embed/${c.videoId}?autoplay=1&mute=1&playsinline=1&rel=0" title="${c.name}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe><div class="overlay"><span>● LIVE // ${c.name}</span><div><a href="/live/${c.cameraId}/">OPEN</a><button class="remove">×</button></div></div>`;w.querySelector('.remove').onclick=()=>{localStorage.setItem('imarium:multiview',JSON.stringify(getIds().filter(id=>id!==c.cameraId)));render()};wall.append(w)}}render();
document.querySelectorAll('[data-layout]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-layout]').forEach(x=>x.classList.remove('on'));b.classList.add('on');wall.className='wall '+(b.dataset.layout==='auto'?'auto':'l'+b.dataset.layout)});document.querySelector('#full').onclick=()=>document.querySelector('.shell').requestFullscreen?.();
document.querySelector('#save').onclick=()=>{const ids=getIds();if(!ids.length)return alert('保存するLIVE WINDOWがありません。');const name=prompt('セット名を入力してください','いつもの日本');if(!name?.trim())return;const sets=safeArray('imarium:sets').filter(s=>s&&typeof s==='object'&&Array.isArray(s.cameras));sets.push({id:crypto.randomUUID?.()||String(Date.now()),name:name.trim(),cameras:ids,updatedAt:new Date().toISOString()});localStorage.setItem('imarium:sets',JSON.stringify(sets));alert(`「${name.trim()}」を保存しました。`)};
function renderSets(){const sets=safeArray('imarium:sets').filter(s=>s&&typeof s==='object'&&Array.isArray(s.cameras));setsList.innerHTML='';if(!sets.length){setsList.innerHTML='<p class="noSets">NO SAVED SETS</p>';return}sets.forEach(s=>{const validIds=s.cameras.filter(id=>isLive(byId[id])).slice(0,9);const row=document.createElement('div');row.className='setRow';const names=validIds.map(id=>byId[id]?.name).filter(Boolean).join(' / ');row.innerHTML=`<div><strong>${s.name||'UNTITLED'}</strong><small>${validIds.length} LIVE WINDOWS${names?' · '+names:''}</small></div><div><button class="openSet" ${validIds.length?'':'disabled'}>OPEN</button><button class="deleteSet">DELETE</button></div>`;row.querySelector('.openSet').onclick=()=>{if(!validIds.length)return;localStorage.setItem('imarium:multiview',JSON.stringify(validIds));setsDialog.close();render()};row.querySelector('.deleteSet').onclick=()=>{const next=sets.filter(x=>x.id!==s.id);localStorage.setItem('imarium:sets',JSON.stringify(next));renderSets()};setsList.append(row)})}
document.querySelector('#sets').onclick=()=>{renderSets();setsDialog.showModal()};document.querySelector('#closeSets').onclick=()=>setsDialog.close();
</script></Layout>
<style>
.shell{min-height:100vh;padding:0 2vw 2vw}header{height:70px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font-weight:700;letter-spacing:.2em;color:var(--cyan);text-decoration:none;text-shadow:0 0 12px #4ee3ff88}nav{display:flex;gap:1.2rem}nav a{font-size:.62rem;letter-spacing:.12em;color:var(--sub);text-decoration:none}.active{color:var(--cyan)!important}.toolbar{display:flex;justify-content:space-between;align-items:end;gap:2rem;padding:2.2rem 0 1.2rem}.toolbar p,.controls span,.toolbar small{font-size:.56rem;letter-spacing:.18em;color:var(--sub)}.toolbar h1{font-size:clamp(1.8rem,4vw,3.8rem);letter-spacing:.08em;font-weight:500;margin:.25rem 0;text-shadow:0 0 20px #4ee3ff22}.controls{display:flex;align-items:center;gap:.35rem;flex-wrap:wrap;justify-content:flex-end}.controls button{padding:.5rem .65rem;font-size:.55rem}.controls .on{background:var(--cyan);color:#05070d;box-shadow:0 0 16px #4ee3ff66}.wall{display:grid;gap:5px;height:calc(100vh - 190px);min-height:420px}.wall.auto{grid-template-columns:repeat(auto-fit,minmax(30%,1fr));grid-auto-rows:minmax(0,1fr)}.wall.l1{grid-template-columns:1fr}.wall.l2,.wall.l4{grid-template-columns:repeat(2,1fr)}.wall.l6,.wall.l9{grid-template-columns:repeat(3,1fr)}.window{position:relative;background:#020409;overflow:hidden;min-height:0;border:1px solid #4ee3ff25;box-shadow:inset 0 0 18px #4ee3ff08}.window::before{content:"";position:absolute;z-index:2;left:0;top:0;width:30px;height:1px;background:var(--cyan);box-shadow:0 0 8px var(--cyan)}.window iframe{width:100%;height:100%;border:0}.overlay{position:absolute;inset:auto 0 0;display:flex;justify-content:space-between;align-items:center;padding:.6rem;background:linear-gradient(transparent,#020409ee);opacity:0;transition:.2s}.window:hover .overlay{opacity:1}.overlay span{font-size:.58rem;letter-spacing:.08em;color:var(--cyan)}.overlay a,.overlay button{font-size:.52rem;color:var(--cyan);background:#05070dcc;border:1px solid var(--line);text-decoration:none;padding:.4rem .55rem}.empty{padding:4rem 0;color:var(--sub);letter-spacing:.12em}.empty a{color:var(--cyan)}dialog{width:min(720px,92vw);border:1px solid var(--cyan);background:#050912;color:var(--text);padding:1.2rem;box-shadow:0 0 40px #4ee3ff33}dialog::backdrop{background:#000c}.dialogHead{display:flex;justify-content:space-between;align-items:start;border-bottom:1px solid var(--line);padding-bottom:1rem}.dialogHead small{letter-spacing:.18em;color:var(--sub)}.dialogHead h2{margin:.25rem 0 0;font-weight:500;letter-spacing:.08em}.dialogHead button{width:36px;height:36px}.setRow{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}.setRow strong,.setRow small{display:block}.setRow small{margin-top:.35rem;color:var(--sub);font-size:.62rem}.setRow button{padding:.5rem;margin-left:.3rem;font-size:.55rem}.setRow button:disabled{opacity:.35}.noSets{color:var(--sub);padding:2rem 0;letter-spacing:.12em}@media(max-width:700px){.shell{padding:0 1rem 1rem}header{height:64px}.brand{font-size:.7rem}nav{gap:.6rem}nav a{font-size:.48rem}.toolbar{display:block;padding-top:1.8rem}.controls{justify-content:flex-start;margin-top:1rem}.wall,.wall.auto,.wall.l6,.wall.l9{height:auto;grid-template-columns:repeat(2,1fr);grid-auto-rows:auto}.window{aspect-ratio:16/9}.overlay{opacity:1}.setRow{display:block}.setRow>div:last-child{margin-top:.8rem}}
</style>