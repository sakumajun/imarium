---
import Layout from '../../layouts/Layout.astro';import cameras from '../../data/cameras.json';export function getStaticPaths(){return cameras.filter(camera=>camera.status==='live'&&camera.embedEnabled===true).map(camera=>({params:{cameraId:camera.cameraId},props:{camera}}));}const{camera}=Astro.props;const isLive=true;const embedUrl=`https://www.youtube-nocookie.com/embed/${camera.videoId}?autoplay=1&mute=1&playsinline=1&rel=0`;const youtubeUrl=`https://www.youtube.com/watch?v=${camera.videoId}`;const checked=camera.lastCheckedAt?new Date(camera.lastCheckedAt).toLocaleString('ja-JP',{timeZone:'Asia/Tokyo'}):'---';const cityRoutes:Record<string,string>={'札幌市':'sapporo','函館市':'hakodate','小樽市':'otaru','旭川市':'asahikawa','千歳市':'chitose','稚内市':'wakkanai','富良野市':'furano','ニセコ町':'niseko','倶知安町':'niseko','帯広市':'obihiro','釧路市':'kushiro'};const citySlug=cityRoutes[camera.city];const cityBack=citySlug?`/explore/hokkaido/${citySlug}/`:'/explore/hokkaido/';
---
<Layout title={`${camera.name} | IMARIUM`} description={`${camera.name}の現在をライブカメラで見る。`}><main class="shell"><header><a href={cityBack}>← CITY</a><a class="brand" href="/">IMARIUM // LIVE GRID</a><nav aria-label="メインナビゲーション"><a href="/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></nav><details class="mobile-menu"><summary aria-label="メニューを開く"><span></span><span></span><span></span></summary><div><a href="/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></div></details></header><section class="title"><div><p>LIVE WINDOW // {camera.prefecture.toUpperCase()} / {camera.city} / {camera.area}</p><h1>{camera.name}</h1><div class="state"><span class="badge on">● LIVE</span><span>WINDOW ID // {camera.cameraId}</span></div></div><div class="quick"><button id="favorite" data-camera-id={camera.cameraId} aria-label="お気に入り">♡</button><button id="multi" data-camera-id={camera.cameraId} data-live="true">＋ MULTI</button></div></section><section class="player"><iframe src={embedUrl} title={`${camera.name} YouTube Live`} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="eager"></iframe></section><section class="below"><div class="details"><div><span>LOCATION</span><strong>{camera.prefecture} / {camera.city} / {camera.area}</strong></div><div><span>STREAM BY</span><strong>{camera.channelName}</strong></div><div><span>LAST CHECKED</span><strong>{checked}</strong></div><div><span>WINDOW HEALTH</span><strong>LIVE / EMBED OK</strong></div></div><aside><p>YOUTUBE EMBED STREAM</p><a href={youtubeUrl} target="_blank" rel="noopener noreferrer">OPEN SOURCE ↗</a></aside></section><section class="dock"><a href={cityBack}>← CITY WINDOWS</a><a href="/favorites/">♡ MY WINDOWS</a><a href="/multiview/">▦ MULTI VIEW</a></section><div id="toast" class="toast" role="status" aria-live="polite"></div></main><script>
import { readFavorites, readMultiview, toggleFavorite, toggleMultiview, subscribeFavorites, subscribeMultiview } from '../../scripts/window-storage';
const fav=document.querySelector('#favorite'),multi=document.querySelector('#multi'),toast=document.querySelector('#toast');const id=fav instanceof HTMLButtonElement?fav.dataset.cameraId:'';let timer: number | undefined;const say=(text:string)=>{if(!(toast instanceof HTMLElement))return;toast.textContent=text;toast.classList.add('show');if(timer!==undefined)window.clearTimeout(timer);timer=window.setTimeout(()=>toast.classList.remove('show'),1500)};const paintFavorites=(ids=readFavorites())=>{if(!(fav instanceof HTMLButtonElement)||!id)return;const on=ids.includes(id);fav.textContent=on?'♥':'♡';fav.classList.toggle('selected',on);fav.setAttribute('aria-label',on?'お気に入りから削除':'お気に入りに追加')};const paintMultiview=(ids=readMultiview())=>{if(!(multi instanceof HTMLButtonElement)||!id)return;const on=ids.includes(id);multi.textContent=on?'✓ MULTI':'＋ MULTI';multi.classList.toggle('selected',on)};paintFavorites();paintMultiview();subscribeFavorites(paintFavorites);subscribeMultiview(paintMultiview);fav?.addEventListener('click',()=>{if(!id)return;const result=toggleFavorite(id);say(result.selected?'MY WINDOWSに保存しました':'MY WINDOWSから削除しました')});multi?.addEventListener('click',()=>{if(!(multi instanceof HTMLButtonElement)||!id)return;const wasSelected=readMultiview().includes(id);const result=toggleMultiview(id);if(result.full){say('MULTI VIEWは最大9 WINDOWです');return}say(wasSelected?'MULTI VIEWから外しました':'MULTI VIEWに追加しました')});
</script></Layout>
<style>.shell{min-height:100vh;padding:0 4vw 3rem}header{height:70px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid var(--line);position:relative}header>a{color:var(--sub);text-decoration:none;font-size:.6rem;letter-spacing:.12em}.brand{color:var(--cyan)!important;font-weight:700;letter-spacing:.2em;text-shadow:0 0 12px #4ee3ff88}nav{display:flex;justify-content:flex-end;gap:1.1rem}nav a{color:var(--sub);text-decoration:none;font-size:.55rem;letter-spacing:.1em}nav a:hover,nav a:focus-visible,header>a:first-child:hover,header>a:first-child:focus-visible{color:var(--cyan)}.mobile-menu{display:none}.title{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding:4vh 0 1.2rem}.title p{font-size:.52rem;letter-spacing:.16em;color:var(--sub)}.title h1{font-size:clamp(1.8rem,4.5vw,4.2rem);font-weight:500;letter-spacing:.02em;margin:.25rem 0;text-shadow:0 0 20px #4ee3ff22}.state{display:flex;gap:1rem;align-items:center;color:var(--sub);font-size:.5rem;letter-spacing:.12em}.badge{border:1px solid var(--line);padding:.32rem .5rem}.badge.on{color:var(--cyan);border-color:var(--cyan);box-shadow:0 0 10px #4ee3ff22}.quick{display:flex;gap:.5rem}.quick button{min-width:52px;height:52px;padding:0 .9rem;font-size:.58rem}.quick button.selected{border-color:var(--cyan);background:#4ee3ff12;box-shadow:0 0 12px #4ee3ff33}.quick #favorite{border-radius:50%;font-size:1.25rem;min-width:52px;padding:0}.player{max-width:1500px;margin:auto;aspect-ratio:16/9;background:#020409;border:1px solid var(--line);position:relative;box-shadow:0 0 25px #4ee3ff12}.player::before,.player::after{content:"";position:absolute;z-index:2;width:34px;height:1px;background:var(--cyan);box-shadow:0 0 8px var(--cyan)}.player::before{left:-1px;top:-1px}.player::after{right:-1px;bottom:-1px}.player iframe{width:100%;height:100%;border:0}.below{max-width:1500px;margin:1rem auto 0;display:grid;grid-template-columns:1fr auto;gap:2rem;border-top:1px solid var(--line)}.details{display:grid;grid-template-columns:repeat(4,1fr)}.details div{padding:1rem 1rem 1rem 0}.details span{display:block;color:var(--sub);font-size:.46rem;letter-spacing:.14em}.details strong{font-size:.62rem;font-weight:400;color:var(--text)}.below aside{padding:1rem 0;text-align:right}.below aside p{font-size:.48rem;color:var(--sub);letter-spacing:.12em}.below aside a{color:var(--cyan);font-size:.55rem;letter-spacing:.08em}.dock{max-width:1500px;margin:1.6rem auto 0;display:flex;gap:.5rem}.dock a{border:1px solid var(--line);color:var(--cyan);text-decoration:none;padding:.75rem 1rem;font-size:.55rem;letter-spacing:.1em}.dock a:hover{border-color:var(--cyan);background:#4ee3ff12;box-shadow:0 0 12px #4ee3ff22}.toast{position:fixed;z-index:30;left:50%;bottom:24px;transform:translate(-50%,12px);padding:.7rem 1rem;border:1px solid var(--cyan);background:#050912f2;color:var(--cyan);font-size:.58rem;letter-spacing:.08em;box-shadow:0 0 22px #4ee3ff33;opacity:0;pointer-events:none;transition:.2s;white-space:nowrap}.toast.show{opacity:1;transform:translate(-50%,0)}@media(max-width:700px){.shell{padding:0 1rem 2rem}header{height:64px;grid-template-columns:1fr auto 1fr;gap:.5rem}header>a:first-child{font-size:.48rem;width:max-content}.brand{font-size:.58rem;letter-spacing:.12em;white-space:nowrap}header nav{display:none}.mobile-menu{display:block;justify-self:end;position:relative}.mobile-menu summary{list-style:none;width:44px;height:44px;border:1px solid var(--line);display:grid;place-content:center;gap:4px;cursor:pointer;background:#050912cc}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu summary span{display:block;width:16px;height:1px;background:var(--cyan);box-shadow:0 0 5px #4ee3ff55}.mobile-menu[open] summary{border-color:var(--cyan);box-shadow:0 0 12px #4ee3ff22}.mobile-menu div{position:absolute;z-index:20;right:0;top:50px;width:190px;border:1px solid var(--cyan);background:#050912f7;box-shadow:0 0 25px #4ee3ff22;padding:.35rem}.mobile-menu div a{display:block;padding:.85rem .75rem;color:var(--sub);text-decoration:none;font-size:.55rem;letter-spacing:.1em;border-bottom:1px solid var(--line)}.mobile-menu div a:last-child{border-bottom:0}.mobile-menu div a:active{color:var(--cyan);background:#4ee3ff0d}.title{padding-top:2rem;display:block}.title h1{font-size:clamp(1.7rem,8vw,2.5rem)}.quick{margin-top:1rem}.quick button{height:48px}.player{margin-left:-1rem;margin-right:-1rem;border-left:0;border-right:0}.below{grid-template-columns:1fr;gap:.3rem}.details{grid-template-columns:1fr 1fr}.details div{padding:.8rem .6rem .8rem 0}.below aside{text-align:left;padding-top:0}.dock{display:grid;grid-template-columns:1fr 1fr}.dock a{text-align:center;min-height:44px;display:grid;place-items:center}.dock a:first-child{grid-column:1/-1}.toast{bottom:16px;max-width:90vw;white-space:normal;text-align:center}}</style>