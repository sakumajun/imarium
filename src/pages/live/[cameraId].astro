---
import Layout from '../../layouts/Layout.astro';import cameras from '../../data/cameras.json';export function getStaticPaths(){return cameras.map(camera=>({params:{cameraId:camera.cameraId},props:{camera}}));}const{camera}=Astro.props;const isLive=camera.status==='live'&&camera.embedEnabled!==false;const embedUrl=`https://www.youtube-nocookie.com/embed/${camera.videoId}?autoplay=1&mute=1&playsinline=1&rel=0`;const youtubeUrl=`https://www.youtube.com/watch?v=${camera.videoId}`;const checked=camera.lastCheckedAt?new Date(camera.lastCheckedAt).toLocaleString('ja-JP',{timeZone:'Asia/Tokyo'}):'---';const cityRoutes:Record<string,string>={'札幌市':'sapporo','函館市':'hakodate','小樽市':'otaru','旭川市':'asahikawa','千歳市':'chitose','稚内市':'wakkanai','富良野市':'furano','ニセコ町':'niseko','倶知安町':'niseko','帯広市':'obihiro','釧路市':'kushiro'};const citySlug=cityRoutes[camera.city];const cityBack=citySlug?`/explore/hokkaido/${citySlug}/`:'/explore/hokkaido/';
---
<Layout title={`${camera.name} | IMARIUM`} description={`${camera.name}の現在をライブカメラで見る。`}><main class="shell"><header><a href={cityBack}>← EXPLORE</a><a class="brand" href="/">IMARIUM // LIVE GRID</a><a href="/favorites/">MY WINDOWS</a></header><section class="title"><div><p>LIVE WINDOW // {camera.prefecture.toUpperCase()} / {camera.city} / {camera.area}</p><h1>{camera.name}</h1><div class="state"><span class:list={['badge',{on:isLive}]}>{isLive?'● LIVE':'○ CHECK'}</span><span>WINDOW ID // {camera.cameraId}</span></div></div><div class="quick"><button id="favorite" data-camera-id={camera.cameraId} aria-label="お気に入り">♡</button><button id="multi" data-camera-id={camera.cameraId} data-live={String(isLive)} disabled={!isLive}>{isLive?'＋ MULTI':'CHECK'}</button></div></section><section class:list={['player',{offline:!isLive}]}>{isLive?<iframe src={embedUrl} title={`${camera.name} YouTube Live`} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="eager"></iframe>:<div class="unavailable"><span>WINDOW HEALTH</span><h2>SIGNAL CHECK</h2><p>配信URLの変更や配信停止を検出しています。</p></div>}</section><section class="below"><div class="details"><div><span>LOCATION</span><strong>{camera.prefecture} / {camera.city} / {camera.area}</strong></div><div><span>STREAM BY</span><strong>{camera.channelName}</strong></div><div><span>LAST CHECKED</span><strong>{checked}</strong></div><div><span>WINDOW HEALTH</span><strong>{isLive?'LIVE / EMBED OK':camera.healthReason??camera.status}</strong></div></div><aside><p>YOUTUBE EMBED STREAM</p><a href={youtubeUrl} target="_blank" rel="noopener noreferrer">OPEN SOURCE ↗</a></aside></section><section class="dock"><a href="/favorites/">♡ MY WINDOWS</a><a href="/multiview/">▦ MULTI VIEW</a></section></main><script>
// @ts-nocheck
const fav=document.querySelector('#favorite'),multi=document.querySelector('#multi');const id=fav?.dataset.cameraId;const favKey='imarium:favorites',multiKey='imarium:multiview';const read=k=>{try{const v=JSON.parse(localStorage.getItem(k)||'[]');return Array.isArray(v)?v:[]}catch{return[]}};const paint=()=>{if(fav&&id)fav.textContent=read(favKey).includes(id)?'♥':'♡';if(multi&&id&&multi.dataset.live==='true')multi.textContent=read(multiKey).includes(id)?'✓ MULTI':'＋ MULTI'};paint();fav?.addEventListener('click',()=>{const a=read(favKey);localStorage.setItem(favKey,JSON.stringify(a.includes(id)?a.filter(x=>x!==id):[...a,id]));paint()});multi?.addEventListener('click',()=>{if(multi.dataset.live!=='true'||!id)return;const a=read(multiKey);if(a.includes(id)){localStorage.setItem(multiKey,JSON.stringify(a.filter(x=>x!==id)))}else if(a.length<9){localStorage.setItem(multiKey,JSON.stringify([...a,id]))}else{alert('MULTI VIEWは最大9 WINDOWです。')}paint()});
</script></Layout>
<style>.shell{min-height:100vh;padding:0 4vw 3rem}header{height:70px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid var(--line)}header a{color:var(--sub);text-decoration:none;font-size:.6rem;letter-spacing:.12em}header a:last-child{text-align:right}.brand{color:var(--cyan)!important;font-weight:700;letter-spacing:.2em;text-shadow:0 0 12px #4ee3ff88}.title{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding:4vh 0 1.2rem}.title p{font-size:.52rem;letter-spacing:.16em;color:var(--sub)}.title h1{font-size:clamp(1.8rem,4.5vw,4.2rem);font-weight:500;letter-spacing:.02em;margin:.25rem 0;text-shadow:0 0 20px #4ee3ff22}.state{display:flex;gap:1rem;align-items:center;color:var(--sub);font-size:.5rem;letter-spacing:.12em}.badge{border:1px solid var(--line);padding:.32rem .5rem}.badge.on{color:var(--cyan);border-color:var(--cyan);box-shadow:0 0 10px #4ee3ff22}.quick{display:flex;gap:.5rem}.quick button{min-width:52px;height:52px;padding:0 .9rem;font-size:.58rem}.quick button:disabled{opacity:.35}.quick #favorite{border-radius:50%;font-size:1.25rem;min-width:52px;padding:0}.player{max-width:1500px;margin:auto;aspect-ratio:16/9;background:#020409;border:1px solid var(--line);position:relative;box-shadow:0 0 25px #4ee3ff12}.player::before,.player::after{content:"";position:absolute;z-index:2;width:34px;height:1px;background:var(--cyan);box-shadow:0 0 8px var(--cyan)}.player::before{left:-1px;top:-1px}.player::after{right:-1px;bottom:-1px}.player iframe{width:100%;height:100%;border:0}.player.offline{display:grid;place-items:center;background:radial-gradient(circle,#0b1a22,#05070d)}.unavailable{text-align:center;max-width:560px;padding:2rem}.unavailable span{font-size:.52rem;letter-spacing:.18em;color:var(--sub)}.unavailable h2{font-weight:500;letter-spacing:.12em;color:var(--cyan)}.unavailable p{color:var(--sub);font-size:.72rem}.below{max-width:1500px;margin:1rem auto 0;display:grid;grid-template-columns:1fr auto;gap:2rem;border-top:1px solid var(--line)}.details{display:grid;grid-template-columns:repeat(4,1fr)}.details div{padding:1rem 1rem 1rem 0}.details span{display:block;color:var(--sub);font-size:.46rem;letter-spacing:.14em}.details strong{font-size:.62rem;font-weight:400;color:var(--text)}.below aside{padding:1rem 0;text-align:right}.below aside p{font-size:.48rem;color:var(--sub);letter-spacing:.12em}.below aside a{color:var(--cyan);font-size:.55rem;letter-spacing:.08em}.dock{max-width:1500px;margin:1.6rem auto 0;display:flex;gap:.5rem}.dock a{border:1px solid var(--line);color:var(--cyan);text-decoration:none;padding:.75rem 1rem;font-size:.55rem;letter-spacing:.1em}.dock a:hover{border-color:var(--cyan);background:#4ee3ff12;box-shadow:0 0 12px #4ee3ff22}@media(max-width:700px){.shell{padding:0 1rem 2rem}header{height:64px}.brand{font-size:.62rem}.title{padding-top:2.5rem;display:block}.quick{margin-top:1rem}.player{margin-left:-1rem;margin-right:-1rem;border-left:0;border-right:0}.below{grid-template-columns:1fr}.details{grid-template-columns:1fr 1fr}.below aside{text-align:left;padding-top:0}.dock a{flex:1;text-align:center}}</style>