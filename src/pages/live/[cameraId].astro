---
import Layout from '../../layouts/Layout.astro';
import cameras from '../../data/cameras.json';

export function getStaticPaths() {
  return cameras.map((camera) => ({ params: { cameraId: camera.cameraId }, props: { camera } }));
}

const { camera } = Astro.props;
const embedUrl = `https://www.youtube-nocookie.com/embed/${camera.videoId}?autoplay=1&mute=1&rel=0`;
---
<Layout title={`${camera.name} | IMARIUM`} description={`${camera.name}の現在をライブカメラで見る。`}>
  <main class="live-shell">
    <header><a href="/explore/hokkaido/sapporo/">← SAPPORO</a><a class="brand" href="/">IMARIUM</a><a href="/favorites/">MY WINDOWS</a></header>
    <section class="title-row"><div><p>{camera.region.toUpperCase()} / {camera.city}</p><h1>{camera.name}</h1><span class="live">● LIVE</span></div><button id="favorite" data-camera-id={camera.cameraId} aria-label="お気に入りに追加">♡</button></section>
    <section class="player"><iframe src={embedUrl} title={`${camera.name} YouTube Live`} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="eager"></iframe></section>
    <section class="details"><div><span>WINDOW</span><strong>{camera.cameraId}</strong></div><div><span>AREA</span><strong>{camera.prefecture} / {camera.city} / {camera.area}</strong></div><div><span>STREAM</span><strong>{camera.channelName}</strong></div></section>
  </main>
  <script>
    const button = document.querySelector('#favorite');
    const id = button?.dataset.cameraId;
    const key = 'imarium:favorites';
    const read = () => { try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch { return []; } };
    const paint = () => { if (button && id) button.textContent = read().includes(id) ? '♥' : '♡'; };
    paint();
    button?.addEventListener('click', () => {
      if (!id) return;
      const current = read();
      const next = current.includes(id) ? current.filter((x) => x !== id) : [...current, id];
      localStorage.setItem(key, JSON.stringify(next)); paint();
    });
  </script>
</Layout>
<style>
  .live-shell{min-height:100vh;background:#090909;color:#eee;padding:0 4vw 3rem}header{height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid #242424}header a{color:#888;text-decoration:none;font-size:.68rem;letter-spacing:.12em}header a:last-child{text-align:right}.brand{color:#fff!important;font-weight:700;letter-spacing:.18em}.title-row{display:flex;align-items:end;justify-content:space-between;padding:5vh 0 1.5rem}.title-row p{font-size:.62rem;letter-spacing:.16em;color:#666}.title-row h1{font-size:clamp(2rem,5vw,4.8rem);font-weight:400;letter-spacing:-.05em;margin:.3rem 0}.live{font-size:.65rem;color:#aaa;letter-spacing:.1em}.title-row button{border:1px solid #333;background:#111;color:#eee;width:52px;height:52px;border-radius:50%;font-size:1.4rem}.player{max-width:1500px;margin:auto;aspect-ratio:16/9;background:#000;border:1px solid #222}.player iframe{width:100%;height:100%;border:0}.details{max-width:1500px;margin:1.2rem auto 0;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #242424}.details div{padding:1rem 0}.details span{display:block;color:#555;font-size:.55rem;letter-spacing:.14em}.details strong{font-size:.72rem;font-weight:400;color:#aaa}@media(max-width:700px){.live-shell{padding:0 1rem 2rem}header{height:64px}.title-row{padding-top:3rem}.details{grid-template-columns:1fr}.details div{border-bottom:1px solid #1d1d1d}}
</style>
