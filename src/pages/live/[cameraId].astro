---
import Layout from '../../layouts/Layout.astro';import cameras from '../../data/cameras.json';export function getStaticPaths(){return cameras.map(camera=>({params:{cameraId:camera.cameraId},props:{camera}}));}const{camera}=Astro.props;const isLive=camera.status==='live'&&camera.embedEnabled!==false;const embedUrl=`https://www.youtube-nocookie.com/embed/${camera.videoId}?autoplay=1&mute=1&playsinline=1&rel=0`;const youtubeUrl=`https://www.youtube.com/watch?v=${camera.videoId}`;const checked=camera.lastCheckedAt?new Date(camera.lastCheckedAt).toLocaleString('ja-JP',{timeZone:'Asia/Tokyo'}):'---';const cityBack=camera.city==='函館市'?'/explore/hokkaido/hakodate/':'/explore/hokkaido/sapporo/';
---
<Layout title={`${camera.name} | IMARIUM`} description={`${camera.name}の現在をライブカメラで見る。`}><main class="live-shell"><header><a href={cityBack}>← EXPLORE</a><a class="brand" href="/">IMARIUM</a><a href="/favorites/">MY WINDOWS</a></header><section class="title-row"><div><p>{camera.prefecture.toUpperCase()} / {camera.city} / {camera.area}</p><h1>{camera.name}</h1><div class="state"><span class:list={['badge',{on:isLive}]}>{isLive?'● LIVE':'○ CHECK'}</span><span>WINDOW {camera.cameraId}</span></div></div><div class="quick"><button id="favorite" data-camera-id={camera.cameraId} aria-label="お気に入り">♡</button><button id="multi" data-camera-id={camera.cameraId}>＋ MULTI</button></div></section><section class:list={['player',{offline:!isLive}]}>{isLive?<iframe src={embedUrl} title={`${camera.name} YouTube Live`} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="eager"></iframe>:<div class="unavailable"><span>WINDOW HEALTH</span><h2>現在、この窓は確認中です。</h2><p>配信URLの変更や配信停止を検出しています。確認・自動復旧後に再び表示されます。</p></div>}</section><section class="below"><div class="details"><div><span>LOCATION</span><strong>{camera.prefecture} / {camera.city} / {camera.area}</strong></div><div><span>STREAM BY</span><strong>{camera.channelName}</strong></div><div><span>LAST CHECKED</span><strong>{checked}</strong></div><div><span>WINDOW HEALTH</span><strong>{isLive?'LIVE / EMBED OK':camera.healthReason??camera.status}</strong></div></div><aside><p>この映像はYouTube上の配信を埋め込み表示しています。</p><a href={youtubeUrl} target="_blank" rel="noopener noreferrer">YOUTUBEで見る ↗</a></aside></section><section class="dock"><a href="/favorites/">♡ MY WINDOWS</a><a href="/multiview/">▦ MULTI VIEW</a></section></main><script>
// @ts-nocheck
const fav=document.querySelector('#favorite'),multi=document.querySelector('#multi');const id=fav?.dataset.cameraId;const favKey='imarium:favorites',multiKey='imarium:multiview';const read=k=>{try{return JSON.parse(localStorage.getItem(k)||'[]')}catch{return[]}};const paint=()=>{if(fav&&id)fav.textContent=read(favKey).includes(id)?'♥':'♡';if(multi&&id)multi.textContent=read(multiKey).includes(id)?'✓ MULTI':'＋ MULTI'};paint();fav?.addEventListener('click',()=>{const a=read(favKey);localStorage.setItem(favKey,JSON.stringify(a.includes(id)?a.filter(x=>x!==id):[...a,id]));paint()});multi?.addEventListener('click',()=>{const a=read(multiKey);if(a.includes(id)){localStorage.setItem(multiKey,JSON.stringify(a.filter(x=>x!==id)))}else if(a.length<9){localStorage.setItem(multiKey,JSON.stringify([...a,id]))}else{alert('MULTI VIEWは最大9 WINDOWです。')}paint()});
</script></Layout>
<style>.live-shell{min-height:100vh;background:#090909;color:#eee;padding:0 4vw 3rem}header{height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid #242424}header a{color:#888;text-decoration:none;font-size:.68rem;letter-spacing:.12em}header a:last-child{text-align:right}.brand{color:#fff!important;font-weight:700;letter-spacing:.18em}.title-row{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding:5vh 0 1.5rem}.title-row p{font-size:.58rem;letter-spacing:.16em;color:#666}.title-row h1{font-size:clamp(2rem,5vw,4.8rem);font-weight:400;letter-spacing:-.05em;margin:.3rem 0}.state{display:flex;gap:1rem;align-items:center;color:#555;font-size:.55rem;letter-spacing:.12em}.badge{border:1px solid #333;padding:.35rem .5rem;color:#777}.badge.on{color:#eee;border-color:#666}.quick{display:flex;gap:.5rem}.quick button{border:1px solid #333;background:#111;color:#eee;min-width:52px;height:52px;padding:0 .9rem;font-size:.62rem}.quick #favorite{border-radius:50%;font-size:1.35rem;min-width:52px;padding:0}.player{max-width:1500px;margin:auto;aspect-ratio:16/9;background:#000;border:1px solid #222}.player iframe{width:100%;height:100%;border:0}.player.offline{display:grid;place-items:center;background:radial-gradient(circle,#191919,#0b0b0b)}.unavailable{text-align:center;max-width:560px;padding:2rem}.unavailable span{font-size:.55rem;letter-spacing:.18em;color:#666}.unavailable h2{font-weight:400;font-size:clamp(1.4rem,3vw,2.5rem)}.unavailable p{color:#666;line-height:1.8;font-size:.75rem}.below{max-width:1500px;margin:1.2rem auto 0;display:grid;grid-template-columns:1fr auto;gap:2rem;border-top:1px solid #242424}.details{display:grid;grid-template-columns:repeat(4,1fr)}.details div{padding:1rem 1rem 1rem 0}.details span{display:block;color:#555;font-size:.5rem;letter-spacing:.14em}.details strong{font-size:.66rem;font-weight:400;color:#aaa}.below aside{padding:1rem 0;text-align:right}.below aside p{font-size:.55rem;color:#555}.below aside a{color:#aaa;font-size:.6rem;letter-spacing:.08em}.dock{max-width:1500px;margin:2rem auto 0;display:flex;gap:.5rem}.dock a{border:1px solid #292929;color:#888;text-decoration:none;padding:.8rem 1rem;font-size:.6rem;letter-spacing:.08em}.dock a:hover{color:#fff;border-color:#555}@media(max-width:700px){.live-shell{padding:0 1rem 2rem}header{height:64px}.title-row{padding-top:3rem;display:block}.quick{margin-top:1rem}.player{margin-left:-1rem;margin-right:-1rem;border-left:0;border-right:0}.below{grid-template-columns:1fr}.details{grid-template-columns:1fr 1fr}.below aside{text-align:left;padding-top:0}.dock a{flex:1;text-align:center}}</style>