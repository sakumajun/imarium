---
import Layout from '../../layouts/Layout.astro';
import cameras from '../../data/cameras.json';
---
<Layout title="MY WINDOWS | IMARIUM">
<main class="shell"><header><a class="brand" href="/">IMARIUM // LIVE GRID</a><nav><a href="/explore/">EXPLORE</a><a class="active" href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></nav></header>
<section class="heading"><p>02 // MY WINDOWS</p><h1>SAVED WINDOWS</h1><span>保存したライブウィンドウへアクセスします。</span></section>
<section id="grid" class="grid"></section><section id="empty" class="empty" hidden><p>NO SAVED WINDOWS</p><a href="/explore/">EXPLORE WINDOWS →</a></section>
<div class="bar" id="bar" hidden><span><b id="count">0</b> WINDOWS SELECTED</span><button id="multi">OPEN MULTI VIEW →</button></div></main>
<script define:vars={{ cameras }}>
const safeArray=(key)=>{try{const v=JSON.parse(localStorage.getItem(key)||'[]');return Array.isArray(v)?v:[]}catch{return[]}};
const favs=safeArray('imarium:favorites'); const grid=document.querySelector('#grid'); const empty=document.querySelector('#empty'); const bar=document.querySelector('#bar'); const count=document.querySelector('#count'); const selected=new Set();
const byId=Object.fromEntries(cameras.map(c=>[c.cameraId,c])); const list=favs.map(id=>byId[id]).filter(Boolean); if(!list.length) empty.hidden=false;
for(const c of list){const live=c.status==='live'&&c.embedEnabled!==false;const card=document.createElement('article'); card.className='card'; const media=live?`<iframe src="https://www.youtube-nocookie.com/embed/${c.videoId}?mute=1&playsinline=1&rel=0" title="${c.name}" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`:`<div class="unavailable">WINDOW HEALTH<br><small>${c.healthReason||'現在確認中です'}</small></div>`;card.innerHTML=`<div class="screen"><span>${live?'● LIVE':'○ CHECK'}</span>${media}</div><div class="meta"><div><strong>${c.name}</strong><small>${c.city} / ${c.prefecture}</small></div><div class="actions"><button class="select" ${live?'':'disabled'}>${live?'SELECT':'CHECK'}</button><a href="/live/${c.cameraId}/">OPEN →</a><button class="remove" aria-label="お気に入りから削除">♡</button></div></div>`; const sel=card.querySelector('.select'); if(live)sel.onclick=()=>{selected.has(c.cameraId)?selected.delete(c.cameraId):selected.add(c.cameraId); card.classList.toggle('selected'); sel.textContent=selected.has(c.cameraId)?'SELECTED':'SELECT'; count.textContent=selected.size; bar.hidden=!selected.size}; card.querySelector('.remove').onclick=()=>{const next=favs.filter(id=>id!==c.cameraId);localStorage.setItem('imarium:favorites',JSON.stringify(next));location.reload()}; grid.append(card)}
document.querySelector('#multi').onclick=()=>{localStorage.setItem('imarium:multiview',JSON.stringify([...selected].slice(0,9)));location.href='/multiview/'};
</script>
</Layout>
<style>
.shell{min-height:100vh;padding:0 4vw 8rem}header{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font-weight:700;letter-spacing:.2em;color:var(--cyan);text-decoration:none;text-shadow:0 0 12px #4ee3ff88}nav{display:flex;gap:1.4rem}nav a{font-size:.65rem;letter-spacing:.12em;color:var(--sub);text-decoration:none}.active{color:var(--cyan)!important}.heading{padding:6vh 0 3rem}.heading>p{font-size:.62rem;letter-spacing:.2em;color:var(--sub)}.heading h1{font-size:clamp(2.4rem,6vw,5.4rem);font-weight:500;letter-spacing:.04em;margin:.4rem 0;text-shadow:0 0 20px #4ee3ff22}.heading span{color:var(--sub);font-size:.78rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:12px}.card{position:relative;border:1px solid var(--line);background:#050912cc;padding:7px;transition:.2s;box-shadow:0 0 15px #4ee3ff0c}.card::before{content:"";position:absolute;left:-1px;top:-1px;width:28px;height:1px;background:var(--cyan);box-shadow:0 0 8px var(--cyan)}.card:hover,.card.selected{border-color:var(--cyan);box-shadow:0 0 22px #4ee3ff33}.card.selected{outline:1px solid var(--cyan);outline-offset:3px}.screen{aspect-ratio:16/9;background:#020409;position:relative;overflow:hidden}.screen iframe{width:100%;height:100%;border:0}.screen>span{position:absolute;z-index:1;left:.6rem;top:.55rem;font-size:.5rem;letter-spacing:.12em;color:var(--cyan);background:#05070ddd;border:1px solid #4ee3ff55;padding:.28rem}.unavailable{height:100%;display:grid;place-content:center;text-align:center;color:var(--sub);font-size:.62rem;letter-spacing:.12em}.meta{padding:.8rem .2rem .2rem;display:flex;justify-content:space-between;gap:1rem}.meta strong,.meta small{display:block}.meta strong{font-size:.82rem}.meta small{color:var(--sub);font-size:.58rem;margin-top:.3rem}.actions{display:flex;align-items:center;gap:.35rem}.actions button,.actions a{border:1px solid var(--line);background:#05070d;color:var(--cyan);padding:.5rem;text-decoration:none;font-size:.52rem}.actions button:hover,.actions a:hover{border-color:var(--cyan);background:#4ee3ff12}.actions button:disabled{opacity:.35}.empty{padding:4rem 0;border-top:1px solid var(--line);color:var(--sub);letter-spacing:.12em}.empty a{color:var(--cyan)}.bar{position:fixed;z-index:20;bottom:1.2rem;left:50%;transform:translateX(-50%);width:min(700px,92%);background:#050912f2;color:var(--cyan);border:1px solid var(--cyan);padding:.8rem 1rem;display:flex;align-items:center;justify-content:space-between;box-shadow:0 0 30px #4ee3ff33}.bar[hidden]{display:none}.bar span{font-size:.62rem;letter-spacing:.12em}.bar button{padding:.7rem 1rem}@media(max-width:700px){.shell{padding:0 1rem 7rem}header{height:64px}.brand{font-size:.7rem}nav{gap:.6rem}nav a{font-size:.48rem}.heading{padding-top:3rem}.meta{display:block}.actions{margin-top:.8rem}}
</style>