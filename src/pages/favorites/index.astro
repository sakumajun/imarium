---
import Layout from '../../layouts/Layout.astro';
import cameras from '../../data/cameras.json';
---
<Layout title="MY WINDOWS | IMARIUM">
<main class="shell"><header><a class="brand" href="/">IMARIUM</a><nav><a href="/explore/">EXPLORE</a><a class="active" href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></nav></header>
<section class="heading"><p>MY WINDOWS</p><h1>お気に入りの「今」へ。</h1><span>見つけた窓を、ここからすぐに開けます。</span></section>
<section id="grid" class="grid"></section><section id="empty" class="empty" hidden><p>まだお気に入りの窓がありません。</p><a href="/explore/">EXPLOREで窓を探す →</a></section>
<div class="bar" id="bar" hidden><span><b id="count">0</b> WINDOWS SELECTED</span><button id="multi">MULTI VIEWで開く →</button></div></main>
<script define:vars={{ cameras }}>
const safeArray=(key)=>{try{const v=JSON.parse(localStorage.getItem(key)||'[]');return Array.isArray(v)?v:[]}catch{return[]}};
const favs=safeArray('imarium:favorites'); const grid=document.querySelector('#grid'); const empty=document.querySelector('#empty'); const bar=document.querySelector('#bar'); const count=document.querySelector('#count'); const selected=new Set();
const byId=Object.fromEntries(cameras.map(c=>[c.cameraId,c])); const list=favs.map(id=>byId[id]).filter(Boolean); if(!list.length) empty.hidden=false;
for(const c of list){const live=c.status==='live'&&c.embedEnabled!==false;const card=document.createElement('article'); card.className='card'; const media=live?`<iframe src="https://www.youtube.com/embed/${c.videoId}?mute=1&playsinline=1" title="${c.name}" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`:`<div class="unavailable">WINDOW HEALTH<br><small>${c.healthReason||'現在確認中です'}</small></div>`;card.innerHTML=`<div class="screen"><span>${live?'● LIVE':'○ CHECK'}</span>${media}</div><div class="meta"><div><strong>${c.name}</strong><small>${c.city} / ${c.prefecture}</small></div><div class="actions"><button class="select" ${live?'':'disabled'}>${live?'SELECT':'CHECK'}</button><a href="/live/${c.cameraId}/">OPEN →</a><button class="remove" aria-label="お気に入りから削除">♡</button></div></div>`; const sel=card.querySelector('.select'); if(live)sel.onclick=()=>{selected.has(c.cameraId)?selected.delete(c.cameraId):selected.add(c.cameraId); card.classList.toggle('selected'); sel.textContent=selected.has(c.cameraId)?'SELECTED':'SELECT'; count.textContent=selected.size; bar.hidden=!selected.size}; card.querySelector('.remove').onclick=()=>{const next=favs.filter(id=>id!==c.cameraId);localStorage.setItem('imarium:favorites',JSON.stringify(next));location.reload()}; grid.append(card)}
document.querySelector('#multi').onclick=()=>{localStorage.setItem('imarium:multiview',JSON.stringify([...selected].slice(0,9)));location.href='/multiview/'};
</script>
</Layout>
<style>.shell{min-height:100vh;padding:0 4vw 8rem;background:#f5f5f2;color:#171717}header{height:80px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ddd}.brand{font-weight:700;letter-spacing:.18em;color:#111;text-decoration:none}nav{display:flex;gap:1.4rem}nav a{font-size:.68rem;letter-spacing:.08em;color:#888;text-decoration:none}.active{color:#111!important}.heading{padding:7vh 0 3rem}.heading>p{font-size:.65rem;letter-spacing:.2em;color:#888}.heading h1{font-size:clamp(2.6rem,6vw,5.5rem);font-weight:450;letter-spacing:-.055em;margin:.5rem 0}.heading span{color:#888}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:1rem}.card{border:1px solid #ddd;background:#fff;padding:.6rem;transition:.2s}.card.selected{outline:2px solid #111}.screen{aspect-ratio:16/9;background:#111;position:relative;overflow:hidden}.screen iframe{width:100%;height:100%;border:0}.screen>span{position:absolute;z-index:1;left:.7rem;top:.6rem;font-size:.55rem;color:#fff;background:#111a;padding:.3rem}.unavailable{height:100%;display:grid;place-content:center;text-align:center;color:#888;font-size:.65rem;letter-spacing:.1em}.unavailable small{margin-top:.4rem;letter-spacing:0;color:#666}.meta{padding:.9rem .2rem .2rem;display:flex;justify-content:space-between;gap:1rem}.meta strong,.meta small{display:block}.meta small{color:#999;font-size:.65rem;margin-top:.3rem}.actions{display:flex;align-items:center;gap:.4rem}.actions button,.actions a{border:1px solid #ddd;background:#fff;color:#333;padding:.55rem;text-decoration:none;font-size:.58rem}.actions button:disabled{opacity:.45;cursor:not-allowed}.empty{padding:4rem 0;border-top:1px solid #ddd}.empty a{color:#111}.bar{position:fixed;bottom:1.2rem;left:50%;transform:translateX(-50%);width:min(700px,92%);background:#111;color:#fff;padding:.8rem 1rem;display:flex;align-items:center;justify-content:space-between;box-shadow:0 15px 50px #0004}.bar[hidden]{display:none}.bar span{font-size:.65rem;letter-spacing:.12em}.bar button{background:#fff;border:0;padding:.75rem 1rem}@media(max-width:700px){.shell{padding:0 1rem 7rem}header{height:68px}nav{gap:.65rem}nav a{font-size:.52rem}.heading{padding-top:4rem}.meta{display:block}.actions{margin-top:.8rem}}</style>