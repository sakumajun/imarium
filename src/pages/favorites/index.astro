---
import Layout from '../../layouts/Layout.astro';
import cameras from '../../data/cameras.json';
---
<Layout title="MY WINDOWS | IMARIUM">
<main class="shell"><header><a class="brand" href="/">IMARIUM // LIVE GRID</a><nav><a href="/">EXPLORE</a><a class="active" href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></nav></header>
<section class="heading"><div><p>02 // MY WINDOWS</p><h1>SAVED WINDOWS</h1><span>保存したライブウィンドウからMULTI VIEWを組み立てます。</span></div><div class="summary"><b id="savedCount">0</b> SAVED <i></i><b id="liveCount">0</b> LIVE</div></section>
<section id="grid" class="grid"></section><section id="empty" class="empty" hidden><span>MY WINDOWS // EMPTY</span><h2>NO SAVED WINDOWS</h2><p>気になるLIVE WINDOWを保存すると、ここからすぐにアクセスできます。</p><a href="/">EXPLORE WINDOWS →</a></section>
<div class="bar" id="bar" hidden><span><b id="count">0</b> / 9 WINDOWS SELECTED</span><div><button id="clear">CLEAR</button><button id="multi">OPEN MULTI VIEW →</button></div></div><div id="toast" class="toast" role="status" aria-live="polite"></div></main>
<script define:vars={{ cameras }}>
import { readFavorites, writeWindowIds, FAVORITES_KEY, MULTIVIEW_KEY, MULTIVIEW_LIMIT } from '../../scripts/window-storage';
let favs=readFavorites();const grid=document.querySelector('#grid'),empty=document.querySelector('#empty'),bar=document.querySelector('#bar'),count=document.querySelector('#count'),savedCount=document.querySelector('#savedCount'),liveCount=document.querySelector('#liveCount'),toast=document.querySelector('#toast');const selected=new Set();const byId=Object.fromEntries(cameras.map(c=>[c.cameraId,c]));const list=favs.map(id=>byId[id]).filter(Boolean);const liveList=list.filter(c=>c.status==='live'&&c.embedEnabled!==false);savedCount.textContent=list.length;liveCount.textContent=liveList.length;if(!list.length)empty.hidden=false;let timer;const say=text=>{toast.textContent=text;toast.classList.add('show');clearTimeout(timer);timer=setTimeout(()=>toast.classList.remove('show'),1500)};const updateBar=()=>{count.textContent=selected.size;bar.hidden=!selected.size};
for(const c of list){const live=c.status==='live'&&c.embedEnabled!==false;const card=document.createElement('article');card.className='card';card.dataset.id=c.cameraId;const media=live?`<iframe src="https://www.youtube-nocookie.com/embed/${c.videoId}?mute=1&playsinline=1&rel=0" title="${c.name}" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`:`<div class="unavailable"><b>WINDOW HEALTH</b><small>${c.healthReason||'現在確認中です'}</small></div>`;card.innerHTML=`<div class="screen"><span class="status ${live?'on':''}">${live?'● LIVE':'○ CHECK'}</span>${media}</div><div class="meta"><div><small>${c.cameraId} // ${c.city}</small><strong>${c.name}</strong><em>${c.prefecture} / ${c.area}</em></div><div class="actions"><button class="select" ${live?'':'disabled'}>${live?'SELECT':'CHECK'}</button><a href="/live/${c.cameraId}/">OPEN →</a><button class="remove" aria-label="お気に入りから削除">♥</button></div></div>`;const sel=card.querySelector('.select');if(live)sel.onclick=()=>{if(selected.has(c.cameraId)){selected.delete(c.cameraId)}else if(selected.size<MULTIVIEW_LIMIT){selected.add(c.cameraId)}else{say(`MULTI VIEWは最大${MULTIVIEW_LIMIT} WINDOWです`);return}card.classList.toggle('selected',selected.has(c.cameraId));sel.textContent=selected.has(c.cameraId)?'✓ SELECTED':'SELECT';updateBar()};card.querySelector('.remove').onclick=()=>{favs=writeWindowIds(FAVORITES_KEY,favs.filter(id=>id!==c.cameraId));selected.delete(c.cameraId);card.remove();savedCount.textContent=Number(savedCount.textContent)-1;if(live)liveCount.textContent=Number(liveCount.textContent)-1;updateBar();say('MY WINDOWSから削除しました');if(!grid.children.length)empty.hidden=false};grid.append(card)}
document.querySelector('#clear').onclick=()=>{selected.clear();document.querySelectorAll('.card.selected').forEach(card=>card.classList.remove('selected'));document.querySelectorAll('.select:not(:disabled)').forEach(btn=>btn.textContent='SELECT');updateBar()};document.querySelector('#multi').onclick=()=>{writeWindowIds(MULTIVIEW_KEY,[...selected].slice(0,MULTIVIEW_LIMIT));location.href='/multiview/'};
</script>
</Layout>
<style>
.shell{min-height:100vh;padding:0 4vw 8rem}header{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font-weight:700;letter-spacing:.2em;color:var(--cyan);text-decoration:none;text-shadow:0 0 12px #4ee3ff88}nav{display:flex;gap:1.4rem}nav a{font-size:.65rem;letter-spacing:.12em;color:var(--sub);text-decoration:none}.active{color:var(--cyan)!important}.heading{padding:6vh 0 2rem;display:flex;align-items:end;justify-content:space-between;gap:2rem;border-bottom:1px solid var(--line);margin-bottom:1rem}.heading p{font-size:.62rem;letter-spacing:.2em;color:var(--sub)}.heading h1{font-size:clamp(2.4rem,6vw,5.4rem);font-weight:500;letter-spacing:.04em;margin:.4rem 0;text-shadow:0 0 20px #4ee3ff22}.heading span{color:var(--sub);font-size:.78rem}.summary{color:var(--sub);font-size:.55rem;letter-spacing:.12em;white-space:nowrap}.summary b{color:var(--cyan);font-size:1.05rem}.summary i{display:inline-block;width:1px;height:13px;background:var(--line);margin:0 .7rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:12px}.card{position:relative;border:1px solid var(--line);background:#050912cc;padding:7px;transition:.2s;box-shadow:0 0 15px #4ee3ff0c}.card::before{content:"";position:absolute;left:-1px;top:-1px;width:28px;height:1px;background:#496a74}.card:hover,.card.selected{border-color:var(--cyan);box-shadow:0 0 22px #4ee3ff33}.card.selected{outline:1px solid var(--cyan);outline-offset:3px}.card.selected::before{background:var(--cyan);box-shadow:0 0 8px var(--cyan)}.screen{aspect-ratio:16/9;background:#020409;position:relative;overflow:hidden}.screen iframe{width:100%;height:100%;border:0}.status{position:absolute;z-index:1;left:.6rem;top:.55rem;font-size:.5rem;letter-spacing:.12em;color:#60757c;background:#05070ddd;border:1px solid var(--line);padding:.28rem}.status.on{color:var(--cyan);border-color:#4ee3ff55}.unavailable{height:100%;display:grid;place-content:center;text-align:center;color:var(--sub);font-size:.62rem;letter-spacing:.12em}.unavailable b,.unavailable small{display:block}.unavailable small{margin-top:.35rem;font-size:.5rem}.meta{padding:.8rem .2rem .2rem;display:flex;justify-content:space-between;gap:1rem}.meta strong,.meta small,.meta em{display:block}.meta strong{font-size:.82rem;margin:.2rem 0}.meta small,.meta em{color:var(--sub);font-size:.52rem;font-style:normal}.actions{display:flex;align-items:end;gap:.35rem}.actions button,.actions a{min-height:38px;border:1px solid var(--line);background:#05070d;color:var(--cyan);padding:.5rem;text-decoration:none;font-size:.52rem}.actions button:hover,.actions a:hover{border-color:var(--cyan);background:#4ee3ff12}.actions button:disabled{opacity:.35}.empty{position:relative;padding:5rem 1rem;border:1px solid var(--line);background-image:linear-gradient(#4ee3ff08 1px,transparent 1px),linear-gradient(90deg,#4ee3ff08 1px,transparent 1px);background-size:28px 28px;text-align:center}.empty span{color:var(--cyan);font-size:.52rem;letter-spacing:.18em}.empty h2{font-size:clamp(2rem,5vw,4rem);font-weight:500;margin:.5rem 0}.empty p{color:var(--sub);font-size:.7rem}.empty a{display:inline-block;margin-top:1rem;border:1px solid var(--cyan);padding:.8rem 1rem;color:var(--cyan);text-decoration:none;font-size:.58rem}.bar{position:fixed;z-index:20;bottom:1.2rem;left:50%;transform:translateX(-50%);width:min(760px,92%);background:#050912f2;color:var(--cyan);border:1px solid var(--cyan);padding:.8rem 1rem;display:flex;align-items:center;justify-content:space-between;box-shadow:0 0 30px #4ee3ff33}.bar[hidden]{display:none}.bar span{font-size:.62rem;letter-spacing:.12em}.bar>div{display:flex;gap:.4rem}.bar button{padding:.7rem 1rem}.toast{position:fixed;z-index:30;left:50%;bottom:24px;transform:translate(-50%,12px);padding:.7rem 1rem;border:1px solid var(--cyan);background:#050912f2;color:var(--cyan);font-size:.58rem;box-shadow:0 0 22px #4ee3ff33;opacity:0;pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}@media(max-width:700px){.shell{padding:0 1rem 7rem}header{height:64px}.brand{font-size:.65rem}nav{gap:.5rem}nav a{font-size:.44rem}nav a:nth-child(2){display:none}.heading{padding-top:2.5rem;display:block}.summary{margin-top:1rem}.grid{grid-template-columns:1fr}.meta{display:block}.actions{margin-top:.8rem;display:grid;grid-template-columns:1fr 1fr auto}.actions button,.actions a{display:grid;place-items:center;min-height:44px}.bar{bottom:.7rem;padding:.65rem;display:block}.bar span{display:block;margin-bottom:.55rem}.bar>div{display:grid;grid-template-columns:.7fr 1.3fr}.bar button{min-height:44px}.toast{bottom:92px;max-width:90vw;text-align:center}}</style>