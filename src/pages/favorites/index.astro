---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="MY WINDOWS | IMARIUM">
<main class="shell"><header><a class="brand" href="/">IMARIUM // LIVE GRID</a><nav aria-label="メインナビゲーション"><a href="/">EXPLORE</a><a class="active" href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></nav><details class="mobile-menu"><summary aria-label="メニューを開く"><span></span><span></span><span></span></summary><div><a href="/">EXPLORE</a><a class="active" href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></div></details></header>
<section class="heading"><div><p>02 // MY WINDOWS</p><h1>SAVED WINDOWS</h1><span>保存したライブウィンドウからMULTI VIEWを組み立てます。</span></div><div class="summary"><b id="savedCount">0</b> SAVED <i></i><b id="liveCount">0</b> LIVE</div></section>
<section id="grid" class="grid"></section><section id="empty" class="empty" hidden><span>MY WINDOWS // EMPTY</span><h2>NO SAVED WINDOWS</h2><p>気になるLIVE WINDOWを保存すると、ここからすぐにアクセスできます。</p><a href="/">EXPLORE WINDOWS →</a></section>
<div class="bar" id="bar" hidden><span><b id="count">0</b> / 9 WINDOWS SELECTED</span><div><button id="clear">CLEAR</button><button id="multi">OPEN MULTI VIEW →</button></div></div><div id="toast" class="toast" role="status" aria-live="polite"></div></main>
<script>
import cameras from '../../data/cameras.json';
import { readFavorites, writeWindowIds, FAVORITES_KEY, MULTIVIEW_KEY, MULTIVIEW_LIMIT, pruneFavorites, subscribeFavorites } from '../../scripts/window-storage';
type Camera = (typeof cameras)[number];
const grid=document.querySelector<HTMLElement>('#grid');const empty=document.querySelector<HTMLElement>('#empty');const bar=document.querySelector<HTMLElement>('#bar');const count=document.querySelector<HTMLElement>('#count');const savedCount=document.querySelector<HTMLElement>('#savedCount');const liveCount=document.querySelector<HTMLElement>('#liveCount');const toast=document.querySelector<HTMLElement>('#toast');const clearButton=document.querySelector<HTMLButtonElement>('#clear');const multiButton=document.querySelector<HTMLButtonElement>('#multi');const selected=new Set<string>();const byId:Record<string,Camera>=Object.fromEntries(cameras.map((c):[string,Camera]=>[c.cameraId,c]));const isPublished=(id:string)=>{const c=byId[id];return Boolean(c&&c.status==='live'&&c.embedEnabled===true)};let timer:number|undefined;const say=(text:string)=>{if(!toast)return;toast.textContent=text;toast.classList.add('show');if(timer!==undefined)window.clearTimeout(timer);timer=window.setTimeout(()=>toast.classList.remove('show'),1500)};const updateBar=()=>{if(count)count.textContent=String(selected.size);if(bar)bar.hidden=!selected.size};
function render(ids:string[]=readFavorites()){if(!grid||!empty||!savedCount||!liveCount)return;const validIds=ids.filter(isPublished);for(const id of [...selected])if(!validIds.includes(id))selected.delete(id);const list=validIds.map(id=>byId[id]);savedCount.textContent=String(list.length);liveCount.textContent=String(list.length);empty.hidden=list.length>0;grid.innerHTML='';for(const c of list){const card=document.createElement('article');card.className=`card${selected.has(c.cameraId)?' selected':''}`;card.dataset.id=c.cameraId;const media=`<iframe src="https://www.youtube-nocookie.com/embed/${c.videoId}?mute=1&playsinline=1&rel=0" title="${c.name}" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;card.innerHTML=`<div class="screen"><span class="status on">● LIVE</span>${media}</div><div class="meta"><div><small>${c.cameraId} // ${c.city}</small><strong>${c.name}</strong><em>${c.prefecture} / ${c.area}</em></div><div class="actions"><button class="select" aria-pressed="${selected.has(c.cameraId)}">${selected.has(c.cameraId)?'✓ SELECTED':'＋ MULTI'}</button><a href="/live/${c.cameraId}/">OPEN →</a><button class="remove" aria-label="お気に入りから削除">♥</button></div></div>`;const sel=card.querySelector<HTMLButtonElement>('.select');if(sel)sel.onclick=()=>{if(selected.has(c.cameraId)){selected.delete(c.cameraId)}else if(selected.size<MULTIVIEW_LIMIT){selected.add(c.cameraId)}else{say(`MULTI VIEWは最大${MULTIVIEW_LIMIT} WINDOWです`);return}const on=selected.has(c.cameraId);card.classList.toggle('selected',on);sel.textContent=on?'✓ SELECTED':'＋ MULTI';sel.setAttribute('aria-pressed',String(on));updateBar()};const remove=card.querySelector<HTMLButtonElement>('.remove');if(remove)remove.onclick=()=>{writeWindowIds(FAVORITES_KEY,readFavorites().filter(id=>id!==c.cameraId));say('MY WINDOWSから削除しました')};grid.append(card)}updateBar()}
const initial=pruneFavorites(isPublished);render(initial);subscribeFavorites((ids)=>{const valid=ids.filter(isPublished);if(valid.length!==ids.length)pruneFavorites(isPublished);else render(valid)});if(clearButton)clearButton.onclick=()=>{selected.clear();render()};if(multiButton)multiButton.onclick=()=>{writeWindowIds(MULTIVIEW_KEY,[...selected].filter(isPublished).slice(0,MULTIVIEW_LIMIT),MULTIVIEW_LIMIT);location.href='/multiview/'};
</script>
</Layout>
<style>
.shell{min-height:100vh;padding:0 4vw 8rem}header{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);position:relative}.brand{font-weight:700;letter-spacing:.2em;color:var(--cyan);text-decoration:none;text-shadow:0 0 12px #4ee3ff88}nav{display:flex;gap:1.4rem}nav a{font-size:.65rem;letter-spacing:.12em;color:var(--sub);text-decoration:none}.active{color:var(--cyan)!important}.mobile-menu{display:none}.heading{padding:6vh 0 2rem;display:flex;align-items:end;justify-content:space-between;gap:2rem;border-bottom:1px solid var(--line);margin-bottom:1rem}.heading p{font-size:.62rem;letter-spacing:.2em;color:var(--sub)}.heading h1{font-size:clamp(2.4rem,6vw,5.4rem);font-weight:500;letter-spacing:.04em;margin:.4rem 0;text-shadow:0 0 20px #4ee3ff22}.heading span{color:var(--sub);font-size:.78rem}.summary{color:var(--sub);font-size:.55rem;letter-spacing:.12em;white-space:nowrap}.summary b{color:var(--cyan);font-size:1.05rem}.summary i{display:inline-block;width:1px;height:13px;background:var(--line);margin:0 .7rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:12px}.card{position:relative;border:1px solid var(--line);background:#050912cc;padding:7px;transition:.2s;box-shadow:0 0 15px #4ee3ff0c}.card::before{content:"";position:absolute;left:-1px;top:-1px;width:28px;height:1px;background:#496a74}.card:hover,.card.selected{border-color:var(--cyan);box-shadow:0 0 22px #4ee3ff33}.card.selected{outline:1px solid var(--cyan);outline-offset:3px}.card.selected::before{background:var(--cyan);box-shadow:0 0 8px var(--cyan)}.screen{aspect-ratio:16/9;background:#020409;position:relative;overflow:hidden}.screen iframe{width:100%;height:100%;border:0}.status{position:absolute;z-index:1;left:.6rem;top:.55rem;font-size:.5rem;letter-spacing:.12em;color:#60757c;background:#05070ddd;border:1px solid var(--line);padding:.28rem}.status.on{color:var(--cyan);border-color:#4ee3ff55}.meta{padding:.8rem .2rem .2rem;display:flex;justify-content:space-between;gap:1rem}.meta strong,.meta small,.meta em{display:block}.meta strong{font-size:.82rem;margin:.2rem 0}.meta small,.meta em{color:var(--sub);font-size:.52rem;font-style:normal}.actions{display:flex;align-items:end;gap:.35rem}.actions button,.actions a{min-height:38px;border:1px solid var(--line);background:#05070d;color:var(--cyan);padding:.5rem;text-decoration:none;font-size:.52rem}.actions button:hover,.actions a:hover{border-color:var(--cyan);background:#4ee3ff12}.select[aria-pressed="true"]{background:var(--cyan);color:#03070b;border-color:var(--cyan);box-shadow:0 0 12px #4ee3ff44}.empty{position:relative;padding:5rem 1rem;border:1px solid var(--line);background-image:linear-gradient(#4ee3ff08 1px,transparent 1px),linear-gradient(90deg,#4ee3ff08 1px,transparent 1px);background-size:28px 28px;text-align:center}.empty span{color:var(--cyan);font-size:.52rem;letter-spacing:.18em}.empty h2{font-size:clamp(2rem,5vw,4rem);font-weight:500;margin:.5rem 0}.empty p{color:var(--sub);font-size:.7rem}.empty a{display:inline-block;margin-top:1rem;border:1px solid var(--cyan);padding:.8rem 1rem;color:var(--cyan);text-decoration:none;font-size:.58rem}.bar{position:fixed;z-index:20;bottom:1.2rem;left:50%;transform:translateX(-50%);width:min(760px,92%);box-sizing:border-box;background:#050912f2;color:var(--cyan);border:1px solid var(--cyan);padding:.8rem 1rem;display:flex;align-items:center;justify-content:space-between;box-shadow:0 0 30px #4ee3ff33;backdrop-filter:blur(12px)}.bar[hidden]{display:none}.bar span{font-size:.62rem;letter-spacing:.12em}.bar>div{display:flex;gap:.4rem}.bar button{padding:.7rem 1rem}.toast{position:fixed;z-index:30;left:50%;bottom:24px;transform:translate(-50%,12px);padding:.7rem 1rem;border:1px solid var(--cyan);background:#050912f2;color:var(--cyan);font-size:.58rem;box-shadow:0 0 22px #4ee3ff33;opacity:0;pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}@media(max-width:700px){.shell{padding:0 1rem 8.5rem}header{height:64px}.brand{font-size:.62rem;letter-spacing:.12em;white-space:nowrap}header nav{display:none}.mobile-menu{display:block;position:relative}.mobile-menu summary{list-style:none;width:44px;height:44px;border:1px solid var(--line);display:grid;place-content:center;gap:4px;cursor:pointer;background:#050912cc}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu summary span{display:block;width:16px;height:1px;background:var(--cyan);box-shadow:0 0 5px #4ee3ff55}.mobile-menu[open] summary{border-color:var(--cyan);box-shadow:0 0 12px #4ee3ff22}.mobile-menu div{position:absolute;z-index:40;right:0;top:50px;width:190px;border:1px solid var(--cyan);background:#050912f7;box-shadow:0 0 25px #4ee3ff22;padding:.35rem}.mobile-menu div a{display:block;padding:.85rem .75rem;color:var(--sub);text-decoration:none;font-size:.55rem;letter-spacing:.1em;border-bottom:1px solid var(--line)}.mobile-menu div a:last-child{border-bottom:0}.mobile-menu div .active{color:var(--cyan);background:#4ee3ff0d}.heading{padding-top:2.5rem;display:block}.summary{margin-top:1rem}.grid{grid-template-columns:1fr;gap:10px}.card{padding:5px}.meta{display:block;padding:.7rem .15rem .15rem}.meta strong{font-size:.9rem}.actions{margin-top:.75rem;display:grid;grid-template-columns:1fr 1fr 48px;gap:.4rem}.actions button,.actions a{display:grid;place-items:center;min-height:48px;font-size:.56rem}.actions .remove{padding:0;font-size:1rem}.bar{bottom:max(.65rem,env(safe-area-inset-bottom));width:calc(100% - 1rem);padding:.7rem;display:grid;grid-template-columns:auto 1fr;gap:.7rem;align-items:center}.bar span{margin:0;font-size:.56rem;line-height:1.35}.bar span b{display:block;font-size:1rem}.bar>div{display:grid;grid-template-columns:.7fr 1.3fr;gap:.4rem}.bar button{min-height:50px;padding:.55rem .6rem;font-size:.55rem}.toast{bottom:calc(88px + env(safe-area-inset-bottom));max-width:90vw;text-align:center}}</style>