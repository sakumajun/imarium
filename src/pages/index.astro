---
import Layout from '../layouts/Layout.astro';
const prefectures=['北海道','青森県','岩手県','宮城県','秋田県','山形県','福島県','茨城県','栃木県','群馬県','埼玉県','千葉県','東京都','神奈川県','新潟県','富山県','石川県','福井県','山梨県','長野県','岐阜県','静岡県','愛知県','三重県','滋賀県','京都府','大阪府','兵庫県','奈良県','和歌山県','鳥取県','島根県','岡山県','広島県','山口県','徳島県','香川県','愛媛県','高知県','福岡県','佐賀県','長崎県','熊本県','大分県','宮崎県','鹿児島県','沖縄県'];
const prefHref=(index:number)=>index===0?'/explore/hokkaido/':`/?pref=${index+1}`;
---
<Layout title="IMARIUM"><main class="explore"><div class="hud"><a href="/">IMARIUM // LIVE GRID</a><p>JAPAN // INTERACTIVE GRID MAP</p><div class="intro"><span>ABOUT IMARIUM</span><strong>日本各地の「今」を、ライブ映像で探索する。</strong><p>IMARIUMは、日本各地のライブカメラを地図から探し、<br />その場所の現在の風景をリアルタイムで眺めるためのサイトです。</p></div></div><nav><a class="active" href="/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></nav><button id="prefMenuToggle" class="prefMenuToggle" type="button" aria-expanded="false" aria-controls="prefNav"><span></span><span></span><span></span><b>AREA</b></button><aside id="prefNav" class="prefNav"><div class="prefHead"><span>47 PREFECTURES</span><small>NORTH → SOUTH</small></div><div class="prefList">{prefectures.map((name,index)=><a class:list={['prefButton',{available:index===0}]} href={prefHref(index)} data-pref-code={index+1}><span>{String(index+1).padStart(2,'0')}</span>{name}</a>)}</div></aside><div id="stage"><div id="mapViewport"><div id="mapHost"></div></div></div><div id="tooltip"></div><div id="status">VECTOR MAP LOADING...</div></main>
<script>
const prefNames=['北海道','青森県','岩手県','宮城県','秋田県','山形県','福島県','茨城県','栃木県','群馬県','埼玉県','千葉県','東京都','神奈川県','新潟県','富山県','石川県','福井県','山梨県','長野県','岐阜県','静岡県','愛知県','三重県','滋賀県','京都府','大阪府','兵庫県','奈良県','和歌山県','鳥取県','島根県','岡山県','広島県','山口県','徳島県','香川県','愛媛県','高知県','福岡県','佐賀県','長崎県','熊本県','大分県','宮崎県','鹿児島県','沖縄県'];const host=document.getElementById('mapHost') as HTMLElement;const tip=document.getElementById('tooltip') as HTMLElement;const statusEl=document.getElementById('status') as HTMLElement;const menuToggle=document.getElementById('prefMenuToggle') as HTMLButtonElement|null;const prefNav=document.getElementById('prefNav') as HTMLElement|null;function getPrefGroup(target:EventTarget|null):SVGGElement|null{return target instanceof Element?target.closest<SVGGElement>('.prefecture'):null}function prefCode(g:SVGGElement):number{return parseInt(g.dataset.code||g.getAttribute('data-code')||'0',10)}function prefName(g:SVGGElement):string{const code=prefCode(g);return prefNames[code-1]||g.getAttribute('aria-label')||'都道府県'}function selectPref(code:number):void{if(code===1){location.href='/explore/hokkaido/';return}const name=prefNames[code-1]||'都道府県';tip.textContent=`${name} // COMING SOON`;tip.style.display='block';tip.style.left='50%';tip.style.top='50%';tip.style.transform='translate(-50%,-50%)';window.setTimeout(()=>{tip.style.display='none';tip.style.transform=''},1100)}function openPref(g:SVGGElement):void{selectPref(prefCode(g))}menuToggle?.addEventListener('click',()=>{const open=prefNav?.classList.toggle('open')??false;menuToggle.setAttribute('aria-expanded',String(open))});document.querySelectorAll<HTMLAnchorElement>('.prefButton').forEach(link=>link.addEventListener('click',e=>{const code=Number(link.dataset.prefCode);if(code!==1){e.preventDefault();selectPref(code)}prefNav?.classList.remove('open');menuToggle?.setAttribute('aria-expanded','false')}));async function init():Promise<void>{try{const res=await fetch('https://raw.githubusercontent.com/geolonia/japanese-prefectures/master/map-full.svg',{cache:'force-cache'});if(!res.ok)throw new Error('HTTP '+res.status);const text=await res.text();const doc=new DOMParser().parseFromString(text,'image/svg+xml');const imported=document.importNode(doc.documentElement,true);imported.removeAttribute('width');imported.removeAttribute('height');imported.setAttribute('preserveAspectRatio','xMidYMid meet');host.replaceChildren(imported);const svg=host.querySelector<SVGSVGElement>('svg');if(!svg)throw new Error('SVG root not found');const prefs=[...svg.querySelectorAll<SVGGElement>('.prefecture')];prefs.forEach((g,i)=>{if(!g.dataset.code)g.dataset.code=String(i+1).padStart(2,'0');g.setAttribute('tabindex','0');g.setAttribute('role','button');g.setAttribute('aria-label',prefName(g));if(prefCode(g)===1)g.classList.add('available')});statusEl.textContent='47 PREFECTURES ONLINE // HOKKAIDO AVAILABLE';svg.addEventListener('pointermove',e=>{const g=getPrefGroup(e.target);if(!g){tip.style.display='none';return}tip.style.transform='';tip.textContent=prefName(g)+(prefCode(g)===1?' // OPEN':' // STANDBY');tip.style.display='block';tip.style.left=(e.clientX+14)+'px';tip.style.top=(e.clientY+12)+'px'});svg.addEventListener('pointerleave',()=>tip.style.display='none');svg.addEventListener('click',e=>{const g=getPrefGroup(e.target);if(g)openPref(g)});svg.addEventListener('keydown',e=>{const g=getPrefGroup(e.target);if(g&&(e.key==='Enter'||e.key===' ')){e.preventDefault();openPref(g)}})}catch(err){console.error(err);statusEl.textContent='VECTOR LOAD FAILED // RETRY'}}void init();
</script></Layout>
<style>
.explore{min-height:100vh;overflow:hidden}.hud{position:fixed;z-index:10;left:22px;top:20px}.hud>a{color:var(--cyan);text-decoration:none;font-size:18px;font-weight:700;letter-spacing:.22em;text-shadow:0 0 15px #4ee3ffbf}.hud>p{margin:7px 0 0;color:var(--sub);font-size:11px;letter-spacing:.18em}.intro{width:min(390px,36vw);margin-top:34px;padding:14px 0 14px 15px;border-left:1px solid #4ee3ff8c;background:linear-gradient(90deg,#4ee3ff0e,transparent)}.intro span{display:block;margin-bottom:10px;color:var(--cyan);font-size:8px;letter-spacing:.22em}.intro strong{display:block;color:var(--text);font-size:14px;line-height:1.7;letter-spacing:.06em;font-weight:500}.intro p{margin:8px 0 0;color:var(--sub);font-size:10px;line-height:1.8}nav{position:fixed;z-index:12;right:22px;top:24px;display:flex;gap:1.2rem}nav a{font-size:.62rem;color:var(--sub);text-decoration:none}.active{color:var(--cyan)!important}.prefNav{position:fixed;z-index:11;left:22px;bottom:22px;width:min(600px,48vw);padding:18px;border:1px solid var(--line);background:#05090ee8;backdrop-filter:blur(8px);box-shadow:0 0 28px #0008}.prefHead{display:flex;justify-content:space-between;margin-bottom:13px;color:var(--cyan);font-size:11px;letter-spacing:.18em}.prefHead small{color:var(--sub);font-size:9px}.prefList{display:flex;flex-wrap:wrap;gap:7px}.prefButton{display:flex;align-items:center;gap:7px;min-width:max-content;padding:8px 10px;border:1px solid #4ee3ff28;color:var(--sub);text-decoration:none;font-size:13px;line-height:1;transition:.15s}.prefButton span{font-size:9px;color:#54717b}.prefButton:hover,.prefButton.available{color:var(--cyan);border-color:#4ee3ff88;background:#4ee3ff0d}.prefButton.available{box-shadow:inset 3px 0 var(--cyan)}.prefMenuToggle{display:none}#stage{position:fixed;inset:0;display:grid;place-items:center}#mapViewport{width:min(92vw,1050px);height:min(88vh,760px);position:relative}#mapHost{position:absolute;inset:0}#mapHost :global(svg){width:100%;height:100%;display:block}#mapHost :global(.prefecture){fill:#4ee3ff0e!important;stroke:var(--cyan)!important;stroke-width:1.25!important;vector-effect:non-scaling-stroke;cursor:pointer;transition:.18s;filter:drop-shadow(0 0 2.5px #4ee3ff8c)}#mapHost :global(.prefecture:hover),#mapHost :global(.prefecture:focus-visible){fill:#4ee3ff47!important;stroke:#eaffff!important;filter:drop-shadow(0 0 9px #4ee3ff);outline:none}#mapHost :global(.prefecture.available){fill:#4ee3ff1f!important;filter:drop-shadow(0 0 5px #4ee3ffcc)}#tooltip{position:fixed;z-index:30;display:none;pointer-events:none;padding:7px 11px;border:1px solid var(--cyan);background:#040911eb;box-shadow:0 0 16px #4ee3ff66;font-size:13px;letter-spacing:.08em}#status{position:fixed;right:18px;bottom:18px;color:var(--sub);font-size:10px;letter-spacing:.12em}#status::before{content:"";display:inline-block;width:6px;height:6px;margin-right:8px;border-radius:50%;background:var(--cyan);box-shadow:0 0 9px var(--cyan)}
@media(max-width:700px){.hud{left:15px;top:14px}.hud>a{font-size:12px}.hud>p{font-size:8px}.intro{width:min(70vw,280px);margin-top:15px;padding:8px 0 8px 9px}.intro span{margin-bottom:5px;font-size:6px}.intro strong{font-size:9px;line-height:1.5}.intro p{font-size:7px;line-height:1.5}.intro br{display:none}nav{top:16px;right:66px;left:auto;gap:.55rem}nav a{font-size:.43rem}.prefMenuToggle{display:flex;position:fixed;z-index:25;right:12px;top:10px;width:46px;height:46px;padding:9px;border:1px solid #4ee3ff77;background:#05090ef2;flex-direction:column;justify-content:center;gap:5px;color:var(--cyan)}.prefMenuToggle span{display:block;width:100%;height:1px;background:var(--cyan)}.prefMenuToggle b{position:absolute;top:48px;right:2px;font-size:7px;letter-spacing:.12em;font-weight:400}.prefNav{display:none;left:auto;right:12px;top:66px;bottom:auto;width:min(90vw,370px);max-height:50vh;padding:14px}.prefNav.open{display:block}.prefHead{position:sticky;top:-14px;z-index:2;padding:10px 0;background:#05090ef8;font-size:10px}.prefHead small{font-size:8px}.prefList{max-height:calc(50vh - 50px);overflow-y:auto;overscroll-behavior:contain;padding-right:4px;gap:7px}.prefButton{font-size:13px;padding:10px 11px;gap:7px}.prefButton span{font-size:9px}#mapViewport{width:96vw;height:68vh;margin-top:18vh}#status{font-size:8px;left:15px;right:auto}}
</style>