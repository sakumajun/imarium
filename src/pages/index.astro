---
import Layout from '../layouts/Layout.astro';
import { latestInformation } from '../data/information';
const prefectures=['北海道','青森県','岩手県','宮城県','秋田県','山形県','福島県','茨城県','栃木県','群馬県','埼玉県','千葉県','東京都','神奈川県','新潟県','富山県','石川県','福井県','山梨県','長野県','岐阜県','静岡県','愛知県','三重県','滋賀県','京都府','大阪府','兵庫県','奈良県','和歌山県','鳥取県','島根県','岡山県','広島県','山口県','徳島県','香川県','愛媛県','高知県','福岡県','佐賀県','長崎県','熊本県','大分県','宮崎県','鹿児島県','沖縄県'];
const prefHref=(index:number)=>index===0?'/explore/hokkaido/':`/?pref=${index+1}`;
---
<Layout title="IMARIUM"><main class="explore"><div class="hud"><a href="/">IMARIUM // LIVE GRID</a><p>JAPAN // INTERACTIVE GRID MAP</p><div class="intro"><span>ABOUT IMARIUM</span><strong>日本各地の「今」を、ライブ映像で探索する。</strong><p>IMARIUMは、日本各地のライブカメラを地図から探し、<br />その場所の現在の風景をリアルタイムで眺めるためのサイトです。</p></div><div class="infoLog"><div class="infoHead"><span>INFORMATION // SYSTEM LOG</span><a href="/information/">ALL →</a></div>{latestInformation.map(item=><a class="infoItem" href={`/information/${item.slug}/`}><time datetime={item.date}>{item.date.slice(5).replace('-','.')} </time><b>{item.category}</b><span>{item.title}</span></a>)}</div></div><nav class="desktopNav"><a class="active" href="/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></nav><details class="mobile-menu"><summary aria-label="メニューを開く"><span></span><span></span><span></span></summary><div><a class="active" href="/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></div></details><button id="prefMenuToggle" class="prefMenuToggle" type="button" aria-expanded="false" aria-controls="prefNav"><span></span><span></span><span></span><b>AREA</b></button><aside id="prefNav" class="prefNav"><div class="prefHead"><span>47 PREFECTURES</span><small>NORTH → SOUTH</small></div><div class="prefList">{prefectures.map((name,index)=><a class:list={['prefButton',{available:index===0,disabled:index!==0}]} href={prefHref(index)} data-pref-code={index+1} aria-disabled={index!==0?'true':undefined}><span>{String(index+1).padStart(2,'0')}</span>{name}</a>)}</div></aside><div id="stage"><div id="mapViewport"><div id="mapHost"></div></div></div><div id="tooltip"></div><div id="status">VECTOR MAP LOADING...</div><nav class="siteLinks" aria-label="サイト情報"><a href="/about/">IMARIUMについて</a><a href="/operator/">運営情報</a><a href="/contact/">お問い合わせ</a><a href="/privacy/">プライバシーポリシー</a></nav></main>
<script>
const prefNames=['北海道','青森県','岩手県','宮城県','秋田県','山形県','福島県','茨城県','栃木県','群馬県','埼玉県','千葉県','東京都','神奈川県','新潟県','富山県','石川県','福井県','山梨県','長野県','岐阜県','静岡県','愛知県','三重県','滋賀県','京都府','大阪府','兵庫県','奈良県','和歌山県','鳥取県','島根県','岡山県','広島県','山口県','徳島県','香川県','愛媛県','高知県','福岡県','佐賀県','長崎県','熊本県','大分県','宮崎県','鹿児島県','沖縄県'];const host=document.getElementById('mapHost') as HTMLElement;const tip=document.getElementById('tooltip') as HTMLElement;const statusEl=document.getElementById('status') as HTMLElement;const menuToggle=document.getElementById('prefMenuToggle') as HTMLButtonElement|null;const prefNav=document.getElementById('prefNav') as HTMLElement|null;function getPrefGroup(target:EventTarget|null):SVGGElement|null{return target instanceof Element?target.closest<SVGGElement>('.prefecture'):null}function prefCode(g:SVGGElement):number{return parseInt(g.dataset.code||g.getAttribute('data-code')||'0',10)}function prefName(g:SVGGElement):string{const code=prefCode(g);return prefNames[code-1]||g.getAttribute('aria-label')||'都道府県'}function selectPref(code:number):void{if(code===1){location.href='/explore/hokkaido/';return}const name=prefNames[code-1]||'都道府県';tip.textContent=`${name} // COMING SOON`;tip.style.display='block';tip.style.left='50%';tip.style.top='50%';tip.style.transform='translate(-50%,-50%)';window.setTimeout(()=>{tip.style.display='none';tip.style.transform=''},1100)}function openPref(g:SVGGElement):void{selectPref(prefCode(g))}menuToggle?.addEventListener('click',()=>{const open=prefNav?.classList.toggle('open')??false;menuToggle.setAttribute('aria-expanded',String(open))});document.querySelectorAll<HTMLAnchorElement>('.prefButton').forEach(link=>link.addEventListener('click',e=>{const code=Number(link.dataset.prefCode);if(code!==1){e.preventDefault();selectPref(code)}prefNav?.classList.remove('open');menuToggle?.setAttribute('aria-expanded','false')}));async function init():Promise<void>{try{const res=await fetch('https://raw.githubusercontent.com/geolonia/japanese-prefectures/master/map-full.svg',{cache:'force-cache'});if(!res.ok)throw new Error('HTTP '+res.status);const text=await res.text();const doc=new DOMParser().parseFromString(text,'image/svg+xml');const imported=document.importNode(doc.documentElement,true);imported.removeAttribute('width');imported.removeAttribute('height');imported.setAttribute('preserveAspectRatio','xMidYMid meet');host.replaceChildren(imported);const svg=host.querySelector<SVGSVGElement>('svg');if(!svg)throw new Error('SVG root not found');const boundary=svg.querySelector<SVGGElement>('.boundary-line');if(boundary){const lines=[...boundary.querySelectorAll<SVGLineElement>('line')];if(lines.length===2){const first=lines[0],second=lines[1];const poly=document.createElementNS('http://www.w3.org/2000/svg','polyline');poly.setAttribute('points',`${first.getAttribute('x2')},${first.getAttribute('y2')} ${first.getAttribute('x1')},${first.getAttribute('y1')} ${second.getAttribute('x1')},${second.getAttribute('y1')} ${second.getAttribute('x2')},${second.getAttribute('y2')}`);boundary.replaceChildren(poly)}boundary.setAttribute('stroke-width','1');boundary.setAttribute('fill','none')}const prefs=[...svg.querySelectorAll<SVGGElement>('.prefecture')];prefs.forEach((g,i)=>{if(!g.dataset.code)g.dataset.code=String(i+1).padStart(2,'0');g.setAttribute('tabindex','0');g.setAttribute('role','button');g.setAttribute('aria-label',prefName(g));if(prefCode(g)===1)g.classList.add('available');else g.classList.add('disabled')});statusEl.textContent='47 PREFECTURES ONLINE // HOKKAIDO AVAILABLE';svg.addEventListener('pointermove',e=>{const g=getPrefGroup(e.target);if(!g){tip.style.display='none';return}tip.style.transform='';tip.textContent=prefName(g)+(prefCode(g)===1?' // OPEN':' // STANDBY');tip.style.display='block';tip.style.left=(e.clientX+14)+'px';tip.style.top=(e.clientY+12)+'px'});svg.addEventListener('pointerleave',()=>tip.style.display='none');svg.addEventListener('click',e=>{const g=getPrefGroup(e.target);if(g)openPref(g)});svg.addEventListener('keydown',e=>{const g=getPrefGroup(e.target);if(g&&(e.key==='Enter'||e.key===' ')){e.preventDefault();openPref(g)}})}catch(err){console.error(err);statusEl.textContent='VECTOR LOAD FAILED // RETRY'}}void init();
</script></Layout>
<style>.siteLinks{position:fixed;z-index:30;right:22px;bottom:18px;display:flex;gap:16px;align-items:center}.siteLinks a{color:#54717b;text-decoration:none;font-size:8px;letter-spacing:.08em;white-space:nowrap}.siteLinks a:hover,.siteLinks a:focus-visible{color:var(--cyan)}

.explore{min-height:100vh;overflow:hidden}.hud{position:fixed;z-index:10;left:22px;top:20px;width:390px}.hud>a{color:var(--cyan);text-decoration:none;font-size:18px;font-weight:700;letter-spacing:.22em;text-shadow:0 0 15px #4ee3ffbf}.hud>p{margin:7px 0 0;color:var(--sub);font-size:11px;letter-spacing:.18em}.intro{width:360px;margin-top:34px;padding:14px 0 14px 15px;border-left:1px solid #4ee3ff8c;background:linear-gradient(90deg,#4ee3ff0e,transparent)}.intro span{display:block;margin-bottom:10px;color:var(--cyan);font-size:8px;letter-spacing:.22em}.intro strong{display:block;color:var(--text);font-size:14px;line-height:1.7;letter-spacing:.06em;font-weight:500}.intro p{margin:8px 0 0;color:var(--sub);font-size:10px;line-height:1.8}.infoLog{margin-top:18px;width:360px;border-top:1px solid var(--line)}.infoHead{display:flex;justify-content:space-between;padding:9px 0 7px;color:var(--cyan);font-size:9px;letter-spacing:.14em}.infoHead a{color:var(--sub);text-decoration:none}.infoItem{display:grid;grid-template-columns:40px 52px 1fr;gap:5px;padding:7px 0;border-top:1px solid #4ee3ff12;text-decoration:none;font-size:9px;color:var(--sub)}.infoItem b{color:var(--cyan);font-weight:500}.infoItem span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.infoItem:hover span{color:var(--cyan)}.desktopNav{position:fixed;z-index:12;right:22px;top:24px;display:flex;gap:1.2rem}.desktopNav a{font-size:.62rem;color:var(--sub);text-decoration:none}.active{color:var(--cyan)!important}.mobile-menu{display:none}.prefNav{position:fixed;z-index:11;left:22px;top:330px;bottom:28px;width:390px;padding:15px 0 0;border-top:1px solid var(--line);background:linear-gradient(90deg,#05090ed9,transparent)}.prefHead{display:flex;justify-content:space-between;margin-bottom:12px;padding-right:10px;color:var(--cyan);font-size:10px;letter-spacing:.18em}.prefHead small{color:var(--sub);font-size:8px}.prefList{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-flow:column;grid-template-rows:repeat(12,minmax(0,1fr));height:calc(100% - 34px);column-gap:10px}.prefButton{display:flex;align-items:center;gap:4px;min-width:0;padding:3px 4px;border:0;border-bottom:1px solid #4ee3ff14;color:var(--sub);text-decoration:none;font-size:12px;line-height:1;white-space:nowrap;transition:.15s}.prefButton span{font-size:8px;color:#54717b;min-width:16px}.prefButton.disabled{color:#60757c;opacity:.62;cursor:not-allowed;text-shadow:none}.prefButton.disabled span{color:#536970}.prefButton.disabled:hover{color:#60757c;text-shadow:none}.prefButton:hover,.prefButton.available{color:var(--cyan);text-shadow:0 0 8px #4ee3ff88}.prefButton.available::before{content:"";width:5px;height:5px;flex:0 0 5px;border-radius:50%;background:var(--cyan);box-shadow:0 0 7px var(--cyan)}.prefMenuToggle{display:none}#stage{position:fixed;left:430px;right:0;top:0;bottom:0;display:grid;place-items:center}#mapViewport{width:min(94%,1050px);height:min(88vh,760px);position:relative}#mapHost{position:absolute;inset:0}#mapHost :global(svg){width:100%;height:100%;display:block}#mapHost :global(.boundary-line){stroke:#496a74!important;stroke-width:1!important;fill:none!important;opacity:.7;vector-effect:non-scaling-stroke}#mapHost :global(.prefecture){fill:#4ee3ff0e!important;stroke:var(--cyan)!important;stroke-width:1.25!important;vector-effect:non-scaling-stroke;cursor:pointer;transition:.18s;filter:drop-shadow(0 0 2.5px #4ee3ff8c)}#mapHost :global(.prefecture.disabled){fill:#4ee3ff09!important;stroke:#496a74!important;opacity:.62;filter:none}#mapHost :global(.prefecture.disabled:hover),#mapHost :global(.prefecture.disabled:focus-visible){fill:#4ee3ff0d!important;stroke:#587b85!important;filter:none}#mapHost :global(.prefecture:hover),#mapHost :global(.prefecture:focus-visible){fill:#4ee3ff47!important;stroke:#eaffff!important;filter:drop-shadow(0 0 9px #4ee3ff);outline:none}#mapHost :global(.prefecture.available){fill:#4ee3ff1f!important;stroke:var(--cyan)!important;opacity:1;filter:drop-shadow(0 0 5px #4ee3ffcc)}#tooltip{position:fixed;z-index:30;display:none;pointer-events:none;padding:7px 11px;border:1px solid var(--cyan);background:#040911eb;box-shadow:0 0 16px #4ee3ff66;font-size:13px;letter-spacing:.08em}#status{position:fixed;right:18px;bottom:18px;color:var(--sub);font-size:10px;letter-spacing:.12em}#status::before{content:"";display:inline-block;width:6px;height:6px;margin-right:8px;border-radius:50%;background:var(--cyan);box-shadow:0 0 9px var(--cyan)}
@media(max-width:900px) and (min-width:701px){.hud{width:300px}.intro{width:280px}.infoLog{width:280px}.prefNav{width:300px;top:330px}.prefButton{font-size:10px;gap:3px}.prefButton span{font-size:7px;min-width:14px}#stage{left:325px}}
@media(max-width:700px){.siteLinks{left:12px;right:12px;bottom:10px;justify-content:center;gap:10px;flex-wrap:wrap}.siteLinks a{font-size:7px}.hud{left:15px;top:14px;width:auto}.hud>a{font-size:12px}.hud>p{font-size:8px}.intro{width:min(70vw,280px);margin-top:15px;padding:8px 0 8px 9px}.intro span{margin-bottom:5px;font-size:6px}.intro strong{font-size:9px;line-height:1.5}.intro p{font-size:7px;line-height:1.5}.intro br{display:none}.infoLog{width:min(70vw,280px);margin-top:10px}.infoHead{font-size:8px}.infoItem{font-size:8px;grid-template-columns:34px 46px 1fr}.desktopNav{display:none}.mobile-menu{display:block;position:fixed;z-index:31;right:12px;top:10px}.mobile-menu summary{list-style:none;width:46px;height:46px;border:1px solid var(--line);display:grid;place-content:center;gap:5px;cursor:pointer;background:#050912f2}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu summary span{display:block;width:17px;height:1px;background:var(--cyan);box-shadow:0 0 5px #4ee3ff55}.mobile-menu[open] summary{border-color:var(--cyan);box-shadow:0 0 12px #4ee3ff22}.mobile-menu div{position:absolute;right:0;top:52px;width:190px;border:1px solid var(--cyan);background:#050912f7;box-shadow:0 0 25px #4ee3ff22;padding:.35rem}.mobile-menu div a{display:block;padding:.85rem .75rem;color:var(--sub);text-decoration:none;font-size:.55rem;letter-spacing:.1em;border-bottom:1px solid var(--line)}.mobile-menu div a:last-child{border-bottom:0}.mobile-menu div .active{color:var(--cyan);background:#4ee3ff0d}.prefMenuToggle{display:flex;position:fixed;z-index:25;right:66px;top:10px;width:46px;height:46px;padding:9px;border:1px solid #4ee3ff77;background:#05090ef2;flex-direction:column;justify-content:center;gap:5px;color:var(--cyan)}.prefMenuToggle span{display:block;width:100%;height:1px;background:var(--cyan)}.prefMenuToggle b{position:absolute;top:48px;right:4px;font-size:7px;letter-spacing:.12em;font-weight:400}.prefNav{display:none;left:auto;right:12px;top:66px;bottom:auto;width:min(90vw,370px);max-height:50vh;padding:14px;border:1px solid var(--line);background:#05090ef8}.prefNav.open{display:block}.prefHead{position:sticky;top:-14px;z-index:2;padding:10px 0;margin:0;background:#05090ef8;font-size:10px}.prefHead small{font-size:8px}.prefList{display:block;height:auto;max-height:calc(50vh - 50px);overflow-y:auto;padding-right:4px}.prefButton{display:flex;width:100%;margin:0;padding:10px 4px;border:0;border-bottom:1px solid #4ee3ff18;font-size:13px}.prefButton span{font-size:9px;min-width:22px}#stage{left:0;right:0;top:0;bottom:0}#mapViewport{width:96vw;height:68vh;margin-top:18vh}#status{font-size:8px;left:15px;right:auto;bottom:18px}}
</style>