---
import Layout from '../layouts/Layout.astro';
---
<Layout title="IMARIUM">
<main class="explore">
  <div class="hud">
    <a href="/">IMARIUM // LIVE GRID</a>
    <p>JAPAN // INTERACTIVE GRID MAP</p>
    <div class="intro">
      <span>ABOUT IMARIUM</span>
      <strong>日本各地の「今」を、ライブ映像で探索する。</strong>
      <p>IMARIUMは、日本各地のライブカメラを地図から探し、<br />その場所の現在の風景をリアルタイムで眺めるためのサイトです。</p>
    </div>
  </div>
  <nav><a class="active" href="/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></nav>
  <div id="stage"><div id="mapViewport"><div id="mapHost"></div></div></div>
  <div id="tooltip"></div>
  <div id="status">VECTOR MAP LOADING...</div>
</main>
<script>
const prefNames=['北海道','青森県','岩手県','宮城県','秋田県','山形県','福島県','茨城県','栃木県','群馬県','埼玉県','千葉県','東京都','神奈川県','新潟県','富山県','石川県','福井県','山梨県','長野県','岐阜県','静岡県','愛知県','三重県','滋賀県','京都府','大阪府','兵庫県','奈良県','和歌山県','鳥取県','島根県','岡山県','広島県','山口県','徳島県','香川県','愛媛県','高知県','福岡県','佐賀県','長崎県','熊本県','大分県','宮崎県','鹿児島県','沖縄県'];
const host=document.getElementById('mapHost') as HTMLElement;
const tip=document.getElementById('tooltip') as HTMLElement;
const statusEl=document.getElementById('status') as HTMLElement;
function getPrefGroup(target:EventTarget|null):SVGGElement|null{return target instanceof Element?target.closest<SVGGElement>('.prefecture'):null}
function prefCode(g:SVGGElement):number{return parseInt(g.dataset.code||g.getAttribute('data-code')||'0',10)}
function prefName(g:SVGGElement):string{const code=prefCode(g);return prefNames[code-1]||g.getAttribute('aria-label')||'都道府県'}
function openPref(g:SVGGElement):void{if(prefCode(g)===1){location.href='/explore/hokkaido/';return}tip.textContent=`${prefName(g)} // COMING SOON`;tip.style.display='block';window.setTimeout(()=>{tip.style.display='none'},1100)}
async function init():Promise<void>{try{const res=await fetch('https://raw.githubusercontent.com/geolonia/japanese-prefectures/master/map-full.svg',{cache:'force-cache'});if(!res.ok)throw new Error('HTTP '+res.status);const text=await res.text();const doc=new DOMParser().parseFromString(text,'image/svg+xml');const imported=document.importNode(doc.documentElement,true);imported.removeAttribute('width');imported.removeAttribute('height');imported.setAttribute('preserveAspectRatio','xMidYMid meet');host.replaceChildren(imported);const svg=host.querySelector<SVGSVGElement>('svg');if(!svg)throw new Error('SVG root not found');const prefs=[...svg.querySelectorAll<SVGGElement>('.prefecture')];prefs.forEach((g,i)=>{if(!g.dataset.code)g.dataset.code=String(i+1).padStart(2,'0');g.setAttribute('tabindex','0');g.setAttribute('role','button');g.setAttribute('aria-label',prefName(g));if(prefCode(g)===1)g.classList.add('available')});statusEl.textContent='47 PREFECTURES ONLINE // HOKKAIDO AVAILABLE';svg.addEventListener('pointermove',e=>{const g=getPrefGroup(e.target);if(!g){tip.style.display='none';return}tip.textContent=prefName(g)+(prefCode(g)===1?' // OPEN':' // STANDBY');tip.style.display='block';tip.style.left=(e.clientX+14)+'px';tip.style.top=(e.clientY+12)+'px'});svg.addEventListener('pointerleave',()=>{tip.style.display='none'});svg.addEventListener('click',e=>{const g=getPrefGroup(e.target);if(g)openPref(g)});svg.addEventListener('keydown',e=>{const g=getPrefGroup(e.target);if(g&&(e.key==='Enter'||e.key===' ')){e.preventDefault();openPref(g)}})}catch(err){console.error(err);statusEl.textContent='VECTOR LOAD FAILED // RETRY'}}
void init();
</script>
</Layout>
<style>
.explore{min-height:100vh;overflow:hidden}.hud{position:fixed;z-index:10;left:22px;top:20px}.hud>a{margin:0;color:var(--cyan);text-decoration:none;font-size:18px;font-weight:700;letter-spacing:.22em;text-shadow:0 0 15px #4ee3ffbf}.hud>p{margin:7px 0 0;color:var(--sub);font-size:11px;letter-spacing:.18em}.intro{width:min(390px,36vw);margin-top:34px;padding:14px 0 14px 15px;border-left:1px solid rgba(78,227,255,.55);background:linear-gradient(90deg,rgba(78,227,255,.055),transparent)}.intro span{display:block;margin-bottom:10px;color:var(--cyan);font-size:8px;letter-spacing:.22em}.intro strong{display:block;color:var(--text);font-size:14px;line-height:1.7;letter-spacing:.06em;font-weight:500}.intro p{margin:8px 0 0;color:var(--sub);font-size:10px;line-height:1.8;letter-spacing:.035em}nav{position:fixed;z-index:10;right:22px;top:24px;display:flex;gap:1.2rem}nav a{font-size:.62rem;color:var(--sub);text-decoration:none}.active{color:var(--cyan)!important}#stage{position:fixed;inset:0;display:grid;place-items:center}#mapViewport{width:min(92vw,1050px);height:min(88vh,760px);position:relative}#mapHost{position:absolute;inset:0;width:100%;height:100%}#mapHost :global(svg){width:100%;height:100%;display:block;overflow:visible}#mapHost :global(.prefecture){fill:rgba(78,227,255,.055)!important;stroke:var(--cyan)!important;stroke-width:1.25!important;vector-effect:non-scaling-stroke;cursor:pointer;transition:fill .18s,filter .18s,opacity .18s;filter:drop-shadow(0 0 2.5px rgba(78,227,255,.55))}#mapHost :global(.prefecture:hover),#mapHost :global(.prefecture:focus-visible){fill:rgba(78,227,255,.28)!important;stroke:#eaffff!important;filter:drop-shadow(0 0 9px rgba(78,227,255,1));outline:none}#mapHost :global(.prefecture.available){fill:rgba(78,227,255,.12)!important;filter:drop-shadow(0 0 5px rgba(78,227,255,.8))}#mapHost :global(.boundary-line){stroke:rgba(78,227,255,.7)!important;vector-effect:non-scaling-stroke}#tooltip{position:fixed;z-index:30;display:none;pointer-events:none;padding:7px 11px;border:1px solid var(--cyan);background:rgba(4,9,17,.92);box-shadow:0 0 16px rgba(78,227,255,.4);font-size:13px;letter-spacing:.08em}#status{position:fixed;right:18px;bottom:18px;color:var(--sub);font-size:10px;letter-spacing:.12em}#status::before{content:"";display:inline-block;width:6px;height:6px;margin-right:8px;border-radius:50%;background:var(--cyan);box-shadow:0 0 9px var(--cyan)}@media(max-width:700px){.hud{left:15px;top:14px}.hud>a{font-size:12px}.hud>p{font-size:8px}.intro{width:min(78vw,320px);margin-top:18px;padding:9px 0 9px 10px}.intro span{margin-bottom:6px;font-size:6px}.intro strong{font-size:10px;line-height:1.55}.intro p{font-size:8px;line-height:1.55}.intro br{display:none}nav{top:58px;left:15px;right:auto;gap:.65rem}nav a{font-size:.48rem}#mapViewport{width:96vw;height:76vh;margin-top:16vh}#status{font-size:8px;left:15px;right:auto}}
</style>