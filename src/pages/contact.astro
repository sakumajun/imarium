---
import Layout from '../layouts/Layout.astro';
import MainNav from '../components/MainNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAFBnKiT7ckG2nmeT';
---
<Layout title="お問い合わせ | IMARIUM" description="IMARIUMへのお問い合わせフォームです。">
<main class="shell"><header><a class="brand" href="/">IMARIUM // LIVE GRID</a><MainNav /></header>
<article class="doc"><p class="eyebrow">06 // CONTACT</p><h1>お問い合わせ</h1><p class="lead">掲載内容、情報提供、掲載に関するご相談、その他のお問い合わせを受け付けています。</p>
<section><h2>CONTACT FORM</h2>
<form id="contactForm"><div class="honeypot" aria-hidden="true"><label>Webサイト<input name="website" type="text" tabindex="-1" autocomplete="off" /></label></div>
<label><span>お名前 <b>必須</b></span><input name="name" type="text" autocomplete="name" required /></label>
<label><span>メールアドレス <b>必須</b></span><input name="email" type="email" autocomplete="email" required /></label>
<label><span>お問い合わせ種別 <b>必須</b></span><select name="type" required><option value="">選択してください</option><option value="掲載について">掲載について</option><option value="情報提供">情報提供</option><option value="取材・掲載相談">取材・掲載相談</option><option value="その他">その他</option></select></label>
<label><span>お問い合わせ内容 <b>必須</b></span><textarea name="message" rows="9" required></textarea></label>
<label class="agree"><input name="privacy" type="checkbox" required /><span><a href="/privacy/" target="_blank">プライバシーポリシー</a>に同意する</span></label>
<div class="turnstile-container"><div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div></div><button id="submitButton" type="submit">SEND // 送信する</button>
<p id="formStatus" class="status" aria-live="polite"></p>
</form>
</section>
<section><h2>FOR STREAM OWNERS</h2><p>掲載中のライブ映像について、配信者・権利者から修正または掲載停止をご希望の場合は、対象WINDOWの名称またはURLが分かる情報をお問い合わせ内容にご記載ください。</p></section>
</article><SiteFooter /></main>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
const form=document.getElementById('contactForm') as HTMLFormElement|null;const status=document.getElementById('formStatus');const button=document.getElementById('submitButton') as HTMLButtonElement|null;
form?.addEventListener('submit',async(event)=>{event.preventDefault();if(!form.reportValidity()||!status||!button)return;const fd=new FormData(form);const turnstileToken=String(fd.get('cf-turnstile-response')??'').trim();if(!turnstileToken){status.textContent='セキュリティ確認が完了していません。少し待ってから、もう一度お試しください。';status.className='status error';return}button.disabled=true;button.textContent='送信中…';status.textContent='';status.className='status';try{const response=await fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json; charset=utf-8'},body:JSON.stringify({name:String(fd.get('name')??'').trim(),email:String(fd.get('email')??'').trim(),category:String(fd.get('type')??'').trim(),message:String(fd.get('message')??'').trim(),website:String(fd.get('website')??'').trim(),privacy:fd.get('privacy')==='on',turnstileToken})});const result=await response.json();if(!response.ok||!result.ok)throw new Error(result.message||'お問い合わせの送信に失敗しました。');form.reset();status.textContent=result.message||'お問い合わせを送信しました。';status.className='status success';if('turnstile' in window&&typeof (window as any).turnstile?.reset==='function')(window as any).turnstile.reset()}catch(error){status.textContent=error instanceof Error?error.message:'お問い合わせの送信に失敗しました。';status.className='status error';if('turnstile' in window&&typeof (window as any).turnstile?.reset==='function')(window as any).turnstile.reset()}finally{button.disabled=false;button.textContent='SEND // 送信する'}});
</script>
</Layout>
<style>
.shell{min-height:100vh;padding:0 4vw 3rem}header{height:76px;display:grid;grid-template-columns:1fr 1fr;align-items:center;border-bottom:1px solid var(--line)}.brand{font-weight:700;letter-spacing:.2em;color:var(--cyan);text-decoration:none}.doc{width:min(900px,100%);margin:0 auto;padding:7vh 0}.eyebrow,h2{font-size:.58rem;letter-spacing:.2em;color:var(--cyan)}h1{font-size:clamp(2.4rem,6vw,5rem);font-weight:500;margin:.5rem 0 1.5rem}.lead{font-size:1rem;line-height:2;color:#a9c9d2}.doc section{margin-top:3.5rem;padding-top:1.2rem;border-top:1px solid var(--line)}section p{line-height:2;color:var(--sub);font-size:.82rem}.honeypot{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}.turnstile-container{min-height:65px}.status.success{color:#72f5a4}.status.error{color:#ff8f8f}form{position:relative;margin-top:2rem;display:grid;gap:1.5rem;max-width:720px}label>span{display:block;margin-bottom:.55rem;color:#a9c9d2;font-size:.72rem;letter-spacing:.05em}label b{margin-left:.45rem;color:var(--cyan);font-size:.52rem;font-weight:500}input,select,textarea{width:100%;border:1px solid var(--line);border-radius:0;background:#050a11cc;color:var(--text);padding:.9rem 1rem;font:inherit;font-size:.85rem;outline:none}input:focus,select:focus,textarea:focus{border-color:var(--cyan);box-shadow:0 0 14px #4ee3ff22}textarea{resize:vertical;line-height:1.7}.agree{display:flex;align-items:center;gap:.7rem}.agree input{width:18px;height:18px;flex:0 0 auto}.agree span{margin:0}.agree a{color:var(--cyan)}button{width:max-content;padding:.8rem 1.4rem;font-size:.62rem;cursor:pointer}.status{min-height:1.5rem;margin:0;color:var(--cyan);font-size:.75rem}.note{font-size:.72rem;color:#557985}@media(max-width:700px){.shell{padding:0 1rem 2rem}header{height:64px}.brand{font-size:.62rem}.doc{padding:3rem 0}form{gap:1.2rem}button{width:100%}}
</style>