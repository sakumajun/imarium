---
import Layout from '../../layouts/Layout.astro';
import { information } from '../../data/information';
const items=[...information].sort((a,b)=>b.date.localeCompare(a.date));
---
<Layout title="INFORMATION | IMARIUM" description="IMARIUMからのお知らせ、アップデート、メンテナンス情報。">
<main class="shell">
<header><a href="/" class="brand">IMARIUM // LIVE GRID</a><a href="/" class="back">← EXPLORE</a></header>
<section class="heading"><p>00.01 // INFORMATION</p><h1>INFORMATION <span>// SYSTEM LOG</span></h1><p>IMARIUMからのお知らせ、機能追加、メンテナンス情報。</p></section>
<section class="logs">{items.map(item=><a class="log" href={`/information/${item.slug}/`}><time datetime={item.date}>{item.date.replaceAll('-','.')} </time><b>{item.category}</b><strong>{item.title}</strong><span>→</span></a>)}</section>
</main>
</Layout>
<style>
.shell{min-height:100vh;padding:0 5vw 5rem;max-width:1100px;margin:auto}header{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{color:var(--cyan);font-weight:700;letter-spacing:.2em;text-decoration:none;text-shadow:0 0 12px #4ee3ff88}.back{color:var(--sub);font-size:.6rem;text-decoration:none}.heading{padding:10vh 0 5vh}.heading>p:first-child{color:var(--cyan);font-size:.55rem;letter-spacing:.2em}.heading h1{margin:.7rem 0;font-size:clamp(1.5rem,4vw,3rem);letter-spacing:.12em}.heading h1 span{color:var(--sub);font-weight:400}.heading>p:last-child{color:var(--sub);font-size:.8rem}.logs{border-top:1px solid var(--line)}.log{display:grid;grid-template-columns:120px 110px 1fr 30px;align-items:center;gap:1rem;min-height:76px;border-bottom:1px solid var(--line);text-decoration:none;transition:.18s}.log:hover{background:#4ee3ff09;padding-left:.6rem}.log time,.log b{color:var(--sub);font-size:.58rem;letter-spacing:.12em}.log b{color:var(--cyan)}.log strong{font-size:.82rem;letter-spacing:.04em}.log span{color:var(--cyan)}@media(max-width:650px){.shell{padding:0 1rem 3rem}.brand{font-size:.62rem}.heading{padding:4rem 0 2.5rem}.heading h1 span{display:block;margin-top:.4rem;font-size:.8rem}.log{grid-template-columns:90px 1fr 20px;gap:.5rem;padding:.9rem 0}.log b{grid-column:2}.log strong{grid-column:1/3;font-size:.76rem}.log span{grid-column:3;grid-row:1/4}}
</style>