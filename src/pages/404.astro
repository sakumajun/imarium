---
import Layout from '../layouts/Layout.astro';
---
<Layout title="ページが見つかりません | IMARIUM" description="お探しのページは見つかりませんでした。IMARIUMのEXPLOREから、日本各地の今を探せます。"><main class="nf"><header><a class="brand" href="/">IMARIUM // LIVE GRID</a><nav><a href="/explore/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></nav></header><section><div class="gridLayer"></div><div class="target" aria-hidden="true"><i></i><i></i><span></span></div><div class="copy"><p class="code">ERROR // 404 // WINDOW NOT FOUND</p><h1>LOST<br/>WINDOW</h1><p class="lead">指定されたウィンドウを検出できませんでした。</p><div class="actions"><a class="primary" href="/explore/">SCAN EXPLORE →</a><a href="/">RETURN HOME</a></div></div></section><footer><span>IMARIUM // SIGNAL NETWORK</span><span>SEARCH → CONNECT → WATCH LIVE</span></footer></main></Layout>
<style>.nf{min-height:100vh;padding:0 4vw 1.5rem;display:flex;flex-direction:column}header{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font-weight:700;letter-spacing:.2em;color:var(--cyan);text-decoration:none;text-shadow:0 0 12px #4ee3ff88}nav{display:flex;gap:1.2rem}nav a{font-size:.58rem;letter-spacing:.11em;color:var(--sub);text-decoration:none}section{flex:1;min-height:560px;position:relative;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;overflow:hidden}.gridLayer{position:absolute;inset:0;background-image:linear-gradient(#4ee3ff0a 1px,transparent 1px),linear-gradient(90deg,#4ee3ff0a 1px,transparent 1px);background-size:30px 30px;mask-image:linear-gradient(90deg,#000,transparent 90%)}.copy{position:relative;z-index:2}.code{font-size:.58rem;letter-spacing:.2em;color:var(--cyan);margin:0 0 1.3rem}h1{font-size:clamp(4rem,12vw,10rem);line-height:.78;letter-spacing:.04em;font-weight:500;margin:0;text-shadow:0 0 30px #4ee3ff22}.lead{color:var(--sub);margin:2rem 0 2.2rem;font-size:.75rem;letter-spacing:.08em}.actions{display:flex;gap:.7rem;flex-wrap:wrap}.actions a{border:1px solid var(--line);color:var(--cyan);text-decoration:none;padding:.85rem 1.1rem;font-size:.62rem;letter-spacing:.1em;background:#05070dcc}.actions a:hover,.actions .primary{border-color:var(--cyan);background:#4ee3ff0d;box-shadow:0 0 14px #4ee3ff22}.target{position:absolute;z-index:1;right:6vw;top:50%;transform:translateY(-50%);width:min(35vw,420px);aspect-ratio:1;border:1px solid #4ee3ff18;border-radius:50%;box-shadow:0 0 60px #4ee3ff0c}.target i{position:absolute;border:1px solid #4ee3ff22;border-radius:50%;inset:18%}.target i+i{inset:36%}.target::before,.target::after{content:"";position:absolute;background:#4ee3ff18}.target::before{height:1px;width:120%;left:-10%;top:50%}.target::after{width:1px;height:120%;top:-10%;left:50%}.target span{position:absolute;width:8px;height:8px;left:calc(50% - 4px);top:calc(50% - 4px);border:1px solid var(--cyan);box-shadow:0 0 10px var(--cyan);animation:pulse 2s infinite}@keyframes pulse{to{transform:scale(8);opacity:0}}footer{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:1rem;color:var(--sub);font-size:.48rem;letter-spacing:.14em}@media(max-width:700px){.nf{padding:0 1rem 1rem}header{height:64px}.brand{font-size:.66rem}nav{gap:.55rem}nav a{font-size:.45rem}section{min-height:calc(100vh - 120px)}h1{font-size:clamp(4rem,22vw,7rem)}.target{width:65vw;right:-25vw;opacity:.55}.actions{width:100%}.actions a{width:100%;text-align:center}footer span:last-child{display:none}}</style>