---
import Layout from '../../../layouts/Layout.astro';
import cameras from '../../../data/cameras.json';
const verified=cameras.filter(c=>c.prefecture==='青森県'&&c.status==='live'&&c.embedEnabled===true);
const sources=[
{area:'青森市',title:'青森駅前・青森ベイブリッジ',operator:'ABA青森朝日放送',url:'https://www.youtube.com/@ABA%E9%9D%92%E6%A3%AE%E6%9C%9D%E6%97%A5%E6%94%BE%E9%80%81/streams',note:'公式チャンネルで現在の配信を確認してください。'},
{area:'青森市・弘前市・八戸市',title:'陸奥湾・弘前公園と岩木山・八戸港',operator:'ATV青森テレビ',url:'https://new.atv.jp/camera/index.php',note:'公式ページの静止画像は約2分間隔で更新。動画LIVEではありません。'},
{area:'弘前市ほか',title:'弘前市公式ライブカメラ',operator:'弘前市',url:'https://www.city.hirosaki.aomori.jp/',note:'公式サイトのライブカメラ案内からご確認ください。'},
{area:'津軽地方',title:'国道7号・津軽自動車道の道路状況',operator:'国土交通省 弘前国道維持出張所',url:'https://www.thr.mlit.go.jp/aomori/syutu/hirokoku/',note:'約15分間隔で更新される道路画像です。'},
{area:'青森県内',title:'みちのく有料道路・道路カメラ',operator:'青森県道路公社',url:'https://www.aodoko.or.jp/',note:'公式サイトから道路状況をご確認ください。'}
];
---
<Layout title="青森県の今 | IMARIUM"><main class="shell"><header><a href="/">← JAPAN</a><a class="brand" href="/">IMARIUM // LIVE GRID</a><nav><a href="/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></nav></header><div class="intro"><p>02 // EXPLORE / AOMORI</p><h1>青森県 <span>AOMORI</span></h1><p>青森の街並み・自然・交通を、公式配信元から探す。</p></div>{verified.length>0&&<section><h2>VERIFIED LIVE WINDOWS</h2><div class="cards">{verified.map(c=><a class="card" href={`/live/${c.cameraId}/`}><small>LIVE WINDOW</small><h3>{c.name}</h3><p>{c.city}</p><b>OPEN WINDOW ↗</b></a>)}</div></section>}<section><h2>OFFICIAL CAMERA SOURCES</h2><p class="notice">外部の公式カメラへの案内です。IMARIUM内のLIVE再生が確認された映像とは区別しています。</p><div class="cards">{sources.map(s=><a class="card" href={s.url} target="_blank" rel="noopener noreferrer"><small>{s.area} // {s.operator}</small><h3>{s.title}</h3><p>{s.note}</p><b>公式配信元で確認 ↗</b></a>)}</div></section><footer><a href="/">← JAPAN MAP</a><span>{verified.length} VERIFIED LIVE WINDOWS</span></footer></main></Layout>
<style>.shell{min-height:100vh;padding:0 clamp(1rem,4vw,5rem) 4rem}header{height:76px;display:flex;align-items:center;justify-content:space-between;gap:1rem;border-bottom:1px solid var(--line)}a{color:var(--cyan);text-decoration:none}.brand{font-weight:700;letter-spacing:.16em}nav{display:flex;gap:1.1rem}nav a,header>a:first-child{font-size:.65rem;color:var(--sub)}.intro{padding:clamp(3rem,7vw,6rem) 0 2rem}.intro>p:first-child,h2{font-size:.7rem;letter-spacing:.16em;color:var(--cyan)}h1{font-size:clamp(2.5rem,7vw,5rem);font-weight:500;margin:.6rem 0}h1 span{display:block;font-size:.23em;letter-spacing:.4em;color:var(--sub)}.intro>p:last-child,.notice{color:var(--sub);line-height:1.8}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr));gap:1rem;margin:1.3rem 0 3rem}.card{display:flex;flex-direction:column;gap:.9rem;border:1px solid var(--line);padding:1.5rem;min-height:190px;background:#4ee3ff08;transition:border-color .2s}.card:hover,.card:focus-visible{border-color:var(--cyan)}.card small{color:var(--sub);font-size:.62rem}.card h3{font-size:1.05rem;color:var(--cyan);margin:0;font-weight:500}.card p{font-size:.75rem;color:var(--sub);line-height:1.6;flex:1;margin:0}.card b{font-size:.7rem;letter-spacing:.06em}footer{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:1.5rem;color:var(--sub);font-size:.7rem}@media(max-width:700px){header{height:65px}nav{display:none}.brand{font-size:.75rem}}</style>
