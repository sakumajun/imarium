---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="EXPLORE | IMARIUM">
  <main class="explore-shell">
    <header class="topbar">
      <a class="brand" href="/">IMARIUM</a>
      <nav><a class="active" href="/explore/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></nav>
    </header>

    <section class="intro">
      <p class="kicker">EXPLORE JAPAN</p>
      <h1>日本の「今」を、<br />見にいこう。</h1>
      <p>現在公開中の地域から選んでください。</p>
    </section>

    <section class="map-stage" aria-label="日本の地域を選ぶ">
      <div class="japan-map">
        <a class="region hokkaido" href="/explore/hokkaido/" aria-label="北海道を開く"><span>北海道</span><b>HOKKAIDO</b></a>
      </div>
      <p class="hint">現在は北海道のWINDOWを公開しています。対応地域は順次追加します。</p>
    </section>
  </main>
</Layout>

<style>
  .explore-shell{min-height:100vh;padding:0 4vw 4rem;background:radial-gradient(circle at 70% 25%,#fff 0,#f7f7f5 45%,#efefeb 100%)}
  .topbar{height:84px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ddd}
  .brand{font-weight:700;letter-spacing:.18em;color:inherit;text-decoration:none}.topbar nav{display:flex;gap:1.4rem}.topbar nav a{font-size:.72rem;letter-spacing:.08em;text-decoration:none;color:#777}.topbar nav .active{color:#111}
  .intro{max-width:720px;padding:8vh 0 2rem}.kicker{font-size:.7rem;letter-spacing:.22em;color:#777}.intro h1{font-size:clamp(3rem,7vw,6.8rem);font-weight:500;line-height:.95;letter-spacing:-.06em;margin:.6rem 0 1.4rem}.intro>p:last-child{color:#777}
  .map-stage{max-width:1100px;margin:0 auto}.japan-map{position:relative;min-height:360px}.region{position:absolute;display:grid;place-content:center;text-align:center;border:1px solid #bbb;background:rgba(255,255,255,.7);color:#333;text-decoration:none;box-shadow:0 18px 50px rgba(0,0,0,.06);transition:.3s ease;clip-path:polygon(14% 3%,88% 0,100% 31%,89% 92%,48% 100%,6% 80%,0 31%)}.region span{font-size:1rem}.region b{font-size:.55rem;letter-spacing:.14em;margin-top:.35rem;color:#888}.hokkaido{width:210px;height:145px;right:6%;top:0}.hokkaido:hover,.hokkaido:focus-visible{transform:translateY(-8px) scale(1.04);background:#fff;border-color:#555}.hint{text-align:center;color:#999;font-size:.75rem}
  @media(max-width:760px){.explore-shell{padding:0 1rem 3rem}.topbar{height:68px}.topbar nav{gap:.7rem}.topbar nav a{font-size:.56rem}.intro{padding-top:4rem}.japan-map{min-height:260px}.hokkaido{width:150px;height:110px;right:8%}}
</style>
