---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="EXPLORE | IMARIUM">
  <main class="shell">
    <header><a class="brand" href="/">IMARIUM // LIVE GRID</a><nav><a class="active" href="/explore/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></nav></header>
    <section class="title"><div><p>01 // EXPLORE JAPAN</p><h1>SELECT REGION</h1><span>ライブウィンドウを開く地域を選択してください。</span></div><small>REGION DATABASE // ONLINE</small></section>
    <section class="map" aria-label="日本の地域を選ぶ">
      <div class="radar"><i></i><i></i><i></i><span class="axis x"></span><span class="axis y"></span><a class="hokkaido" href="/explore/hokkaido/"><em>01</em><strong>北海道</strong><small>HOKKAIDO</small><b>WINDOWS AVAILABLE →</b></a></div>
      <p class="status"><span></span>ACTIVE REGION: HOKKAIDO // MORE REGIONS STANDBY</p>
    </section>
  </main>
</Layout>
<style>
.shell{min-height:100vh;padding:0 4vw 4rem}header{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font-weight:700;letter-spacing:.2em;color:var(--cyan);text-decoration:none;text-shadow:0 0 12px #4ee3ff88}nav{display:flex;gap:1.4rem}nav a{font-size:.65rem;letter-spacing:.12em;text-decoration:none;color:var(--sub)}nav .active{color:var(--cyan);text-shadow:0 0 8px #4ee3ff88}.title{padding:6vh 0 1rem;display:flex;justify-content:space-between;align-items:end}.title p,.title>small{font-size:.62rem;letter-spacing:.2em;color:var(--sub)}h1{font-size:clamp(2.4rem,6vw,5.8rem);font-weight:500;letter-spacing:.04em;margin:.35rem 0;color:var(--text);text-shadow:0 0 24px #4ee3ff22}.title span{font-size:.78rem;color:var(--sub)}.map{max-width:1100px;margin:auto}.radar{height:460px;position:relative;border:1px solid var(--line);background:radial-gradient(circle at 50% 50%,#4ee3ff0b,transparent 42%);overflow:hidden}.radar>i{position:absolute;border:1px solid #4ee3ff20;border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%)}.radar>i:nth-child(1){width:160px;height:160px}.radar>i:nth-child(2){width:310px;height:310px}.radar>i:nth-child(3){width:500px;height:500px}.axis{position:absolute;background:#4ee3ff16}.axis.x{left:0;top:50%;width:100%;height:1px}.axis.y{top:0;left:50%;height:100%;width:1px}.hokkaido{position:absolute;right:10%;top:13%;width:230px;height:150px;display:grid;place-content:center;text-align:center;border:1px solid var(--cyan);background:#05070ddd;color:var(--cyan);text-decoration:none;clip-path:polygon(14% 3%,88% 0,100% 31%,89% 92%,48% 100%,6% 80%,0 31%);box-shadow:0 0 20px #4ee3ff22;transition:.2s}.hokkaido:hover{transform:translateY(-5px) scale(1.03);background:#4ee3ff14;box-shadow:0 0 30px #4ee3ff44}.hokkaido em{position:absolute;right:28px;top:20px;font-style:normal;font-size:.55rem;opacity:.45}.hokkaido strong{font-size:1.05rem;letter-spacing:.12em}.hokkaido small{font-size:.55rem;letter-spacing:.2em;margin-top:.35rem}.hokkaido b{font-size:.48rem;letter-spacing:.1em;margin-top:.7rem;color:var(--sub)}.status{text-align:right;color:var(--sub);font-size:.55rem;letter-spacing:.13em}.status span{display:inline-block;width:5px;height:5px;background:var(--cyan);border-radius:50%;box-shadow:0 0 8px var(--cyan);margin-right:7px}@media(max-width:700px){.shell{padding:0 1rem 3rem}header{height:64px}.brand{font-size:.7rem}nav{gap:.6rem}nav a{font-size:.48rem}.title{padding-top:3rem;display:block}.title>small{display:none}.radar{height:380px;margin-top:1rem}.hokkaido{width:180px;height:120px;right:7%;top:16%}}
</style>