---
import Layout from '../../../layouts/Layout.astro';
const places = [
  ['wakkanai','稚内','WAKKANAI','52%','8%'],['asahikawa','旭川','ASAHIKAWA','58%','36%'],['furano','富良野','FURANO','55%','53%'],['sapporo','札幌','SAPPORO','31%','55%'],['otaru','小樽','OTARU','22%','51%'],['niseko','ニセコ','NISEKO','20%','67%'],['hakodate','函館','HAKODATE','18%','86%'],['obihiro','帯広','OBIHIRO','69%','61%'],['kushiro','釧路','KUSHIRO','83%','63%']
];
---
<Layout title="北海道の今 | IMARIUM">
  <main class="shell">
    <header><a href="/explore/">← JAPAN</a><a class="brand" href="/">IMARIUM</a></header>
    <section class="title"><p>EXPLORE / HOKKAIDO</p><h1>北海道の「今」</h1><span>都市やエリアを選んで、窓を探します。</span></section>
    <section class="stage">
      <div class="island" aria-label="北海道簡易マップ">
        {places.map(([id,name,en,x,y]) => id === 'sapporo' ?
          <a class="place active" href="/explore/hokkaido/sapporo/" style={`left:${x};top:${y}`}><i></i><strong>{name}</strong><small>{en}</small></a> :
          <button class="place" disabled style={`left:${x};top:${y}`}><i></i><strong>{name}</strong><small>{en}</small></button>
        )}
      </div>
      <div class="legend"><span><i></i> AVAILABLE</span><span class="muted">PoCでは札幌を実装中</span></div>
    </section>
  </main>
</Layout>
<style>
  .shell{min-height:100vh;padding:0 4vw 4rem;background:#f4f4f1}header{height:80px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #d8d8d4}header a{text-decoration:none;color:#555;font-size:.72rem;letter-spacing:.12em}.brand{font-weight:700;color:#111!important}.title{padding:6vh 0 2rem}.title p{font-size:.65rem;letter-spacing:.2em;color:#888}.title h1{font-size:clamp(2.8rem,6vw,5.5rem);font-weight:500;letter-spacing:-.05em;margin:.4rem 0}.title span{color:#888}.stage{max-width:1050px;margin:auto}.island{position:relative;aspect-ratio:1.65;background:linear-gradient(145deg,#e5e5df,#fff);clip-path:polygon(8% 35%,19% 22%,35% 23%,44% 5%,58% 10%,67% 25%,89% 27%,97% 42%,88% 55%,72% 57%,67% 75%,49% 70%,38% 87%,23% 83%,19% 64%,4% 58%);box-shadow:inset 0 0 70px rgba(0,0,0,.05)}.place{position:absolute;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;border:0;background:transparent;color:#777}.place i{width:11px;height:11px;border:2px solid #aaa;border-radius:50%;background:#f4f4f1;margin-bottom:.35rem}.place strong{font-size:.82rem}.place small{font-size:.5rem;letter-spacing:.12em}.place:disabled{opacity:.55}.place.active{text-decoration:none;color:#111}.place.active i{width:17px;height:17px;background:#111;border:4px solid #fff;box-shadow:0 0 0 1px #111}.place.active:hover{transform:translate(-50%,-50%) scale(1.12)}.legend{display:flex;justify-content:space-between;padding:1rem 0;color:#555;font-size:.65rem;letter-spacing:.1em}.legend i{display:inline-block;width:8px;height:8px;border-radius:50%;background:#111;margin-right:.4rem}.muted{color:#999}@media(max-width:700px){.shell{padding:0 1rem 3rem}.island{aspect-ratio:1.05}.place small{display:none}.place strong{font-size:.68rem}.title{padding-top:3rem}}
</style>
