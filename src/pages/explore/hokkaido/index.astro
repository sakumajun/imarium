---
import Layout from '../../../layouts/Layout.astro';
import cameras from '../../../data/cameras.json';
const places=[
{id:'wakkanai',name:'稚内',en:'WAKKANAI',lat:45.4157,lon:141.6731,match:['稚内市']},{id:'asahikawa',name:'旭川',en:'ASAHIKAWA',lat:43.7706,lon:142.3650,match:['旭川市']},{id:'furano',name:'富良野',en:'FURANO',lat:43.3420,lon:142.3832,match:['富良野市']},{id:'sapporo',name:'札幌',en:'SAPPORO',lat:43.0618,lon:141.3545,match:['札幌市','札幌市ほか']},{id:'otaru',name:'小樽',en:'OTARU',lat:43.1907,lon:140.9947,match:['小樽市']},{id:'chitose',name:'新千歳',en:'NEW CHITOSE',lat:42.7752,lon:141.6923,match:['千歳市']},{id:'niseko',name:'ニセコ',en:'NISEKO',lat:42.8048,lon:140.6874,match:['ニセコ町','倶知安町']},{id:'hakodate',name:'函館',en:'HAKODATE',lat:41.7687,lon:140.7288,match:['函館市']},{id:'obihiro',name:'帯広',en:'OBIHIRO',lat:42.9236,lon:143.1960,match:['帯広市']},{id:'kushiro',name:'釧路',en:'KUSHIRO',lat:42.9849,lon:144.3818,match:['釧路市']}
].map(place=>{const registered=cameras.filter(c=>place.match.includes(c.city));const live=registered.filter(c=>c.status==='live'&&c.embedEnabled!==false);return{...place,registeredCount:registered.length,liveCount:live.length}});const visiblePlaces=places.filter(p=>p.registeredCount>0);const totalLive=cameras.filter(c=>c.region==='hokkaido'&&c.status==='live'&&c.embedEnabled!==false).length;const totalRegistered=cameras.filter(c=>c.region==='hokkaido').length;
---
<Layout title="北海道の今 | IMARIUM"><main class="shell"><header><a href="/explore/">← JAPAN</a><a class="brand" href="/">IMARIUM // LIVE GRID</a><a href="/favorites/">MY WINDOWS</a></header><section class="title"><div><p>01.01 // EXPLORE / HOKKAIDO</p><h1>HOKKAIDO GRID</h1><span>ACTIVE WINDOW NODES</span></div><div class="summary"><b>{totalLive}</b> LIVE <i></i><b>{totalRegistered}</b> REGISTERED</div></section><section class="stage"><div class="editorBar"><button id="editToggle" type="button">POSITION EDIT: OFF</button><button id="resetPositions" type="button" hidden>RESET</button><button id="copyPositions" type="button" hidden>COPY X/Y</button><span id="editorHint">EDITをONにすると都市をドラッグできます</span></div><div class="mapFrame" aria-label="北海道マップ"><div id="mapCanvas"><div id="hokkaidoMap" aria-hidden="true"></div>{visiblePlaces.map(place=><a class:list={['place',{live:place.liveCount>0}]} data-id={place.id} data-lat={place.lat} data-lon={place.lon} href={`/explore/hokkaido/${place.id}/`}><i></i><strong>{place.name}</strong><small>{place.en}</small><em>{place.liveCount>0?`${place.liveCount} LIVE`:`${place.registeredCount} CHECK`}</em><output class="coords"></output></a>)}</div><div class="gridLayer"></div><div id="mapState" class="mapState">COASTLINE LOADING...</div></div><div class="legend"><span><i class="liveDot"></i> LIVE NODE</span><span><i class="checkDot"></i> CHECK NODE</span><span class="muted">HOKKAIDO NETWORK // ONLINE</span></div><p class="credit">MAP VECTOR: GEOLONIA JAPANESE PREFECTURES / GFDL</p></section></main>
<script>
const host=document.getElementById('hokkaidoMap') as HTMLElement|null;const canvas=document.getElementById('mapCanvas') as HTMLElement|null;const state=document.getElementById('mapState') as HTMLElement|null;const editToggle=document.getElementById('editToggle') as HTMLButtonElement|null;const resetButton=document.getElementById('resetPositions') as HTMLButtonElement|null;const copyButton=document.getElementById('copyPositions') as HTMLButtonElement|null;const hint=document.getElementById('editorHint') as HTMLElement|null;const sources=['https://cdn.jsdelivr.net/gh/geolonia/japanese-prefectures@master/map-full.svg','https://raw.githubusercontent.com/geolonia/japanese-prefectures/master/map-full.svg'];const geo={west:139.25,east:145.95,north:45.65,south:41.25};const storageKey='imarium:hokkaido-node-positions';let editMode=false;type Pos={x:number,y:number};type PosMap=Record<string,Pos>;
function savedPositions():PosMap{try{const value=JSON.parse(localStorage.getItem(storageKey)||'{}');return value&&typeof value==='object'?value:{}}catch{return{}}}function storePositions(value:PosMap){localStorage.setItem(storageKey,JSON.stringify(value))}function autoPosition(node:HTMLElement){const lat=Number(node.dataset.lat),lon=Number(node.dataset.lon);return{x:(lon-geo.west)/(geo.east-geo.west)*100,y:(geo.north-lat)/(geo.north-geo.south)*100}}function setNode(node:HTMLElement,pos:Pos){const x=Math.max(0,Math.min(100,pos.x)),y=Math.max(0,Math.min(100,pos.y));node.style.left=`${x}%`;node.style.top=`${y}%`;node.dataset.x=x.toFixed(2);node.dataset.y=y.toFixed(2);const out=node.querySelector<HTMLOutputElement>('.coords');if(out)out.textContent=`X ${x.toFixed(2)} / Y ${y.toFixed(2)}`}
function positionNodes(){if(!canvas)return;const saved=savedPositions();canvas.querySelectorAll<HTMLElement>('.place').forEach(node=>setNode(node,saved[node.dataset.id||'']||autoPosition(node)))}function currentPositions():PosMap{const value:PosMap={};canvas?.querySelectorAll<HTMLElement>('.place').forEach(node=>{if(node.dataset.id)value[node.dataset.id]={x:Number(node.dataset.x),y:Number(node.dataset.y)}});return value}
function setEditMode(on:boolean){editMode=on;canvas?.classList.toggle('editing',on);if(editToggle)editToggle.textContent=`POSITION EDIT: ${on?'ON':'OFF'}`;if(resetButton)resetButton.hidden=!on;if(copyButton)copyButton.hidden=!on;if(hint)hint.textContent=on?'都市マーカーをドラッグしてください。位置はこのブラウザに自動保存されます。':'EDITをONにすると都市をドラッグできます'}
canvas?.querySelectorAll<HTMLElement>('.place').forEach(node=>{node.addEventListener('click',e=>{if(editMode)e.preventDefault()});node.addEventListener('dragstart',e=>e.preventDefault());node.addEventListener('pointerdown',e=>{if(!editMode||!canvas)return;e.preventDefault();node.setPointerCapture(e.pointerId);node.classList.add('dragging')});node.addEventListener('pointermove',e=>{if(!editMode||!canvas||!node.hasPointerCapture(e.pointerId))return;const rect=canvas.getBoundingClientRect();setNode(node,{x:(e.clientX-rect.left)/rect.width*100,y:(e.clientY-rect.top)/rect.height*100})});node.addEventListener('pointerup',e=>{if(!editMode||!node.hasPointerCapture(e.pointerId))return;node.releasePointerCapture(e.pointerId);node.classList.remove('dragging');storePositions(currentPositions())});node.addEventListener('pointercancel',()=>node.classList.remove('dragging'))});editToggle?.addEventListener('click',()=>setEditMode(!editMode));resetButton?.addEventListener('click',()=>{localStorage.removeItem(storageKey);positionNodes()});copyButton?.addEventListener('click',async()=>{const text=JSON.stringify(currentPositions(),null,2);try{await navigator.clipboard.writeText(text);if(hint)hint.textContent='X/Yをクリップボードへコピーしました'}catch{if(hint)hint.textContent=text}});
async function loadHokkaido():Promise<void>{if(!host||!state)return;let lastError:unknown=null;for(const url of sources){try{const response=await fetch(url,{cache:'force-cache'});if(!response.ok)throw new Error(`HTTP ${response.status}`);const source=await response.text();const doc=new DOMParser().parseFromString(source,'image/svg+xml');const pref=doc.querySelector<SVGGElement>('.hokkaido.prefecture, .prefecture[data-code="1"], .prefecture[data-code="01"]');if(!pref)throw new Error('Hokkaido vector not found');const svg=document.createElementNS('http://www.w3.org/2000/svg','svg');svg.setAttribute('preserveAspectRatio','none');svg.setAttribute('class','hokkaidoVector');const clone=document.importNode(pref,true);clone.removeAttribute('transform');svg.appendChild(clone);host.replaceChildren(svg);await new Promise<void>(resolve=>requestAnimationFrame(()=>resolve()));const box=clone.getBBox();if(!box.width||!box.height)throw new Error('Invalid Hokkaido bounds');svg.setAttribute('viewBox',`${box.x} ${box.y} ${box.width} ${box.height}`);positionNodes();state.textContent='ACCURATE COASTLINE // ONLINE';window.setTimeout(()=>state.classList.add('ready'),900);return}catch(error){lastError=error}}console.error(lastError);state.textContent='COASTLINE LOAD FAILED // RETRY'}void loadHokkaido();
</script></Layout>
<style>.shell{min-height:100vh;padding:0 4vw 4rem}header{height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid var(--line)}header a{text-decoration:none;color:var(--sub);font-size:.62rem;letter-spacing:.12em}header a:last-child{text-align:right}.brand{font-weight:700;color:var(--cyan)!important;letter-spacing:.2em;text-shadow:0 0 12px #4ee3ff88}.title{padding:5vh 0 1.6rem;display:flex;justify-content:space-between;align-items:end}.title p{font-size:.58rem;letter-spacing:.2em;color:var(--sub)}.title h1{font-size:clamp(2.3rem,5vw,5rem);font-weight:500;letter-spacing:.06em;margin:.3rem 0;text-shadow:0 0 22px #4ee3ff22}.title span{font-size:.55rem;letter-spacing:.18em;color:var(--sub)}.summary{font-size:.58rem;letter-spacing:.13em;color:var(--sub)}.summary b{font-size:1.1rem;color:var(--cyan)}.summary i{display:inline-block;width:1px;height:14px;background:var(--line);margin:0 .8rem;vertical-align:middle}.stage{max-width:1050px;margin:auto}.editorBar{min-height:42px;margin-bottom:.55rem;display:flex;align-items:center;gap:.5rem}.editorBar button{padding:.5rem .7rem;font-size:.52rem}.editorBar span{margin-left:.35rem;color:var(--sub);font-size:.52rem;letter-spacing:.08em}.mapFrame{position:relative;aspect-ratio:1.42;background:radial-gradient(circle at 48% 48%,#4ee3ff0d,transparent 62%);border:1px solid var(--line);box-shadow:inset 0 0 70px #4ee3ff10;overflow:hidden}#mapCanvas{position:absolute;inset:4% 3%;z-index:2}#hokkaidoMap{position:absolute;inset:0;z-index:0}#hokkaidoMap :global(svg){width:100%;height:100%;display:block;overflow:visible}#hokkaidoMap :global(.prefecture){fill:rgba(78,227,255,.075)!important;stroke:var(--cyan)!important;stroke-width:1.15!important;vector-effect:non-scaling-stroke;filter:drop-shadow(0 0 4px rgba(78,227,255,.58))}.gridLayer{position:absolute;inset:0;z-index:1;background-image:linear-gradient(#4ee3ff0b 1px,transparent 1px),linear-gradient(90deg,#4ee3ff0b 1px,transparent 1px);background-size:28px 28px;pointer-events:none}.place{z-index:3;position:absolute;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;color:var(--sub);text-align:center;text-decoration:none;transition:transform .18s,text-shadow .18s;touch-action:auto}.place i{width:10px;height:10px;border:1px solid var(--sub);border-radius:50%;background:#05070d;margin-bottom:.35rem}.place strong{font-size:.72rem}.place small{font-size:.43rem;letter-spacing:.11em}.place em{font-size:.4rem;font-style:normal;letter-spacing:.08em;margin-top:.22rem}.place.live{color:var(--cyan)}.place.live i{width:13px;height:13px;background:var(--cyan);border-color:var(--cyan);box-shadow:0 0 8px var(--cyan),0 0 0 6px #4ee3ff16}.place:hover{transform:translate(-50%,-50%) scale(1.16);text-shadow:0 0 8px var(--cyan)}.coords{display:none;margin-top:.3rem;padding:.18rem .3rem;background:#05070de8;border:1px solid var(--cyan);color:var(--cyan);font:500 .42rem/1 monospace;white-space:nowrap}.editing .place{cursor:grab;touch-action:none}.editing .place:hover{transform:translate(-50%,-50%)}.editing .place.dragging{cursor:grabbing;z-index:10}.editing .coords{display:block}.mapState{position:absolute;z-index:4;right:12px;bottom:10px;color:var(--sub);font-size:.48rem;letter-spacing:.12em;transition:opacity .4s}.mapState.ready{opacity:.55}.legend{display:flex;gap:1.4rem;flex-wrap:wrap;padding:1rem 0 .35rem;color:var(--sub);font-size:.52rem;letter-spacing:.1em}.legend i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:.35rem}.liveDot{background:var(--cyan);box-shadow:0 0 7px var(--cyan)}.checkDot{border:1px solid var(--sub)}.muted{margin-left:auto}.credit{margin:.2rem 0 0;color:#45616a;font-size:.42rem;letter-spacing:.08em}@media(max-width:700px){.shell{padding:0 1rem 3rem}header{height:64px}.brand{font-size:.65rem}.title{padding-top:2.8rem;display:block}.summary{margin-top:1rem}.editorBar{flex-wrap:wrap}.editorBar span{width:100%;margin-left:0}.mapFrame{aspect-ratio:1.05}#mapCanvas{inset:8% 1%}.place small{display:none}.place strong{font-size:.62rem}.place em{font-size:.36rem}.muted{margin-left:0}}</style>