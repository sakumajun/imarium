---
import Layout from '../../../layouts/Layout.astro';
import cameras from '../../../data/cameras.json';
const places=[{id:'wakkanai',name:'稚内',en:'WAKKANAI',x:'25%',y:'18%',match:['稚内市']},{id:'asahikawa',name:'旭川',en:'ASAHIKAWA',x:'46%',y:'43%',match:['旭川市']},{id:'furano',name:'富良野',en:'FURANO',x:'47%',y:'56%',match:['富良野市']},{id:'sapporo',name:'札幌',en:'SAPPORO',x:'30%',y:'58%',match:['札幌市','札幌市ほか']},{id:'otaru',name:'小樽',en:'OTARU',x:'24%',y:'54%',match:['小樽市']},{id:'chitose',name:'新千歳',en:'NEW CHITOSE',x:'36%',y:'66%',match:['千歳市']},{id:'niseko',name:'ニセコ',en:'NISEKO',x:'23%',y:'67%',match:['ニセコ町','倶知安町']},{id:'hakodate',name:'函館',en:'HAKODATE',x:'20%',y:'88%',match:['函館市']},{id:'obihiro',name:'帯広',en:'OBIHIRO',x:'60%',y:'65%',match:['帯広市']},{id:'kushiro',name:'釧路',en:'KUSHIRO',x:'72%',y:'67%',match:['釧路市']}].map(place=>{const registered=cameras.filter(c=>place.match.includes(c.city));const live=registered.filter(c=>c.status==='live'&&c.embedEnabled!==false);return{...place,registeredCount:registered.length,liveCount:live.length}});const visiblePlaces=places.filter(p=>p.registeredCount>0);const totalLive=cameras.filter(c=>c.region==='hokkaido'&&c.status==='live'&&c.embedEnabled!==false).length;const totalRegistered=cameras.filter(c=>c.region==='hokkaido').length;
---
<Layout title="北海道の今 | IMARIUM"><main class="shell"><header><a href="/explore/">← JAPAN</a><a class="brand" href="/">IMARIUM // LIVE GRID</a><a href="/favorites/">MY WINDOWS</a></header><section class="title"><div><p>01.01 // EXPLORE / HOKKAIDO</p><h1>HOKKAIDO GRID</h1><span>ACTIVE WINDOW NODES</span></div><div class="summary"><b>{totalLive}</b> LIVE <i></i><b>{totalRegistered}</b> REGISTERED</div></section><section class="stage"><div class="mapFrame" aria-label="北海道マップ"><div id="hokkaidoMap" aria-hidden="true"></div><div class="gridLayer"></div>{visiblePlaces.map(place=><a class:list={['place',{live:place.liveCount>0}]} href={`/explore/hokkaido/${place.id}/`} style={`left:${place.x};top:${place.y}`}><i></i><strong>{place.name}</strong><small>{place.en}</small><em>{place.liveCount>0?`${place.liveCount} LIVE`:`${place.registeredCount} CHECK`}</em></a>)}<div id="mapState" class="mapState">COASTLINE LOADING...</div></div><div class="legend"><span><i class="liveDot"></i> LIVE NODE</span><span><i class="checkDot"></i> CHECK NODE</span><span class="muted">HOKKAIDO NETWORK // ONLINE</span></div><p class="credit">MAP VECTOR: GEOLONIA JAPANESE PREFECTURES / GFDL</p></section></main>
<script>
const host=document.getElementById('hokkaidoMap') as HTMLElement|null;
const state=document.getElementById('mapState') as HTMLElement|null;
const sources=['https://cdn.jsdelivr.net/gh/geolonia/japanese-prefectures@master/map-full.svg','https://raw.githubusercontent.com/geolonia/japanese-prefectures/master/map-full.svg'];
async function loadHokkaido():Promise<void>{if(!host||!state)return;let lastError:unknown=null;for(const url of sources){try{const response=await fetch(url,{cache:'force-cache'});if(!response.ok)throw new Error(`HTTP ${response.status}`);const source=await response.text();const doc=new DOMParser().parseFromString(source,'image/svg+xml');const pref=doc.querySelector<SVGGElement>('.hokkaido.prefecture, .prefecture[data-code="1"], .prefecture[data-code="01"]');if(!pref)throw new Error('Hokkaido vector not found');const svg=document.createElementNS('http://www.w3.org/2000/svg','svg');svg.setAttribute('preserveAspectRatio','xMidYMid meet');svg.setAttribute('class','hokkaidoVector');const clone=document.importNode(pref,true);clone.removeAttribute('transform');svg.appendChild(clone);host.replaceChildren(svg);await new Promise<void>(resolve=>requestAnimationFrame(()=>resolve()));const box=clone.getBBox();if(!box.width||!box.height)throw new Error('Invalid Hokkaido bounds');const pad=Math.max(box.width,box.height)*0.045;svg.setAttribute('viewBox',`${box.x-pad} ${box.y-pad} ${box.width+pad*2} ${box.height+pad*2}`);state.textContent='ACCURATE COASTLINE // ONLINE';window.setTimeout(()=>state.classList.add('ready'),900);return}catch(error){lastError=error}}console.error(lastError);state.textContent='COASTLINE LOAD FAILED // RETRY'}
void loadHokkaido();
</script>
</Layout>
<style>.shell{min-height:100vh;padding:0 4vw 4rem}header{height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid var(--line)}header a{text-decoration:none;color:var(--sub);font-size:.62rem;letter-spacing:.12em}header a:last-child{text-align:right}.brand{font-weight:700;color:var(--cyan)!important;letter-spacing:.2em;text-shadow:0 0 12px #4ee3ff88}.title{padding:5vh 0 1.6rem;display:flex;justify-content:space-between;align-items:end}.title p{font-size:.58rem;letter-spacing:.2em;color:var(--sub)}.title h1{font-size:clamp(2.3rem,5vw,5rem);font-weight:500;letter-spacing:.06em;margin:.3rem 0;text-shadow:0 0 22px #4ee3ff22}.title span{font-size:.55rem;letter-spacing:.18em;color:var(--sub)}.summary{font-size:.58rem;letter-spacing:.13em;color:var(--sub)}.summary b{font-size:1.1rem;color:var(--cyan)}.summary i{display:inline-block;width:1px;height:14px;background:var(--line);margin:0 .8rem;vertical-align:middle}.stage{max-width:1050px;margin:auto}.mapFrame{position:relative;aspect-ratio:1.42;background:radial-gradient(circle at 48% 48%,#4ee3ff0d,transparent 62%);border:1px solid var(--line);box-shadow:inset 0 0 70px #4ee3ff10;overflow:hidden}#hokkaidoMap{position:absolute;inset:4% 3%;z-index:0}#hokkaidoMap :global(svg){width:100%;height:100%;display:block;overflow:visible}#hokkaidoMap :global(.prefecture){fill:rgba(78,227,255,.075)!important;stroke:var(--cyan)!important;stroke-width:1.15!important;vector-effect:non-scaling-stroke;filter:drop-shadow(0 0 4px rgba(78,227,255,.58))}.gridLayer{position:absolute;inset:0;z-index:1;background-image:linear-gradient(#4ee3ff0b 1px,transparent 1px),linear-gradient(90deg,#4ee3ff0b 1px,transparent 1px);background-size:28px 28px;pointer-events:none}.place{z-index:3;position:absolute;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;color:var(--sub);text-align:center;text-decoration:none;transition:.18s}.place i{width:10px;height:10px;border:1px solid var(--sub);border-radius:50%;background:#05070d;margin-bottom:.35rem}.place strong{font-size:.72rem}.place small{font-size:.43rem;letter-spacing:.11em}.place em{font-size:.4rem;font-style:normal;letter-spacing:.08em;margin-top:.22rem}.place.live{color:var(--cyan)}.place.live i{width:13px;height:13px;background:var(--cyan);border-color:var(--cyan);box-shadow:0 0 8px var(--cyan),0 0 0 6px #4ee3ff16}.place:hover{transform:translate(-50%,-50%) scale(1.16);text-shadow:0 0 8px var(--cyan)}.mapState{position:absolute;z-index:4;right:12px;bottom:10px;color:var(--sub);font-size:.48rem;letter-spacing:.12em;transition:opacity .4s}.mapState.ready{opacity:.55}.legend{display:flex;gap:1.4rem;flex-wrap:wrap;padding:1rem 0 .35rem;color:var(--sub);font-size:.52rem;letter-spacing:.1em}.legend i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:.35rem}.liveDot{background:var(--cyan);box-shadow:0 0 7px var(--cyan)}.checkDot{border:1px solid var(--sub)}.muted{margin-left:auto}.credit{margin:.2rem 0 0;color:#45616a;font-size:.42rem;letter-spacing:.08em}@media(max-width:700px){.shell{padding:0 1rem 3rem}header{height:64px}.brand{font-size:.65rem}.title{padding-top:2.8rem;display:block}.summary{margin-top:1rem}.mapFrame{aspect-ratio:1.05}#hokkaidoMap{inset:8% 1%}.place small{display:none}.place strong{font-size:.62rem}.place em{font-size:.36rem}.muted{margin-left:0}}</style>