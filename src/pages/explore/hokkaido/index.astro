---
import Layout from '../../../layouts/Layout.astro';
import cameras from '../../../data/cameras.json';

const places = [
  {id:'wakkanai',name:'稚内',en:'WAKKANAI',x:'52%',y:'8%',match:['稚内市']},
  {id:'asahikawa',name:'旭川',en:'ASAHIKAWA',x:'58%',y:'36%',match:['旭川市']},
  {id:'furano',name:'富良野',en:'FURANO',x:'55%',y:'53%',match:['富良野市']},
  {id:'sapporo',name:'札幌',en:'SAPPORO',x:'31%',y:'55%',match:['札幌市','札幌市ほか']},
  {id:'otaru',name:'小樽',en:'OTARU',x:'22%',y:'51%',match:['小樽市']},
  {id:'chitose',name:'新千歳',en:'NEW CHITOSE',x:'42%',y:'65%',match:['千歳市']},
  {id:'niseko',name:'ニセコ',en:'NISEKO',x:'20%',y:'67%',match:['ニセコ町','倶知安町']},
  {id:'hakodate',name:'函館',en:'HAKODATE',x:'18%',y:'86%',match:['函館市']},
  {id:'obihiro',name:'帯広',en:'OBIHIRO',x:'69%',y:'61%',match:['帯広市']},
  {id:'kushiro',name:'釧路',en:'KUSHIRO',x:'83%',y:'63%',match:['釧路市']}
].map(place => {
  const registered = cameras.filter(c => place.match.includes(c.city));
  const live = registered.filter(c => c.status === 'live' && c.embedEnabled !== false);
  return {...place, registeredCount: registered.length, liveCount: live.length};
});
const totalLive = cameras.filter(c => c.region === 'hokkaido' && c.status === 'live' && c.embedEnabled !== false).length;
const totalRegistered = cameras.filter(c => c.region === 'hokkaido').length;
---
<Layout title="北海道の今 | IMARIUM">
<main class="shell">
<header><a href="/explore/">← JAPAN</a><a class="brand" href="/">IMARIUM</a></header>
<section class="title"><p>EXPLORE / HOKKAIDO</p><h1>北海道の「今」</h1><span>現在確認できているWINDOWから、北海道を探索します。</span><div class="summary"><b>{totalLive}</b> LIVE <i></i><b>{totalRegistered}</b> REGISTERED</div></section>
<section class="stage"><div class="island" aria-label="北海道簡易マップ">
{places.map(place => place.registeredCount > 0 ?
  <a class:list={['place','active',{live:place.liveCount>0}]} href={`/explore/hokkaido/${place.id}/`} style={`left:${place.x};top:${place.y}`}><i></i><strong>{place.name}</strong><small>{place.en}</small><em>{place.liveCount>0 ? `${place.liveCount} LIVE` : `${place.registeredCount} CHECK`}</em></a> :
  <div class="place unavailable" style={`left:${place.x};top:${place.y}`}><i></i><strong>{place.name}</strong><small>{place.en}</small><em>COMING</em></div>
)}
</div><div class="legend"><span><i class="liveDot"></i> LIVE</span><span><i class="checkDot"></i> REGISTERED / CHECK</span><span class="muted">COMING = WINDOW未登録</span></div></section>
</main>
</Layout>
<style>
.shell{min-height:100vh;padding:0 4vw 4rem;background:#f4f4f1;color:#171717}header{height:80px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #d8d8d4}header a{text-decoration:none;color:#555;font-size:.72rem;letter-spacing:.12em}.brand{font-weight:700;color:#111!important}.title{padding:6vh 0 2rem}.title p{font-size:.65rem;letter-spacing:.2em;color:#888}.title h1{font-size:clamp(2.8rem,6vw,5.5rem);font-weight:500;letter-spacing:-.05em;margin:.4rem 0}.title>span{color:#888}.summary{margin-top:1.2rem;font-size:.62rem;letter-spacing:.13em;color:#888}.summary b{font-size:1rem;color:#222}.summary i{display:inline-block;width:1px;height:14px;background:#ccc;margin:0 .8rem;vertical-align:middle}.stage{max-width:1050px;margin:auto}.island{position:relative;aspect-ratio:1.65;background:linear-gradient(145deg,#e5e5df,#fff);clip-path:polygon(8% 35%,19% 22%,35% 23%,44% 5%,58% 10%,67% 25%,89% 27%,97% 42%,88% 55%,72% 57%,67% 75%,49% 70%,38% 87%,23% 83%,19% 64%,4% 58%);box-shadow:inset 0 0 70px rgba(0,0,0,.05)}.place{position:absolute;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;color:#888;text-align:center}.place i{width:10px;height:10px;border:2px solid #aaa;border-radius:50%;background:#f4f4f1;margin-bottom:.35rem}.place strong{font-size:.78rem}.place small{font-size:.47rem;letter-spacing:.11em}.place em{font-size:.43rem;font-style:normal;letter-spacing:.08em;margin-top:.25rem;color:#aaa}.place.active{text-decoration:none;color:#333}.place.active i{width:15px;height:15px;border:4px solid #fff;box-shadow:0 0 0 1px #777;background:#777}.place.active.live{color:#111}.place.active.live i{width:18px;height:18px;background:#111;box-shadow:0 0 0 1px #111,0 0 0 7px #1111}.place.active.live em{color:#111}.place.active:hover{transform:translate(-50%,-50%) scale(1.12)}.unavailable{opacity:.42}.legend{display:flex;gap:1.4rem;flex-wrap:wrap;padding:1rem 0;color:#666;font-size:.58rem;letter-spacing:.1em}.legend i{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:.35rem}.liveDot{background:#111}.checkDot{background:#888}.muted{color:#aaa;margin-left:auto}@media(max-width:700px){.shell{padding:0 1rem 3rem}header{height:68px}.title{padding-top:3rem}.island{aspect-ratio:1.05}.place small{display:none}.place strong{font-size:.65rem}.place em{font-size:.38rem}.muted{margin-left:0}}
</style>