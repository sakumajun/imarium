---
import Layout from '../../../layouts/Layout.astro';
import cameras from '../../../data/cameras.json';
const places=[{id:'wakkanai',name:'稚内',en:'WAKKANAI',x:'52%',y:'8%',match:['稚内市']},{id:'asahikawa',name:'旭川',en:'ASAHIKAWA',x:'58%',y:'36%',match:['旭川市']},{id:'furano',name:'富良野',en:'FURANO',x:'55%',y:'53%',match:['富良野市']},{id:'sapporo',name:'札幌',en:'SAPPORO',x:'31%',y:'55%',match:['札幌市','札幌市ほか']},{id:'otaru',name:'小樽',en:'OTARU',x:'22%',y:'51%',match:['小樽市']},{id:'chitose',name:'新千歳',en:'NEW CHITOSE',x:'42%',y:'65%',match:['千歳市']},{id:'niseko',name:'ニセコ',en:'NISEKO',x:'20%',y:'67%',match:['ニセコ町','倶知安町']},{id:'hakodate',name:'函館',en:'HAKODATE',x:'18%',y:'86%',match:['函館市']},{id:'obihiro',name:'帯広',en:'OBIHIRO',x:'69%',y:'61%',match:['帯広市']},{id:'kushiro',name:'釧路',en:'KUSHIRO',x:'83%',y:'63%',match:['釧路市']}].map(place=>{const registered=cameras.filter(c=>place.match.includes(c.city));const live=registered.filter(c=>c.status==='live'&&c.embedEnabled!==false);return{...place,registeredCount:registered.length,liveCount:live.length}});const visiblePlaces=places.filter(p=>p.registeredCount>0);const totalLive=cameras.filter(c=>c.region==='hokkaido'&&c.status==='live'&&c.embedEnabled!==false).length;const totalRegistered=cameras.filter(c=>c.region==='hokkaido').length;
---
<Layout title="北海道の今 | IMARIUM"><main class="shell"><header><a href="/explore/">← JAPAN</a><a class="brand" href="/">IMARIUM // LIVE GRID</a><a href="/favorites/">MY WINDOWS</a></header><section class="title"><div><p>01.01 // EXPLORE / HOKKAIDO</p><h1>HOKKAIDO GRID</h1><span>ACTIVE WINDOW NODES</span></div><div class="summary"><b>{totalLive}</b> LIVE <i></i><b>{totalRegistered}</b> REGISTERED</div></section><section class="stage"><div class="island" aria-label="北海道簡易マップ">{visiblePlaces.map(place=><a class:list={['place',{live:place.liveCount>0}]} href={`/explore/hokkaido/${place.id}/`} style={`left:${place.x};top:${place.y}`}><i></i><strong>{place.name}</strong><small>{place.en}</small><em>{place.liveCount>0?`${place.liveCount} LIVE`:`${place.registeredCount} CHECK`}</em></a>)}</div><div class="legend"><span><i class="liveDot"></i> LIVE NODE</span><span><i class="checkDot"></i> CHECK NODE</span><span class="muted">HOKKAIDO NETWORK // ONLINE</span></div></section></main></Layout>
<style>.shell{min-height:100vh;padding:0 4vw 4rem}header{height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid var(--line)}header a{text-decoration:none;color:var(--sub);font-size:.62rem;letter-spacing:.12em}header a:last-child{text-align:right}.brand{font-weight:700;color:var(--cyan)!important;letter-spacing:.2em;text-shadow:0 0 12px #4ee3ff88}.title{padding:5vh 0 1.6rem;display:flex;justify-content:space-between;align-items:end}.title p{font-size:.58rem;letter-spacing:.2em;color:var(--sub)}.title h1{font-size:clamp(2.3rem,5vw,5rem);font-weight:500;letter-spacing:.06em;margin:.3rem 0;text-shadow:0 0 22px #4ee3ff22}.title span{font-size:.55rem;letter-spacing:.18em;color:var(--sub)}.summary{font-size:.58rem;letter-spacing:.13em;color:var(--sub)}.summary b{font-size:1.1rem;color:var(--cyan)}.summary i{display:inline-block;width:1px;height:14px;background:var(--line);margin:0 .8rem;vertical-align:middle}.stage{max-width:1050px;margin:auto}.island{position:relative;aspect-ratio:1.65;background:radial-gradient(circle at 50% 50%,#4ee3ff0d,transparent 60%);clip-path:polygon(8% 35%,19% 22%,35% 23%,44% 5%,58% 10%,67% 25%,89% 27%,97% 42%,88% 55%,72% 57%,67% 75%,49% 70%,38% 87%,23% 83%,19% 64%,4% 58%);border:1px solid var(--line);box-shadow:inset 0 0 70px #4ee3ff12;background-color:#07101a}.island::after{content:"";position:absolute;inset:0;background-image:linear-gradient(#4ee3ff0c 1px,transparent 1px),linear-gradient(90deg,#4ee3ff0c 1px,transparent 1px);background-size:28px 28px;pointer-events:none}.place{z-index:2;position:absolute;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;color:var(--sub);text-align:center;text-decoration:none;transition:.18s}.place i{width:10px;height:10px;border:1px solid var(--sub);border-radius:50%;background:#05070d;margin-bottom:.35rem}.place strong{font-size:.72rem}.place small{font-size:.43rem;letter-spacing:.11em}.place em{font-size:.4rem;font-style:normal;letter-spacing:.08em;margin-top:.22rem}.place.live{color:var(--cyan)}.place.live i{width:13px;height:13px;background:var(--cyan);border-color:var(--cyan);box-shadow:0 0 8px var(--cyan),0 0 0 6px #4ee3ff16}.place:hover{transform:translate(-50%,-50%) scale(1.16);text-shadow:0 0 8px var(--cyan)}.legend{display:flex;gap:1.4rem;flex-wrap:wrap;padding:1rem 0;color:var(--sub);font-size:.52rem;letter-spacing:.1em}.legend i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:.35rem}.liveDot{background:var(--cyan);box-shadow:0 0 7px var(--cyan)}.checkDot{border:1px solid var(--sub)}.muted{margin-left:auto}@media(max-width:700px){.shell{padding:0 1rem 3rem}header{height:64px}.brand{font-size:.65rem}.title{padding-top:2.8rem;display:block}.summary{margin-top:1rem}.island{aspect-ratio:1.05}.place small{display:none}.place strong{font-size:.62rem}.place em{font-size:.36rem}.muted{margin-left:0}}</style>