---
import Layout from '../../../../layouts/Layout.astro';
import CityHeader from '../../../../components/CityHeader.astro';
import CityWindowNodes from '../../../../components/CityWindowNodes.astro';
import cameras from '../../../../data/cameras.json';
const sapporoCameras = cameras.filter((c) => c.city.startsWith('札幌市') && c.status === 'live' && c.embedEnabled === true);
const liveCount=sapporoCameras.length;
---
<Layout title="札幌の今 | IMARIUM">
  <main class="shell">
    <CityHeader cityName="札幌" cityEn="SAPPORO" liveCount={liveCount} registeredCount={sapporoCameras.length}/>
    <CityWindowNodes windows={sapporoCameras} cityName="札幌"/>
    <footer><span>{sapporoCameras.length} VERIFIED LIVE WINDOWS</span><span>SELECT WINDOW → OPEN → LIVE</span></footer>
  </main>
</Layout>
<style>
.shell{min-height:100vh;padding:0 4vw 3rem}footer{display:flex;justify-content:space-between;padding-top:1rem;color:var(--sub);font-size:.55rem;letter-spacing:.14em}@media(max-width:700px){.shell{padding:0 1rem 2rem}footer span:last-child{display:none}}
</style>