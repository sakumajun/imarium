---
import Layout from '../../../../layouts/Layout.astro';
const windows = [
  {id:'preview-sapporo-station',name:'札幌駅',en:'SAPPORO STATION',x:'50%',y:'22%'},
  {id:'preview-odori',name:'大通',en:'ODORI',x:'54%',y:'45%'},
  {id:'preview-susukino',name:'すすきの',en:'SUSUKINO',x:'57%',y:'62%'},
  {id:'preview-moiwa',name:'藻岩山',en:'MT. MOIWA',x:'28%',y:'72%'}
];
---
<Layout title="札幌の今 | IMARIUM">
  <main class="shell">
    <header><a href="/explore/hokkaido/">← HOKKAIDO</a><a class="brand" href="/">IMARIUM</a></header>
    <section class="heading"><p>HOKKAIDO / SAPPORO</p><h1>札幌の「今」</h1><span>窓を選ぶと、その場所の現在につながります。</span></section>
    <section class="city-map">
      <div class="river"></div><div class="road r1"></div><div class="road r2"></div><div class="road r3"></div>
      {windows.map((w) => <button class="window" style={`left:${w.x};top:${w.y}`} data-name={w.name} data-en={w.en} aria-label={`${w.name}の窓を開く`}><span class="window-icon"><i></i><i></i><i></i><i></i></span><strong>{w.name}</strong><small>{w.en}</small></button>)}
      <div class="preview" id="preview" hidden><button class="close" aria-label="閉じる">×</button><div class="screen"><span>LIVE PREVIEW</span><b>● LIVE</b></div><div class="meta"><p id="previewName"></p><small id="previewEn"></small><div><button class="favorite">♡</button><button class="open" disabled>OPEN →</button></div><em>実カメラ登録後にOPENが有効になります</em></div></div>
    </section>
    <footer><span>4 WINDOWS</span><span>ZOOM → FIND → OPEN → LIVE</span></footer>
  </main>
  <script>
    const preview = document.querySelector('#preview');
    const name = document.querySelector('#previewName');
    const en = document.querySelector('#previewEn');
    document.querySelectorAll('.window').forEach((button) => button.addEventListener('click', () => {
      name.textContent = button.dataset.name;
      en.textContent = button.dataset.en;
      preview.hidden = false;
    }));
    document.querySelector('.close')?.addEventListener('click', () => { preview.hidden = true; });
  </script>
</Layout>
<style>
  .shell{min-height:100vh;padding:0 4vw 3rem;background:#111;color:#f4f4f1}header{height:80px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #303030}header a{text-decoration:none;color:#aaa;font-size:.72rem;letter-spacing:.12em}.brand{color:#fff!important;font-weight:700}.heading{padding:5vh 0 2rem}.heading p{font-size:.65rem;letter-spacing:.2em;color:#777}.heading h1{font-size:clamp(2.8rem,6vw,5.5rem);font-weight:400;letter-spacing:-.05em;margin:.4rem 0}.heading span{color:#888}.city-map{position:relative;min-height:58vh;overflow:hidden;border:1px solid #292929;background:radial-gradient(circle at 52% 45%,#242424,#151515 55%,#0d0d0d)}.road{position:absolute;height:1px;background:#333;width:120%;left:-10%;transform-origin:center}.r1{top:35%;transform:rotate(5deg)}.r2{top:57%;transform:rotate(-8deg)}.r3{top:76%;transform:rotate(2deg)}.river{position:absolute;width:18%;height:130%;left:67%;top:-15%;border-left:1px solid #29353a;border-right:1px solid #29353a;transform:rotate(12deg)}.window{position:absolute;transform:translate(-50%,-50%);border:0;background:transparent;color:#eee;display:flex;flex-direction:column;align-items:center;cursor:pointer}.window-icon{width:38px;height:38px;border:1px solid #888;display:grid;grid-template-columns:1fr 1fr;gap:2px;padding:5px;margin-bottom:.5rem;transition:.25s}.window-icon i{background:#666}.window strong{font-size:.78rem}.window small{font-size:.48rem;letter-spacing:.12em;color:#777}.window:hover .window-icon{transform:scale(1.15);border-color:#fff;box-shadow:0 0 30px rgba(255,255,255,.16)}.preview{position:absolute;right:3%;bottom:4%;width:min(360px,90%);background:rgba(20,20,20,.96);border:1px solid #444;box-shadow:0 25px 70px #000;padding:.7rem}.preview[hidden]{display:none}.close{position:absolute;right:.9rem;top:.8rem;z-index:2;border:0;background:#222;color:#fff;border-radius:50%;width:28px;height:28px}.screen{aspect-ratio:16/9;background:linear-gradient(135deg,#292929,#090909);display:grid;place-content:center;text-align:center;color:#888}.screen span{font-size:.65rem;letter-spacing:.18em}.screen b{font-size:.58rem;color:#bbb;margin-top:.4rem}.meta{padding:1rem}.meta p{margin:0;font-size:1.2rem}.meta small{color:#777;letter-spacing:.12em}.meta div{display:flex;gap:.5rem;margin-top:1rem}.meta button{border:1px solid #555;background:#191919;color:#ddd;padding:.65rem .9rem}.meta .open{flex:1}.meta em{display:block;margin-top:.7rem;color:#666;font-size:.6rem;font-style:normal}footer{display:flex;justify-content:space-between;padding-top:1rem;color:#666;font-size:.6rem;letter-spacing:.14em}@media(max-width:700px){.shell{padding:0 1rem 2rem}.heading{padding-top:3rem}.city-map{min-height:62vh}.preview{left:5%;right:5%;bottom:3%;width:auto}.window-icon{width:32px;height:32px}footer span:last-child{display:none}}
</style>
