---
import Layout from '../../../../layouts/Layout.astro';
import CityHeader from '../../../../components/CityHeader.astro';
import CityWindowNodes from '../../../../components/CityWindowNodes.astro';
import cameras from '../../../../data/cameras.json';
const sapporoCameras = cameras.filter((c) => c.city.startsWith('札幌市'));
const positions: Record<string, [string, string]> = { 'IM-0001':['54%','45%'], 'IM-0002':['28%','72%'], 'IM-0003':['72%','24%'] };
const windows = sapporoCameras.map((camera, index) => ({...camera,x:positions[camera.cameraId]?.[0] ?? `${42+(index%3)*12}%`,y:positions[camera.cameraId]?.[1] ?? `${30+Math.floor(index/3)*18}%`}));
const liveCount=windows.filter(w=>w.status==='live'&&w.embedEnabled!==false).length;
---
<Layout title="札幌の今 | IMARIUM"><main class="shell"><CityHeader cityName="札幌" cityEn="SAPPORO" liveCount={liveCount} registeredCount={windows.length}/><section class="city-map" aria-label="札幌のWINDOWマップ"><div class="gridLayer"></div><div class="river"></div><div class="road r1"></div><div class="road r2"></div><div class="road r3"></div>{windows.map(w=><button class:list={['window',{live:w.status==='live'}]} style={`left:${w.x};top:${w.y}`} data-camera-id={w.cameraId} data-name={w.name} data-en={w.nameEn} data-video-id={w.videoId} data-status={w.status} aria-label={`${w.name} ${w.status==='live'?'LIVE':'CHECK'}`}><span class="window-icon"><i></i><i></i><i></i><i></i></span><strong>{w.name}</strong><small>{w.nameEn}</small><b>{w.status==='live'?'● LIVE':'○ CHECK'}</b></button>)}<div class="preview" id="preview" hidden><button class="close" aria-label="プレビューを閉じる">×</button><div class="screen" id="screen"><span>SELECT A WINDOW</span></div><div class="meta"><p id="previewName"></p><small id="previewEn"></small><div><button id="previewFavorite" aria-label="お気に入りに追加または削除">♡</button><a id="previewOpen" href="#">OPEN →</a></div><em id="previewNote"></em></div></div></section><CityWindowNodes windows={windows} cityName="札幌"/><footer><span>{windows.length} REGISTERED WINDOWS</span><span>FIND → PREVIEW → OPEN → LIVE</span></footer></main>
<script>
// @ts-nocheck
const preview=document.querySelector('#preview'),screen=document.querySelector('#screen'),name=document.querySelector('#previewName'),en=document.querySelector('#previewEn'),open=document.querySelector('#previewOpen'),note=document.querySelector('#previewNote'),favorite=document.querySelector('#previewFavorite');let activeId='';const key='imarium:favorites';const favs=()=>{try{const v=JSON.parse(localStorage.getItem(key)||'[]');return Array.isArray(v)?v:[]}catch{return[]}};const paint=()=>{if(favorite)favorite.textContent=favs().includes(activeId)?'♥':'♡'};const show=button=>{activeId=button.dataset.cameraId||'';if(!activeId)return;name.textContent=button.dataset.name||'';en.textContent=button.dataset.en||'';open.href=`/live/${activeId}/`;const live=button.dataset.status==='live';screen.innerHTML=live?`<iframe src="https://www.youtube-nocookie.com/embed/${button.dataset.videoId}?autoplay=1&mute=1&playsinline=1&rel=0" title="${button.dataset.name}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`:`<span>WINDOW HEALTH CHECK</span>`;note.textContent=live?'現在LIVEとして確認されているWINDOWです。':'登録済み。WINDOW HEALTHで状態を確認しています。';preview.hidden=false;paint()};document.querySelectorAll('.window').forEach(button=>button.addEventListener('click',()=>show(button)));favorite?.addEventListener('click',()=>{if(!activeId)return;const f=favs();localStorage.setItem(key,JSON.stringify(f.includes(activeId)?f.filter(x=>x!==activeId):[...f,activeId]));paint()});document.querySelector('.close')?.addEventListener('click',()=>preview.hidden=true);
</script></Layout>
<style>.shell{min-height:100vh;padding:0 4vw 3rem}.city-map{position:relative;min-height:58vh;overflow:hidden;border:1px solid var(--line);background:radial-gradient(circle at 52% 45%,#4ee3ff0c,transparent 58%);box-shadow:inset 0 0 60px #4ee3ff0a}.gridLayer{position:absolute;inset:0;background-image:linear-gradient(#4ee3ff0a 1px,transparent 1px),linear-gradient(90deg,#4ee3ff0a 1px,transparent 1px);background-size:28px 28px}.road{position:absolute;height:1px;background:#4ee3ff18;width:120%;left:-10%}.r1{top:35%;transform:rotate(5deg)}.r2{top:57%;transform:rotate(-8deg)}.r3{top:76%;transform:rotate(2deg)}.river{position:absolute;width:18%;height:130%;left:67%;top:-15%;border-left:1px solid #4ee3ff1f;border-right:1px solid #4ee3ff1f;transform:rotate(12deg)}.window{position:absolute;transform:translate(-50%,-50%);border:0;background:transparent;color:#60757c;display:flex;flex-direction:column;align-items:center;cursor:pointer;max-width:180px}.window.live{color:var(--cyan)}.window-icon{width:38px;height:38px;border:1px solid #496a74;display:grid;grid-template-columns:1fr 1fr;gap:2px;padding:5px;margin-bottom:.5rem;transition:.2s;background:#05090ecc}.window-icon i{background:#496a74}.live .window-icon{border-color:var(--cyan);box-shadow:0 0 18px #4ee3ff44}.live .window-icon i{background:var(--cyan)}.window:hover .window-icon,.window:focus-visible .window-icon{transform:scale(1.12);border-color:var(--cyan);box-shadow:0 0 18px #4ee3ff55}.window:focus-visible{outline:none}.window strong{font-size:.75rem}.window small{font-size:.46rem;letter-spacing:.1em;color:var(--sub)}.window b{font-size:.45rem;margin-top:.3rem}.preview{position:absolute;right:3%;bottom:4%;width:min(400px,92%);background:#050912f7;border:1px solid var(--cyan);box-shadow:0 0 35px #4ee3ff22;padding:.7rem;z-index:3}.preview[hidden]{display:none}.close{position:absolute;right:.9rem;top:.8rem;z-index:4;background:#05070ddd;color:var(--cyan);border:1px solid var(--line);width:36px;height:36px}.screen{aspect-ratio:16/9;background:#020409;display:grid;place-content:center;color:var(--sub)}.screen iframe{width:100%;height:100%;border:0}.meta{padding:1rem}.meta p{margin:0;font-size:1.05rem;color:var(--text)}.meta small,.meta em{color:var(--sub)}.meta div{display:flex;gap:.5rem;margin-top:1rem}.meta button,.meta a{border:1px solid var(--line);background:#05070d;color:var(--cyan);padding:.75rem .95rem;text-decoration:none;min-height:44px}.meta button:hover,.meta a:hover{border-color:var(--cyan);background:#4ee3ff10}.meta a{flex:1;text-align:center}.meta em{display:block;margin-top:.7rem;font-size:.65rem;font-style:normal}footer{display:flex;justify-content:space-between;padding-top:1rem;color:var(--sub);font-size:.55rem;letter-spacing:.14em}@media(max-width:700px){.shell{padding:0 1rem 2rem}.city-map{display:none}footer span:last-child{display:none}}</style>