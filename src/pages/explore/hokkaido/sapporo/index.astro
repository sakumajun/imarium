---
import Layout from '../../../../layouts/Layout.astro';
import cameras from '../../../../data/cameras.json';
const sapporoCameras = cameras.filter((c) => c.city.startsWith('札幌市'));
const positions: Record<string, [string, string]> = { 'IM-0001':['54%','45%'], 'IM-0002':['28%','72%'], 'IM-0003':['72%','24%'] };
const windows = sapporoCameras.map((camera, index) => ({...camera,x:positions[camera.cameraId]?.[0] ?? `${42+(index%3)*12}%`,y:positions[camera.cameraId]?.[1] ?? `${30+Math.floor(index/3)*18}%`}));
---
<Layout title="札幌の今 | IMARIUM"><main class="shell"><header><a href="/explore/hokkaido/">← HOKKAIDO</a><a class="brand" href="/">IMARIUM</a></header><section class="heading"><p>HOKKAIDO / SAPPORO</p><h1>札幌の「今」</h1><span>WINDOW HEALTHで確認しているライブカメラから選べます。</span></section><section class="city-map"><div class="river"></div><div class="road r1"></div><div class="road r2"></div><div class="road r3"></div>{windows.map(w=><button class:list={['window',{live:w.status==='live'}]} style={`left:${w.x};top:${w.y}`} data-camera-id={w.cameraId} data-name={w.name} data-en={w.nameEn} data-video-id={w.videoId} data-status={w.status}><span class="window-icon"><i></i><i></i><i></i><i></i></span><strong>{w.name}</strong><small>{w.nameEn}</small><b>{w.status==='live'?'● LIVE':'○ CHECK'}</b></button>)}<div class="preview" id="preview" hidden><button class="close">×</button><div class="screen" id="screen"><span>SELECT A WINDOW</span></div><div class="meta"><p id="previewName"></p><small id="previewEn"></small><div><button id="previewFavorite">♡</button><a id="previewOpen" href="#">OPEN →</a></div><em id="previewNote"></em></div></div></section><footer><span>{windows.length} REGISTERED WINDOWS</span><span>FIND → PREVIEW → OPEN → LIVE</span></footer></main>
<script>
// @ts-nocheck
const preview=document.querySelector('#preview'),screen=document.querySelector('#screen'),name=document.querySelector('#previewName'),en=document.querySelector('#previewEn'),open=document.querySelector('#previewOpen'),note=document.querySelector('#previewNote'),favorite=document.querySelector('#previewFavorite');let activeId='';const key='imarium:favorites';const favs=()=>{try{return JSON.parse(localStorage.getItem(key)||'[]')}catch{return[]}};const paint=()=>favorite.textContent=favs().includes(activeId)?'♥':'♡';document.querySelectorAll('.window').forEach(button=>button.addEventListener('click',()=>{activeId=button.dataset.cameraId;name.textContent=button.dataset.name;en.textContent=button.dataset.en;open.href=`/live/${activeId}/`;const live=button.dataset.status==='live';screen.innerHTML=live?`<iframe src="https://www.youtube.com/embed/${button.dataset.videoId}?autoplay=1&mute=1&playsinline=1" title="${button.dataset.name}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`:`<span>WINDOW HEALTH CHECK</span>`;note.textContent=live?'現在LIVEとして確認されているWINDOWです。':'登録済み。次回WINDOW HEALTHで状態を確認します。';preview.hidden=false;paint()}));favorite.addEventListener('click',()=>{const f=favs();localStorage.setItem(key,JSON.stringify(f.includes(activeId)?f.filter(x=>x!==activeId):[...f,activeId]));paint()});document.querySelector('.close').addEventListener('click',()=>preview.hidden=true);
</script></Layout>
<style>.shell{min-height:100vh;padding:0 4vw 3rem;background:#111;color:#f4f4f1}header{height:80px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #303030}header a{text-decoration:none;color:#aaa;font-size:.72rem;letter-spacing:.12em}.brand{color:#fff!important;font-weight:700}.heading{padding:5vh 0 2rem}.heading p{font-size:.65rem;letter-spacing:.2em;color:#777}.heading h1{font-size:clamp(2.8rem,6vw,5.5rem);font-weight:400;letter-spacing:-.05em;margin:.4rem 0}.heading span{color:#888}.city-map{position:relative;min-height:58vh;overflow:hidden;border:1px solid #292929;background:radial-gradient(circle at 52% 45%,#242424,#151515 55%,#0d0d0d)}.road{position:absolute;height:1px;background:#333;width:120%;left:-10%}.r1{top:35%;transform:rotate(5deg)}.r2{top:57%;transform:rotate(-8deg)}.r3{top:76%;transform:rotate(2deg)}.river{position:absolute;width:18%;height:130%;left:67%;top:-15%;border-left:1px solid #29353a;border-right:1px solid #29353a;transform:rotate(12deg)}.window{position:absolute;transform:translate(-50%,-50%);border:0;background:transparent;color:#888;display:flex;flex-direction:column;align-items:center;cursor:pointer;max-width:180px}.window.live{color:#eee}.window-icon{width:38px;height:38px;border:1px solid #666;display:grid;grid-template-columns:1fr 1fr;gap:2px;padding:5px;margin-bottom:.5rem;transition:.25s}.window-icon i{background:#555}.live .window-icon{border-color:#aaa;box-shadow:0 0 24px #fff2}.live .window-icon i{background:#aaa}.window:hover .window-icon{transform:scale(1.15);border-color:#fff}.window strong{font-size:.75rem}.window small{font-size:.46rem;letter-spacing:.1em;color:#777}.window b{font-size:.45rem;margin-top:.3rem;color:#aaa}.preview{position:absolute;right:3%;bottom:4%;width:min(400px,92%);background:#141414fa;border:1px solid #444;box-shadow:0 25px 70px #000;padding:.7rem;z-index:3}.preview[hidden]{display:none}.close{position:absolute;right:.9rem;top:.8rem;z-index:4;border:0;background:#222;color:#fff;border-radius:50%;width:28px;height:28px}.screen{aspect-ratio:16/9;background:#090909;display:grid;place-content:center;color:#777}.screen iframe{width:100%;height:100%;border:0}.meta{padding:1rem}.meta p{margin:0;font-size:1.15rem}.meta small{color:#777}.meta div{display:flex;gap:.5rem;margin-top:1rem}.meta button,.meta a{border:1px solid #555;background:#191919;color:#ddd;padding:.65rem .9rem;text-decoration:none}.meta a{flex:1;text-align:center}.meta em{display:block;margin-top:.7rem;color:#666;font-size:.6rem;font-style:normal}footer{display:flex;justify-content:space-between;padding-top:1rem;color:#666;font-size:.6rem;letter-spacing:.14em}@media(max-width:700px){.shell{padding:0 1rem 2rem}.heading{padding-top:3rem}.city-map{min-height:68vh}.preview{left:4%;right:4%;bottom:3%;width:auto}.window-icon{width:32px;height:32px}.window strong{font-size:.65rem}footer span:last-child{display:none}}</style>