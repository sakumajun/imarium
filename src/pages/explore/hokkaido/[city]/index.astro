---
import Layout from '../../../../layouts/Layout.astro';
import CityHeader from '../../../../components/CityHeader.astro';
import CityWindowNodes from '../../../../components/CityWindowNodes.astro';
import cameras from '../../../../data/cameras.json';
export function getStaticPaths(){const cityDefinitions={hakodate:{name:'函館',en:'HAKODATE',match:['函館市']},otaru:{name:'小樽',en:'OTARU',match:['小樽市']},asahikawa:{name:'旭川',en:'ASAHIKAWA',match:['旭川市']},chitose:{name:'新千歳',en:'NEW CHITOSE',match:['千歳市']},wakkanai:{name:'稚内',en:'WAKKANAI',match:['稚内市']},furano:{name:'富良野',en:'FURANO',match:['富良野市']},niseko:{name:'ニセコ',en:'NISEKO',match:['ニセコ町','倶知安町']},obihiro:{name:'帯広',en:'OBIHIRO',match:['帯広市']},kushiro:{name:'釧路',en:'KUSHIRO',match:['釧路市']}};return Object.entries(cityDefinitions).filter(([,city])=>cameras.some(c=>city.match.includes(c.city)&&c.status==='live'&&c.embedEnabled===true)).map(([city,data])=>({params:{city},props:{cityData:data}}));}
const {cityData}=Astro.props;
const cityCameras=cameras.filter(c=>cityData.match.includes(c.city)&&c.status==='live'&&c.embedEnabled===true);
const liveCount=cityCameras.length;
---
<Layout title={`${cityData.name}の今 | IMARIUM`}>
  <main class="shell">
    <CityHeader cityName={cityData.name} cityEn={cityData.en} liveCount={liveCount} registeredCount={cityCameras.length}/>
    <CityWindowNodes windows={cityCameras} cityName={cityData.name}/>
    <footer><span>{cityCameras.length} VERIFIED LIVE WINDOWS</span><span>SELECT WINDOW → OPEN → LIVE</span></footer>
  </main>
</Layout>
<style>
.shell{min-height:100vh;padding:0 4vw 3rem}footer{display:flex;justify-content:space-between;padding-top:1rem;color:var(--sub);font-size:.55rem;letter-spacing:.14em}@media(max-width:700px){.shell{padding:0 1rem 2rem}footer span:last-child{display:none}}
</style>