---
import Layout from '../../../../layouts/Layout.astro';
import cameras from '../../../../data/cameras.json';
export function getStaticPaths(){const cityDefinitions={hakodate:{name:'函館',en:'HAKODATE',match:['函館市']},otaru:{name:'小樽',en:'OTARU',match:['小樽市']},asahikawa:{name:'旭川',en:'ASAHIKAWA',match:['旭川市']},chitose:{name:'新千歳',en:'NEW CHITOSE',match:['千歳市']},wakkanai:{name:'稚内',en:'WAKKANAI',match:['稚内市']},furano:{name:'富良野',en:'FURANO',match:['富良野市']},niseko:{name:'ニセコ',en:'NISEKO',match:['ニセコ町','倶知安町']},obihiro:{name:'帯広',en:'OBIHIRO',match:['帯広市']},kushiro:{name:'釧路',en:'KUSHIRO',match:['釧路市']}};return Object.entries(cityDefinitions).filter(([,city])=>cameras.some(c=>city.match.includes(c.city))).map(([city,data])=>({params:{city},props:{cityData:data}}));}const {cityData}=Astro.props;const cityCameras=cameras.filter(c=>cityData.match.includes(c.city));const liveCount=cityCameras.filter(c=>c.status==='live'&&c.embedEnabled!==false).length;
---
<Layout title={`${cityData.name}の今 | IMARIUM`}><main class="shell"><header><a href="/explore/hokkaido/">← HOKKAIDO</a><a class="brand" href="/">IMARIUM // LIVE GRID</a><nav><a href="/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></nav></header><section class="heading"><div><p>01.02 // HOKKAIDO / {cityData.en}</p><h1>{cityData.name}の「今」</h1><span>WINDOW HEALTHで確認しているライブカメラから選べます。</span></div><div class="count"><b>{liveCount}</b> LIVE <i></i><b>{cityCameras.length}</b> REGISTERED</div></section><section class="grid">{cityCameras.map(c=><article class:list={['card',{live:c.status==='live'&&c.embedEnabled!==false}]}><div class="screen">{c.status==='live'&&c.embedEnabled!==false?<iframe src={`https://www.youtube-nocookie.com/embed/${c.videoId}?mute=1&playsinline=1&rel=0`} title={c.name} loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>:<div class="checking">WINDOW HEALTH<br/><small>{c.healthReason??c.status}</small></div>}<b>{c.status==='live'?'● LIVE':'○ CHECK'}</b></div><div class="meta"><div><small>{c.cameraId} // {c.area}</small><h2>{c.name}</h2><p>{c.nameEn}</p></div><div class="actions"><button class="fav" data-id={c.cameraId}>♡</button><a href={`/live/${c.cameraId}/`}>OPEN →</a></div></div></article>)}</section><section class="window-nodes" aria-label={`${cityData.name}のWINDOW一覧`}><p>WINDOW NODES</p>{cityCameras.map(c=><a class:list={['node',{live:c.status==='live'&&c.embedEnabled!==false}]} href={`/live/${c.cameraId}/`}><span><strong>{c.name}</strong><small>{c.nameEn}</small></span><b>{c.status==='live'&&c.embedEnabled!==false?'● LIVE':'○ CHECK'}</b></a>)}</section><footer><span>{cityCameras.length} REGISTERED WINDOWS</span><span>FIND → PREVIEW → OPEN → LIVE</span></footer></main><script>
// @ts-nocheck
const key='imarium:favorites';const read=()=>{try{return JSON.parse(localStorage.getItem(key)||'[]')}catch{return[]}};document.querySelectorAll('.fav').forEach(btn=>{const id=btn.dataset.id;const paint=()=>btn.textContent=read().includes(id)?'♥':'♡';paint();btn.addEventListener('click',()=>{const f=read();localStorage.setItem(key,JSON.stringify(f.includes(id)?f.filter(x=>x!==id):[...f,id]));paint()})});
</script></Layout>
<style>.shell{min-height:100vh;padding:0 4vw 3rem}header{height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid var(--line)}header>a:first-child{color:var(--sub);text-decoration:none;font-size:.6rem;letter-spacing:.12em}.brand{color:var(--cyan)!important;font-size:.78rem;font-weight:700;letter-spacing:.2em;text-decoration:none;text-shadow:0 0 12px #4ee3ff88}nav{display:flex;justify-content:flex-end;gap:1.1rem}nav a{font-size:.55rem;letter-spacing:.1em;color:var(--sub);text-decoration:none}.heading{padding:5vh 0 1.6rem;display:flex;justify-content:space-between;align-items:end}.heading p{font-size:.58rem;letter-spacing:.2em;color:var(--sub)}.heading h1{font-size:clamp(2.1rem,5vw,4.5rem);font-weight:500;letter-spacing:.02em;margin:.35rem 0;text-shadow:0 0 20px #4ee3ff22}.heading span{color:var(--sub);font-size:.7rem}.count{font-size:.55rem;letter-spacing:.12em;color:var(--sub)}.count b{font-size:1.05rem;color:var(--cyan)}.count i{display:inline-block;width:1px;height:13px;background:var(--line);margin:0 .7rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:10px}.card{position:relative;background:#050912cc;border:1px solid var(--line);padding:7px;box-shadow:0 0 15px #4ee3ff0b;transition:.18s}.card::before{content:"";position:absolute;left:-1px;top:-1px;width:28px;height:1px;background:#496a74}.card.live::before{background:var(--cyan);box-shadow:0 0 8px var(--cyan)}.card:hover{border-color:#4ee3ff88;box-shadow:0 0 20px #4ee3ff20}.screen{position:relative;aspect-ratio:16/9;background:#020409;color:var(--sub);display:grid;place-items:center;overflow:hidden}.screen iframe{width:100%;height:100%;border:0}.screen>b{position:absolute;z-index:2;top:.6rem;left:.6rem;background:#05070ddd;border:1px solid var(--line);color:#60757c;padding:.3rem .45rem;font-size:.48rem;letter-spacing:.1em}.live .screen>b{color:var(--cyan);border-color:#4ee3ff66}.checking{text-align:center;font-size:.62rem;letter-spacing:.13em;color:#60757c}.checking small{letter-spacing:.04em;color:var(--sub)}.meta{display:flex;justify-content:space-between;gap:1rem;padding:.85rem .2rem .2rem}.meta small{color:var(--sub);font-size:.5rem;letter-spacing:.08em}.meta h2{font-size:.9rem;font-weight:500;margin:.25rem 0;color:var(--text)}.meta p{font-size:.55rem;color:var(--sub);margin:0;letter-spacing:.07em}.actions{display:flex;align-items:end;gap:.4rem}.actions button,.actions a{border:1px solid var(--line);background:#05070d;color:var(--cyan);padding:.6rem .7rem;text-decoration:none;font-size:.55rem}.actions button:hover,.actions a:hover{border-color:var(--cyan);background:#4ee3ff10}.window-nodes{display:grid;gap:.5rem;margin-top:1rem}.window-nodes>p{font-size:.55rem;letter-spacing:.16em;color:var(--sub);margin:.5rem 0}.node{width:100%;min-height:58px;box-sizing:border-box;border:1px solid var(--line);background:#050912cc;color:#60757c;padding:.75rem;display:flex;align-items:center;justify-content:space-between;text-align:left;text-decoration:none;transition:.18s}.node.live{color:var(--cyan);border-color:#4ee3ff55}.node:hover,.node:focus-visible{border-color:var(--cyan);background:#4ee3ff0b;box-shadow:0 0 15px #4ee3ff16;outline:none}.node strong,.node small{display:block}.node strong{font-size:.8rem}.node small{margin-top:.2rem;color:var(--sub);font-size:.52rem;letter-spacing:.08em}.node b{font-size:.5rem}footer{display:flex;justify-content:space-between;padding-top:1rem;color:var(--sub);font-size:.55rem;letter-spacing:.14em}@media(max-width:700px){.shell{padding:0 1rem 2rem}header{height:64px;grid-template-columns:1fr auto}.brand{font-size:.62rem}header nav{display:none}.heading{padding-top:2.5rem;display:block}.count{margin-top:1rem}.grid{grid-template-columns:1fr}.meta{display:block}.actions{margin-top:.8rem}.node{min-height:58px}footer span:last-child{display:none}}</style>