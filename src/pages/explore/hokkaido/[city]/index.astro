---
import Layout from '../../../../layouts/Layout.astro';
import CityHeader from '../../../../components/CityHeader.astro';
import CityWindowNodes from '../../../../components/CityWindowNodes.astro';
import cameras from '../../../../data/cameras.json';
export function getStaticPaths(){const cityDefinitions={sapporo:{name:'札幌',en:'SAPPORO',match:['札幌市','札幌市ほか']},kitahiroshima:{name:'北広島',en:'KITAHIROSHIMA',match:['北広島市']},iwamizawa:{name:'岩見沢',en:'IWAMIZAWA',match:['岩見沢市']},okushiri:{name:'奥尻',en:'OKUSHIRI',match:['奥尻町']},setana:{name:'せたな',en:'SETANA',match:['せたな町']},shihoro:{name:'士幌',en:'SHIHORO',match:['士幌町']},niikappu:{name:'新冠',en:'NIIKAPPU',match:['新冠町']},hamanaka:{name:'浜中',en:'HAMANAKA',match:['浜中町']},hokuto:{name:'北斗',en:'HOKUTO',match:['北斗市']},hakodate:{name:'函館',en:'HAKODATE',match:['函館市']},otaru:{name:'小樽',en:'OTARU',match:['小樽市']},asahikawa:{name:'旭川',en:'ASAHIKAWA',match:['旭川市']},chitose:{name:'新千歳',en:'NEW CHITOSE',match:['千歳市']},wakkanai:{name:'稚内',en:'WAKKANAI',match:['稚内市']},furano:{name:'富良野',en:'FURANO',match:['富良野市']},niseko:{name:'ニセコ',en:'NISEKO',match:['ニセコ町','倶知安町']},obihiro:{name:'帯広',en:'OBIHIRO',match:['帯広市']},kushiro:{name:'釧路',en:'KUSHIRO',match:['釧路市']}};return Object.entries(cityDefinitions).filter(([,city])=>cameras.some(c=>city.match.includes(c.city))).map(([city,data])=>({params:{city},props:{cityData:data}}));}
const {cityData}=Astro.props;
const registeredCameras=cameras.filter(c=>cityData.match.includes(c.city));
const cityCameras=registeredCameras.filter(c=>c.status==='live'&&c.embedEnabled===true);
const liveCount=cityCameras.length;
const coordinates: Record<string,[number,number]>={"sapporo":[43.0618,141.3545],"asahikawa":[43.7706,142.365],"hakodate":[41.7687,140.7288],"otaru":[43.1907,140.9947],"wakkanai":[45.4157,141.6731],"kushiro":[42.9849,144.3818],"obihiro":[42.9236,143.196],"chitose":[42.7752,141.6923],"kitahiroshima":[42.9854,141.5632]};const [latitude,longitude]=coordinates[String(Astro.params.city||"")]||[43.1,142.0];

---
<Layout title={`${cityData.name}の今 | IMARIUM`}>
<main class="shell"><CityHeader cityName={cityData.name} cityEn={cityData.en} liveCount={liveCount} registeredCount={registeredCameras.length}/>
<section class="summary"><h1>{cityData.name}の今</h1><p>天気・時刻・地域情報・交通情報・ライブカメラをひとつのページに。</p><div class="clock" id="cityClock">--:--:--</div></section>
<div class="stats"><article><span>天気</span><strong id="weather">取得中</strong></article><article><span>気温</span><strong id="temperature">-- °C</strong></article><article><span>積雪</span><strong>--</strong><small>データ準備中</small></article><article><span>日の出 / 日の入り</span><strong id="sun">--:-- / --:--</strong></article></div>
<div class="cols"><div class="stack"><section class="panel about"><h2>この街について</h2><p>{cityData.name}の街の様子と、暮らしに役立つ情報をまとめています。</p></section><section class="panel"><h2>エリアマップ</h2><iframe title={cityData.name+'の地図'} loading="lazy" src={`https://www.openstreetmap.org/export/embed.html?bbox=${longitude-0.07}%2C${latitude-0.04}%2C${longitude+0.07}%2C${latitude+0.04}&layer=mapnik&marker=${latitude}%2C${longitude}`}></iframe></section></div><div class="stack"><section class="panel about"><h2>交通情報</h2><p>運行状況は公式サイトでご確認ください。</p><a href="https://www.jrhokkaido.co.jp/" target="_blank" rel="noopener noreferrer">JR北海道 ↗</a></section><section class="panel"><h2>地域情報 <small>SAPPORO＋</small></h2><div class="tabs"><button class="active" data-day="today">今日</button><button data-day="tomorrow">明日</button><button data-day="weekend">今週末</button></div><div class="eventCards"><p>地域記事の連携準備中です。</p></div><a href="https://sapporoplus.jp/" target="_blank" rel="noopener noreferrer">SAPPORO＋で詳しく見る ↗</a></section></div></div>
<section class="panel live"><h2>ライブカメラ <small>{liveCount} CAMERAS</small></h2>{liveCount>0?<div class="camera"><div id="cameraPlayer"><button id="playCamera">▶ 映像を表示</button></div><div><h3 id="cameraTitle">{cityCameras[0].name}</h3><p id="cameraCredit">配信元：{cityCameras[0].channelName}</p><a id="cameraExternal" href={`https://www.youtube.com/watch?v=${cityCameras[0].videoId}`} target="_blank" rel="noopener noreferrer">YouTubeで見る ↗</a><div class="controls"><button id="prevCamera">←</button><span id="cameraIndex">1 / {liveCount}</span><button id="nextCamera">→</button></div></div></div>:<p>現在表示できるライブカメラはありません。</p>}<p class="fine">映像は配信元のYouTube公式プレーヤーを使用します。配信状況により再生できない場合があります。</p></section>
<footer><a href="/explore/hokkaido/">← 北海道マップへ</a></footer></main>
<script define:vars={{cityCameras,latitude,longitude}}>
const clock=document.getElementById('cityClock');function tick(){clock.textContent=new Intl.DateTimeFormat('ja-JP',{timeZone:'Asia/Tokyo',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(new Date())}tick();setInterval(tick,1000);
fetch('https://api.open-meteo.com/v1/forecast?latitude='+latitude+'&longitude='+longitude+'&current=temperature_2m,weather_code&daily=sunrise,sunset&timezone=Asia%2FTokyo&forecast_days=1').then(r=>r.json()).then(d=>{document.getElementById('temperature').textContent=d.current.temperature_2m+' °C';const n=d.current.weather_code;document.getElementById('weather').textContent=n===0?'快晴':n<=3?'晴れ・くもり':n<=48?'霧':n<=67?'雨':n<=77?'雪':n<=82?'にわか雨':n<=86?'にわか雪':'雷雨';document.getElementById('sun').textContent=d.daily.sunrise[0].slice(11)+' / '+d.daily.sunset[0].slice(11)}).catch(()=>document.getElementById('weather').textContent='取得不可');
document.querySelectorAll('[data-day]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-day]').forEach(x=>x.classList.toggle('active',x===b))}));
let i=0;function show(){if(!cityCameras.length)return;const c=cityCameras[i],p=document.getElementById('cameraPlayer');p.replaceChildren();const b=document.createElement('button');b.textContent='▶ 映像を表示';b.onclick=()=>{const f=document.createElement('iframe');f.src='https://www.youtube-nocookie.com/embed/'+encodeURIComponent(c.videoId)+'?autoplay=1';f.title=c.name;f.allow='autoplay; encrypted-media; picture-in-picture';f.allowFullscreen=true;p.replaceChildren(f)};p.append(b);document.getElementById('cameraTitle').textContent=c.name;document.getElementById('cameraCredit').textContent='配信元：'+c.channelName;document.getElementById('cameraExternal').href='https://www.youtube.com/watch?v='+encodeURIComponent(c.videoId);document.getElementById('cameraIndex').textContent=(i+1)+' / '+cityCameras.length}document.getElementById('prevCamera')?.addEventListener('click',()=>{i=(i+cityCameras.length-1)%cityCameras.length;show()});document.getElementById('nextCamera')?.addEventListener('click',()=>{i=(i+1)%cityCameras.length;show()});show();
</script></Layout>
<style>
.shell{max-width:1240px;margin:auto;padding:22px 24px 64px}.summary{padding:35px 0}.summary h1{font-size:clamp(32px,5vw,60px);margin:0 0 12px}.summary p{color:var(--sub)}.clock{font-size:27px;margin-top:18px;font-variant-numeric:tabular-nums}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}.stats article,.panel{border:1px solid var(--line);background:rgba(10,22,32,.85);border-radius:12px;padding:22px}.stats span,.stats small{display:block;color:var(--sub);font-size:12px}.stats strong{display:block;margin:12px 0;font-size:22px}.cols{display:grid;grid-template-columns:1fr 1fr;gap:20px}.stack{display:flex;flex-direction:column;gap:20px}.about{min-height:180px}.panel h2{font-size:19px;margin:0 0 18px}.panel p{color:var(--sub);line-height:1.8;font-size:13px}.panel a{color:var(--cyan);font-size:12px}.panel iframe{width:100%;height:275px;border:0;border-radius:7px}.tabs{display:flex;gap:8px}.tabs button{flex:1;padding:12px;border-radius:7px;cursor:pointer}.tabs button.active{background:var(--cyan);color:#06111b}.eventCards{min-height:205px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;align-items:center;text-align:center}.eventCards p{grid-column:1/-1}.live{margin-top:20px}.camera{display:flex;gap:25px;align-items:center}.camera>div:first-child{width:42%;aspect-ratio:16/9;background:#02080d;display:grid;place-items:center;flex-shrink:0}.camera iframe{width:100%;height:100%;border:0}.camera h3{font-size:17px}.controls{display:flex;gap:12px;align-items:center;margin-top:16px}.controls button{padding:8px 14px;cursor:pointer}.fine{font-size:11px!important}footer{margin-top:35px}footer a{color:var(--cyan)}@media(max-width:760px){.shell{padding:16px}.stats{grid-template-columns:repeat(2,1fr)}.cols{grid-template-columns:1fr}.about{min-height:0}.camera{flex-direction:column;align-items:stretch}.camera>div:first-child{width:100%}}
</style>