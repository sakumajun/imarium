---
import Layout from '../../../../layouts/Layout.astro';
import cameras from '../../../../data/cameras.json';

export function getStaticPaths(){
  const cityDefinitions={hakodate:{name:'函館',en:'HAKODATE',match:['函館市']},otaru:{name:'小樽',en:'OTARU',match:['小樽市']},asahikawa:{name:'旭川',en:'ASAHIKAWA',match:['旭川市']},chitose:{name:'新千歳',en:'NEW CHITOSE',match:['千歳市']},wakkanai:{name:'稚内',en:'WAKKANAI',match:['稚内市']},furano:{name:'富良野',en:'FURANO',match:['富良野市']},niseko:{name:'ニセコ',en:'NISEKO',match:['ニセコ町','倶知安町']},obihiro:{name:'帯広',en:'OBIHIRO',match:['帯広市']},kushiro:{name:'釧路',en:'KUSHIRO',match:['釧路市']}};
  return Object.entries(cityDefinitions).filter(([,city])=>cameras.some(c=>city.match.includes(c.city))).map(([city,data])=>({params:{city},props:{cityData:data}}));
}
const {cityData}=Astro.props;
const cityCameras=cameras.filter(c=>cityData.match.includes(c.city));
const liveCount=cityCameras.filter(c=>c.status==='live'&&c.embedEnabled!==false).length;
---
<Layout title={`${cityData.name}の今 | IMARIUM`}><main class="shell"><header><a href="/explore/hokkaido/">← HOKKAIDO</a><a class="brand" href="/">IMARIUM</a></header><section class="heading"><p>HOKKAIDO / {cityData.en}</p><h1>{cityData.name}の「今」</h1><span>{liveCount} LIVE / {cityCameras.length} REGISTERED WINDOWS</span></section><section class="grid">{cityCameras.map(c=><article class:list={['card',{live:c.status==='live'}]}><div class="screen">{c.status==='live'&&c.embedEnabled!==false?<iframe src={`https://www.youtube.com/embed/${c.videoId}?mute=1&playsinline=1`} title={c.name} loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>:<div class="checking">WINDOW HEALTH<br/><small>{c.healthReason??c.status}</small></div>}<b>{c.status==='live'?'● LIVE':'○ CHECK'}</b></div><div class="meta"><div><small>{c.cameraId} / {c.area}</small><h2>{c.name}</h2><p>{c.nameEn}</p></div><div class="actions"><button class="fav" data-id={c.cameraId}>♡</button><a href={`/live/${c.cameraId}/`}>OPEN →</a></div></div></article>)}</section></main><script>
// @ts-nocheck
const key='imarium:favorites';const read=()=>{try{return JSON.parse(localStorage.getItem(key)||'[]')}catch{return[]}};document.querySelectorAll('.fav').forEach(btn=>{const id=btn.dataset.id;const paint=()=>btn.textContent=read().includes(id)?'♥':'♡';paint();btn.addEventListener('click',()=>{const f=read();localStorage.setItem(key,JSON.stringify(f.includes(id)?f.filter(x=>x!==id):[...f,id]));paint()})});
</script></Layout>
<style>.shell{min-height:100vh;padding:0 4vw 5rem;background:#f4f4f1;color:#171717}header{height:80px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #d7d7d2}header a{text-decoration:none;color:#666;font-size:.7rem;letter-spacing:.12em}.brand{font-weight:700;color:#111!important}.heading{padding:6vh 0 2.5rem}.heading p{font-size:.62rem;letter-spacing:.2em;color:#888}.heading h1{font-size:clamp(2.8rem,6vw,5.4rem);font-weight:450;letter-spacing:-.05em;margin:.4rem 0}.heading span{color:#888;font-size:.7rem;letter-spacing:.1em}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:1rem}.card{background:#fff;border:1px solid #ddd;padding:.6rem}.screen{position:relative;aspect-ratio:16/9;background:#161616;color:#777;display:grid;place-items:center}.screen iframe{width:100%;height:100%;border:0}.screen>b{position:absolute;top:.65rem;left:.65rem;background:#111c;color:#bbb;padding:.35rem .45rem;font-size:.5rem}.live .screen>b{color:#fff}.checking{text-align:center;font-size:.65rem;letter-spacing:.13em}.checking small{letter-spacing:.05em;color:#555}.meta{display:flex;justify-content:space-between;gap:1rem;padding:.9rem .2rem .2rem}.meta small{color:#999;font-size:.55rem}.meta h2{font-size:1rem;margin:.25rem 0}.meta p{font-size:.6rem;color:#888;margin:0}.actions{display:flex;align-items:end;gap:.4rem}.actions button,.actions a{border:1px solid #ccc;background:#fff;color:#222;padding:.6rem .7rem;text-decoration:none;font-size:.58rem}@media(max-width:700px){.shell{padding:0 1rem 3rem}header{height:68px}.heading{padding-top:3rem}.grid{grid-template-columns:1fr}.meta{display:block}.actions{margin-top:.8rem}}</style>