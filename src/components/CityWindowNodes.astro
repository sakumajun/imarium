---
interface WindowNode { cameraId: string; name: string; nameEn?: string; status: string; embedEnabled?: boolean; }
interface Props { windows?: WindowNode[]; cityName?: string; }
const { windows = [], cityName = '' } = Astro.props as Props;
const isLive = (w: WindowNode) => w.status === 'live' && w.embedEnabled !== false;
---
<section class="window-nodes" aria-label={`${cityName}のWINDOW一覧`} data-window-nodes>
  <div class="nodes-head"><p>WINDOW NODES</p><span>SELECT → OPEN → LIVE</span></div>
  {windows.map((w: WindowNode) => (
    <article class:list={['node', { live: isLive(w) }]} data-node data-id={w.cameraId}>
      <a class="node-main" href={`/live/${w.cameraId}/`}><span class="index">{w.cameraId}</span><span class="identity"><strong>{w.name}</strong><small>{w.nameEn}</small></span><b class="state">{isLive(w) ? '● LIVE' : '○ CHECK'}</b><span class="open">OPEN →</span></a>
      <button class="fav" type="button" data-favorite={w.cameraId} aria-label={`${w.name}をMY WINDOWSに追加または削除`} aria-pressed="false">♡</button>
    </article>
  ))}
</section>
<script>
import { readFavorites, toggleFavorite } from '../scripts/window-storage';
const paint=()=>document.querySelectorAll('[data-favorite]').forEach((button)=>{if(!(button instanceof HTMLButtonElement))return;const id=button.dataset.favorite||'';const selected=readFavorites().includes(id);button.textContent=selected?'♥':'♡';button.setAttribute('aria-pressed',String(selected));button.closest('[data-node]')?.classList.toggle('saved',selected)});
document.querySelectorAll('[data-favorite]').forEach((button)=>button.addEventListener('click',()=>{if(!(button instanceof HTMLButtonElement))return;const id=button.dataset.favorite||'';if(!id)return;toggleFavorite(id);paint()}));paint();
</script>
<style>
.window-nodes{display:grid;gap:.5rem;margin-top:1rem}.nodes-head{display:flex;justify-content:space-between;align-items:center;margin:.5rem 0}.nodes-head p,.nodes-head span{margin:0;font-size:.55rem;letter-spacing:.16em;color:var(--sub)}.node{display:grid;grid-template-columns:1fr auto;min-height:64px;border:1px solid var(--line);background:#050912cc;transition:.18s;position:relative}.node::before{content:"";position:absolute;left:-1px;top:-1px;width:24px;height:1px;background:#496a74}.node.live::before{background:var(--cyan);box-shadow:0 0 8px var(--cyan)}.node.live{border-color:#4ee3ff44}.node.saved{box-shadow:inset 3px 0 0 var(--cyan)}.node:hover,.node:focus-within{border-color:var(--cyan);background:#4ee3ff0b;box-shadow:0 0 15px #4ee3ff16}.node-main{min-width:0;padding:.75rem;display:grid;grid-template-columns:90px minmax(0,1fr) 80px 70px;gap:1rem;align-items:center;color:#60757c;text-decoration:none}.live .node-main{color:var(--cyan)}.index{font-size:.5rem;letter-spacing:.1em;color:var(--sub)}.identity{min-width:0}.identity strong,.identity small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.identity strong{font-size:.8rem;color:var(--text);font-weight:500}.identity small{margin-top:.2rem;color:var(--sub);font-size:.52rem;letter-spacing:.08em}.state{font-size:.5rem;letter-spacing:.08em}.open{font-size:.52rem;letter-spacing:.1em;text-align:right;color:var(--cyan);opacity:.65}.node:hover .open,.node:focus-within .open{opacity:1}.fav{width:54px;border:0;border-left:1px solid var(--line);background:#03060bcc;color:var(--cyan);font-size:1rem;cursor:pointer}.fav:hover,.fav:focus-visible{background:#4ee3ff12;outline:1px solid var(--cyan);outline-offset:-1px}.fav[aria-pressed="true"]{text-shadow:0 0 12px #4ee3ffaa;background:#4ee3ff0b}@media(max-width:700px){.nodes-head span{display:none}.node{min-height:68px}.node-main{grid-template-columns:minmax(0,1fr) auto;gap:.35rem .7rem;padding:.75rem}.index{grid-column:1;font-size:.46rem}.identity{grid-column:1;grid-row:2}.state{grid-column:2;grid-row:1;font-size:.46rem}.open{grid-column:2;grid-row:2;font-size:.5rem}.fav{width:50px;min-height:68px}}
</style>