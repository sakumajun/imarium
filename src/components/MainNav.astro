---
interface Props {
  active?: 'explore' | 'favorites' | 'multiview';
}
const { active } = Astro.props;
const links = [
  { key: 'explore', label: 'EXPLORE', href: '/' },
  { key: 'favorites', label: 'MY WINDOWS', href: '/favorites/' },
  { key: 'multiview', label: 'MULTI VIEW', href: '/multiview/' },
] as const;
---
<nav class="desktopNav" aria-label="メインナビゲーション">
  {links.map((link) => <a class:list={{ active: active === link.key }} href={link.href}>{link.label}</a>)}
</nav>
<details class="mobile-menu">
  <summary aria-label="メニューを開く"><span></span><span></span><span></span></summary>
  <div>
    {links.map((link) => <a class:list={{ active: active === link.key }} href={link.href}>{link.label}</a>)}
  </div>
</details>
<style>
.desktopNav{display:flex;justify-content:flex-end;gap:1.1rem}.desktopNav a{font-size:.55rem;letter-spacing:.1em;color:var(--sub);text-decoration:none}.desktopNav a:hover,.desktopNav a:focus-visible,.desktopNav .active{color:var(--cyan)}.mobile-menu{display:none}@media(max-width:700px){.desktopNav{display:none}.mobile-menu{display:block;justify-self:end;position:relative}.mobile-menu summary{list-style:none;width:44px;height:44px;border:1px solid var(--line);display:grid;place-content:center;gap:4px;cursor:pointer;background:#050912cc}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu summary span{display:block;width:16px;height:1px;background:var(--cyan);box-shadow:0 0 5px #4ee3ff55}.mobile-menu[open] summary{border-color:var(--cyan);box-shadow:0 0 12px #4ee3ff22}.mobile-menu div{position:absolute;z-index:40;right:0;top:50px;width:190px;border:1px solid var(--cyan);background:#050912f7;box-shadow:0 0 25px #4ee3ff22;padding:.35rem}.mobile-menu div a{display:block;padding:.85rem .75rem;color:var(--sub);text-decoration:none;font-size:.55rem;letter-spacing:.1em;border-bottom:1px solid var(--line)}.mobile-menu div a:last-child{border-bottom:0}.mobile-menu div a:hover,.mobile-menu div a:focus-visible,.mobile-menu div .active{color:var(--cyan);background:#4ee3ff0d}}
</style>