---
interface Props { cityName: string; cityEn: string; liveCount: number; registeredCount: number; }
const { cityName, cityEn, liveCount, registeredCount } = Astro.props as Props;
---
<header class="city-header">
  <a class="back" href="/explore/hokkaido/">← HOKKAIDO</a>
  <a class="brand" href="/">IMARIUM // LIVE GRID</a>
  <nav aria-label="メインナビゲーション"><a href="/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></nav>
  <details class="mobile-menu"><summary aria-label="メニューを開く"><span></span><span></span><span></span></summary><div><a href="/">EXPLORE</a><a href="/favorites/">MY WINDOWS</a><a href="/multiview/">MULTI VIEW</a></div></details>
</header>
<section class="heading"><div><p>01.02 // HOKKAIDO / {cityEn}</p><h1>{cityName}の「今」</h1><span>WINDOW HEALTHで確認しているライブカメラから選べます。</span></div><div class="count"><b>{liveCount}</b> LIVE <i></i><b>{registeredCount}</b> REGISTERED</div></section>
<style>
.city-header{height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid var(--line);position:relative}.back{color:var(--sub);text-decoration:none;font-size:.6rem;letter-spacing:.12em;width:max-content}.back:hover,.back:focus-visible,nav a:hover,nav a:focus-visible{color:var(--cyan)}.brand{color:var(--cyan)!important;font-size:.78rem;font-weight:700;letter-spacing:.2em;text-decoration:none;text-shadow:0 0 12px #4ee3ff88}nav{display:flex;justify-content:flex-end;gap:1.1rem}nav a{font-size:.55rem;letter-spacing:.1em;color:var(--sub);text-decoration:none;transition:.15s}.mobile-menu{display:none}.heading{padding:5vh 0 1.6rem;display:flex;justify-content:space-between;align-items:end;gap:2rem}.heading p{font-size:.58rem;letter-spacing:.2em;color:var(--sub)}.heading h1{font-size:clamp(2.1rem,5vw,4.5rem);font-weight:500;letter-spacing:.02em;margin:.35rem 0;text-shadow:0 0 20px #4ee3ff22}.heading span{color:var(--sub);font-size:.7rem}.count{font-size:.55rem;letter-spacing:.12em;color:var(--sub);white-space:nowrap}.count b{font-size:1.05rem;color:var(--cyan)}.count i{display:inline-block;width:1px;height:13px;background:var(--line);margin:0 .7rem}
@media(max-width:700px){.city-header{height:64px;grid-template-columns:1fr auto 1fr}.back{font-size:.48rem}.brand{font-size:.58rem;letter-spacing:.12em;white-space:nowrap}.city-header nav{display:none}.mobile-menu{display:block;justify-self:end;position:relative}.mobile-menu summary{list-style:none;width:44px;height:44px;border:1px solid var(--line);display:grid;place-content:center;gap:4px;cursor:pointer;background:#050912cc}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu summary span{display:block;width:16px;height:1px;background:var(--cyan);box-shadow:0 0 5px #4ee3ff55}.mobile-menu[open] summary{border-color:var(--cyan);box-shadow:0 0 12px #4ee3ff22}.mobile-menu div{position:absolute;z-index:20;right:0;top:50px;width:190px;border:1px solid var(--cyan);background:#050912f7;box-shadow:0 0 25px #4ee3ff22;padding:.35rem}.mobile-menu div a{display:block;padding:.85rem .75rem;color:var(--sub);text-decoration:none;font-size:.55rem;letter-spacing:.1em;border-bottom:1px solid var(--line)}.mobile-menu div a:last-child{border-bottom:0}.mobile-menu div a:active{color:var(--cyan);background:#4ee3ff0d}.heading{padding-top:2.5rem;display:block}.heading p{font-size:.5rem}.heading span{font-size:.64rem}.count{margin-top:1rem}}
</style>